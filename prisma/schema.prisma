  mes                String   // YYYY-MM
  analisis           String?
  propuesta1         String?
  propuesta2         String?
  propuesta3         String?
  comentariosFinales String?
  estado             String   @default("BORRADOR")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([mes])
  @@map("reportes_campanas_resultados")
}

// ─── ACTIVOS POR EVENTO ───────────────────────────────────────────────────────

model ActivoEvento {
  id               String                 @id @default(cuid())
  levantamientoId  String
  levantamiento    LevantamientoContenido @relation(fields: [levantamientoId], references: [id], onDelete: Cascade)
  tipo             String                 // FOTO | VIDEO | LOGO | COPY | OTRO
  nombre           String
  url              String
  descripcion      String?
  estado           String                 @default("ENTREGADO") // PENDIENTE | EN_EDICION | ENTREGADO | APROBADO
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("activos_evento")
}

// ─── NOTIFICACIONES ───────────────────────────────────────────────────────────

model Notificacion {
  id          String   @id @default(cuid())
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo        String   // LEVANTAMIENTO | PUBLICACION | CAMPANA | SISTEMA
  titulo      String
  mensaje     String
  leida       Boolean  @default(false)
  url         String?
  metadata    String?  // JSON extra data
  createdAt   DateTime @default(now())

  @@index([usuarioId, leida])
  @@map("notificaciones")
}

// ─── JUNTAS ───────────────────────────────────────────────────────────────────

model Junta {
  id            String   @id @default(cuid())
  titulo        String
  area          String   // GLOBAL | DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  tipo          String   // GLOBAL_SEMANAL | AREA_SEMANAL | REVISION_MENSUAL | EXTRAORDINARIA | CAPACITACION
  fecha         DateTime
  duracionMin   Int      @default(45)
  estado        String   @default("PROGRAMADA") // PROGRAMADA | EN_CURSO | COMPLETADA | CANCELADA
  facilitadorId String
  facilitador   User     @relation("JuntaFacilitador", fields: [facilitadorId], references: [id])

  notas         String?  @db.Text
  resumen       String?  @db.Text

  agendaItems      AgendaItem[]
  tareas           Tarea[]            @relation("JuntaOrigen")
  participantes    JuntaParticipante[]
  temasAdicionales TemaAdicional[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fecha])
  @@index([area, fecha])
  @@map("juntas")
}

model AgendaItem {
  id          String   @id @default(cuid())
  juntaId     String
  junta       Junta    @relation(fields: [juntaId], references: [id], onDelete: Cascade)
  orden       Int
  tipo        String   // RESULTADOS | COMPROMISOS | BLOQUEO | DECISION | ACUERDO | AVISO | RECONOCIMIENTO | KPI_REVIEW | CUSTOM
  titulo      String
  descripcion String?
  placeholder String?  @db.Text
  respuesta   String?  @db.Text
  completado  Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@map("agenda_items")
}

model JuntaParticipante {
  id      String  @id @default(cuid())
  juntaId String
  userId  String
  junta   Junta   @relation(fields: [juntaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  asistio Boolean @default(false)

  @@unique([juntaId, userId])
  @@map("junta_participantes")
}

model TemaAdicional {
  id           String  @id @default(cuid())
  juntaId      String
  junta        Junta   @relation(fields: [juntaId], references: [id], onDelete: Cascade)
  titulo       String
  descripcion  String? @db.Text
  propuestoPor String
  autor        User    @relation("TemaAutor", fields: [propuestoPor], references: [id])
  orden        Int     @default(0)

  // Estado durante la junta
  cubierto                Boolean  @default(false)
  notas                   String?  @db.Text
  pasadoSiguienteSemana   Boolean  @default(false)
  agregadoEnJunta         Boolean  @default(false) // true si se agregó durante la junta, no antes

  createdAt DateTime @default(now())

  @@index([juntaId])
  @@map("temas_adicionales")
}

// ─── PLAN DE TRABAJO ─────────────────────────────────────────────────────────
// Modelo v1 (PlanTrabajoActividad / tabla plan_trabajo_actividades) retirado.
// Estaba inerte: 0 tareas generadas jamás. El plan de trabajo vivo es el v2
// (PTArea → PTSubArea → PTTareaTemplate → PTTareaInstancia). La tabla v1 se
// conserva en prod como archivo (respaldo en scripts/_backup-plan-trabajo-v1-*.json).

// ─── PROYECTOS INTERNOS ───────────────────────────────────────────────────────

model ProyectoInterno {
  id              String   @id @default(cuid())
  nombre          String
  descripcion     String?  @db.Text
  area            String   // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  liderId         String
  lider           User     @relation("ProyectoInternoLider", fields: [liderId], references: [id])
  estado          String   @default("PLANIFICACION") // PLANIFICACION | ACTIVO | EN_PAUSA | COMPLETADO | CANCELADO
  prioridad       String   @default("MEDIA")         // URGENTE | ALTA | MEDIA | BAJA
  fechaInicio     DateTime?
  fechaFin        DateTime?
  porcentajeAvance Int     @default(0)
  presupuesto     Float?
  objetivo        String?  @db.Text
  entregable      String?  @db.Text
  esPrivado       Boolean  @default(false)   // si true, solo lo ven admin + usuarios en accesos
  backlogItemId   String?
  backlogItem     BacklogItem? @relation(fields: [backlogItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fases           FaseProyectoInterno[]
  tareas          Tarea[]  @relation("TareasDeProyectoInterno")
  accesos         ProyectoInternoAcceso[]

  @@index([area, estado])
  @@map("proyectos_internos")
}

model ProyectoInternoAcceso {
  id          String          @id @default(cuid())
  proyecto    ProyectoInterno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId  String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  creadoEn    DateTime        @default(now())

  @@unique([proyectoId, userId])
  @@map("proyecto_interno_acceso")
}

model FaseProyectoInterno {
  id          String          @id @default(cuid())
  proyectoId  String
  proyecto    ProyectoInterno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  orden       Int             @default(0)
  completada  Boolean         @default(false)
  createdAt   DateTime        @default(now())

  tareas      Tarea[]         @relation("TareasDeFase")

  @@index([proyectoId])
  @@map("fases_proyecto_interno")
}

// ─── BACKLOG ──────────────────────────────────────────────────────────────────

model BacklogItem {
  id          String    @id @default(cuid())
  titulo      String
  descripcion String?   @db.Text
  area        String?   // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  tipo        String    @default("IDEA") // IDEA | TAREA | PROYECTO
  estado      String    @default("PENDIENTE") // PENDIENTE | EN_JUNTA | CONVERTIDO | DESCARTADO
  creadoPorId String
  creadoPor   User      @relation("BacklogCreadoPor", fields: [creadoPorId], references: [id])
  procesadoEn String?   // "tarea" | "proyecto" | "junta" | "descartado"
  procesadoAt DateTime?
  tareaGeneradaId String?
  juntaId     String?
  createdAt   DateTime  @default(now())

  proyectosGenerados ProyectoInterno[]

  @@index([estado])
  @@index([area, estado])
  @@map("backlog_items")
}

model ProyectoAcceso {
  id          String        @id @default(cuid())
  proyecto    TareaProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId  String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  creadoEn    DateTime      @default(now())

  @@unique([proyectoId, userId])
  @@map("proyecto_acceso")
}

// ── Módulo Formularios ────────────────────────────────────────────────────────

model ReporteFormulario {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation("ReportesFormularioUser", fields: [userId], references: [id])
  semana      Int      // Número de semana ISO (1–53)
  anio        Int
  logros      String   @db.Text
  pendientes  String   @db.Text
  tareas      Json     // { titulo: string; fechaVencimiento: string | null }[]
  incidencias Json     // { que: string; causa: string; propuesta: string }[]
  mejoras     String   @db.Text
  compromisos String   @db.Text
  sugerencias String   @db.Text
  bienestar   Int      // 1–10
  estado      String   @default("enviado")
  tareasOperaciones  Json?  // [{tareaId, titulo, prioridad, accion: 'completada'|'reagendada'|'pendiente', fechaComprometida?, nota?}]
  compromisosPlan    Json?  // [{instanciaId, templateNombre, areaNombre, accion, fechaComprometida?, nota?}]

  @@map("reportes_formulario")
}


// ── Módulo Reporte Post-Evento ───────────────────────────────────────────────────

model ReportePostEvento {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  proyectoId            String    @unique
  proyecto              Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  token                 String    @unique @default(cuid())
  estado                String    @default("pendiente") // "pendiente" | "completado"
  coordinadorNombre     String?
  // Bloque ejecución
  llegadaPlaneada       String?
  llegadaReal           String?
  montajePlaneado       String?
  montajeReal           String?
  inicioProgramado      String?
  inicioReal            String?
  salidaPlaneada        String?
  salidaReal            String?
  seEjecutoSegunPlan    String?   // "si" | "ajustes" | "no"
  // Bloque equipos
  fallasEquipo          Json?     // string[]
  equipoMantenimiento   Json?     // string[]
  herramientasFaltantes Json?     // string[]
  // Bloque información
  briefCompleto         String?   // "si" | "incompleto" | "no"
  cambiosUltimoMomento  Boolean?
  descripcionCambios    String?   @db.Text
  // Bloque equipo técnico
  calificacionEquipo    Int?
  puntosPositivos       String?   @db.Text
  areasMejora           String?   @db.Text
  // Bloque incidencias
  incidencias           Json?     // { descripcion, impacto, resolucion }[]
  // Bloque cierre
  equipoRegreso         String?   // "completo" | "faltantes"
  faltantesDescripcion  String?   @db.Text
  aprendizajeClave      String?   @db.Text
  loRepetiriamos        String?   // "si" | "ajustes" | "no"
  respondidoEn          DateTime?

  @@map("reporte_post_evento")
}

// ── Módulo Proveedores / Subrentas por evento ─────────────────────────────────

model ProveedorEvento {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  proyectoId        String
  proyecto          Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombreProveedor   String
  servicioEquipo    String?
  telefonoProveedor String?

  @@map("proveedores_evento")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MÓDULO PLAN DE TRABAJO — Sistema Operativo Vivo
// ═══════════════════════════════════════════════════════════════════════════════

model PTArea {
  id        String   @id @default(cuid())
  nombre    String   @unique
  codigo      String?  @unique // Código estable: DIRECCION|ADMINISTRACION|MARKETING|VENTAS|PRODUCCION|GENERAL (el nombre es la etiqueta editable)
  transversal Boolean  @default(false) // Área que aplica a todo el equipo (ej. Operaciones Generales), no cuenta como área operativa canónica
  color     String
  icono     String?
  objetivo  String?  @db.Text
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  subareas  PTSubArea[]
  templates PTTareaTemplate[]
  kpis      PTKPI[]     @relation("PTKPIArea")

  @@map("pt_areas")
}

model PTSubArea {
  id          String   @id @default(cuid())
  areaId      String
  area        PTArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  nombre      String
  orden       Int      @default(0)
  descripcion String?  @db.Text
  entregables String[] // Lista de nombres de entregables

  templates   PTTareaTemplate[]
  secciones   TareaSeccion[]    @relation("SeccionSubArea")
  puestos     Puesto[]          @relation("PuestoSubArea")

  @@index([areaId])
  @@map("pt_subareas")
}

model PTTareaTemplate {
  id             String   @id @default(cuid())
  areaId         String
  area           PTArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  subAreaId      String
  subArea        PTSubArea @relation(fields: [subAreaId], references: [id], onDelete: Cascade)
  responsableId  String?
  responsable    User?    @relation("PTTemplateResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  nombre         String
  descripcion    String?  @db.Text
  tipo           String   // CHECK | ENTREGABLE
  frecuencia     String   // DIARIO | SEMANAL | QUINCENAL | MENSUAL | TRIMESTRAL | POR_EVENTO
  diasSemana     Int[]    // [1,2,3,4,5] — 0=dom,1=lun,...6=sab
  diaDelMes      Int?     // Para MENSUAL: día fijo (1-31)
  semanaDeMes    Int[]    @default([])  // Para MENSUAL/QUINCENAL: 1=1a, 2=2a, 3=3a, 4=4a, 5=última (array, multi-select)
  horaLimite     String?  // "10:30" — hora límite de entrega
  moduloDestino    String?  // URL del módulo: "/ventas/pipeline"
  moduloTexto      String?  // "Ir al Pipeline"
  moduloDisponible Boolean  @default(true)
  esAccionCampo    Boolean  @default(false)
  activa           Boolean  @default(true)
  orden          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Campos SO v2.0
  impacto        String   @default("estandar")        // critico | alto | estandar
  contexto       String   @default("independiente")   // evento | hibrida | independiente
  cuando         String?                              // texto: "Cada lunes antes de las 10:30 am"
  puestoDefault  String?                              // puesto responsable por defecto
  kpiNombre      String?                              // KPI asociado en texto
  estandarMinimo String?  @db.Text
  porqueSeHace   String?  @db.Text
  relacionCon    String?  @db.Text
  siNoSeHace     String?  @db.Text
  afectaA        String[]
  dependeDe      Json?                                // { tarea: string, puesto: string } | null
  bloqueaA       Json?                                // { tarea: string, puesto: string } | null
  tipoAsignacion String   @default("individual")      // individual | area | todos
  areaAsignada   String?                              // nombre del área si tipoAsignacion = "area"


  instancias  PTTareaInstancia[]
  subtareas   PTSubTarea[]

  // ── Capa aditiva: generación de tareas ────────────────────────────────────
  tareasGeneradas        Tarea[]  @relation("TareasDeTemplate")
  ultimaTareaGeneradaAt  DateTime?

  @@index([areaId, activa])
  @@index([responsableId])
  @@map("pt_tarea_templates")
}

model PTTareaInstancia {
  id             String   @id @default(cuid())
  templateId     String
  template       PTTareaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responsableId  String?
  responsable    User?    @relation("PTInstanciaResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  fechaVencimiento DateTime
  estado         String   @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | VENCIDA | OMITIDA | NO_REALIZADO
  esEntregable   Boolean  @default(false)
  periodoLabel   String?  // "Semana 22", "Mayo 2026", "Lunes 26 mayo"
  notas          String?  @db.Text
  razonNoRealizado String? // no_alcanzo_tiempo | ya_estaba_cubierto | tarea_no_clara | no_habia_necesidad
  completadaAt   DateTime?
  completadaPorId String?
  completadaPor  User?    @relation("PTInstanciaCompletadaPor", fields: [completadaPorId], references: [id], onDelete: SetNull)
  // Capa aditiva: marca de migración una-sola-vez a Tarea (Bloque 2)
  migradaATareaId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subtareasInstancia PTSubTareaInstancia[]
  comentarios        PTComentario[]
  historial          PTHistorialEjecucion[]

  @@index([responsableId, fechaVencimiento])
  @@index([templateId, fechaVencimiento])
  @@index([estado])
  @@index([migradaATareaId])
  @@map("pt_tarea_instancias")
}

model PTSubTarea {
  id         String   @id @default(cuid())
  templateId String
  template   PTTareaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  nombre     String
  orden      Int      @default(0)
  activa     Boolean  @default(true)

  instancias PTSubTareaInstancia[]

  @@index([templateId])
  @@map("pt_subtareas")
}

model PTSubTareaInstancia {
  id          String   @id @default(cuid())
  subtareaId  String
  subtarea    PTSubTarea @relation(fields: [subtareaId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   PTTareaInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  completada  Boolean  @default(false)
  completadaAt DateTime?

  @@unique([subtareaId, instanciaId])
  @@index([instanciaId])
  @@map("pt_subtarea_instancias")
}

model PTComentario {
  id          String   @id @default(cuid())
  instanciaId String
  instancia   PTTareaInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User     @relation("PTComentarioAutor", fields: [autorId], references: [id], onDelete: Cascade)
  contenido   String   @db.Text
  editadoAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([instanciaId])
  @@map("pt_comentarios")
}

model PTHistorialEjecucion {
  id          String   @id @default(cuid())
  instanciaId String
  instancia   PTTareaInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     User     @relation("PTHistorialUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  accion      String   // COMPLETADA | REABIERTA | REASIGNADA | COMENTADA | OMITIDA | CREADA
  detalles    String?
  createdAt   DateTime @default(now())

  @@index([instanciaId])
  @@index([usuarioId, createdAt])
  @@map("pt_historial_ejecucion")
}

// ── KPIs del Sistema Operativo ────────────────────────────────────────────────
model PTKPI {
  id            String   @id @default(cuid())
  slug          String?  @unique
  areaId        String?
  area          PTArea?  @relation("PTKPIArea", fields: [areaId], references: [id], onDelete: SetNull)
  nombre        String
  meta          String
  formula       String   @db.Text
  fuente        String
  orden         Int      @default(0)
  esTransversal    Boolean   @default(false)
  activo           Boolean   @default(true)
  descripcion      String?
  proposito        String?   @db.Text
  tipoCalculo      String    @default("manual")   // "automatico" | "manual" | "mixto"
  notaCalculo      String?   @db.Text
  valorManual      Float?
  fechaValorManual DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  registros     PTRegistroKPI[]

  @@index([areaId])
  @@index([esTransversal])
  @@map("pt_kpis")
}

model PTRegistroKPI {
  id            String   @id @default(cuid())
  kpiId         String?
  kpi           PTKPI?   @relation(fields: [kpiId], references: [id])
  kpiSlug       String
  kpiNombre     String
  kpiArea       String
  valor         Float?
  valorTexto    String?
  meta          String
  cumplida      Boolean  @default(false)
  calculo       String   @default("manual")   // manual | automatico
  fuente        String?
  periodo       String                         // semanal|quincenal|mensual|trimestral|semestral|anual
  fechaInicio   DateTime
  fechaFin      DateTime
  semana        Int?
  quincena      Int?
  mes           Int?
  trimestre     Int?
  semestre      Int?
  anio          Int
  nota          String?  @db.Text
  registradoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([kpiSlug, periodo, fechaInicio])
  @@index([kpiSlug, periodo, anio])
  @@index([kpiArea, periodo, anio])
  @@map("pt_registro_kpis")
}

// ─── CAPTURA RÁPIDA / IDEAS / INICIATIVAS ────────────────────────────────────

model CapturaRapida {
  id          String   @id @default(cuid())
  contenido   String
  area        String?  // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  tipo        String?  // idea | iniciativa | tarea | backlog
  clasificado Boolean  @default(false)
  creadoEn    DateTime @default(now())
  creadoPor   String?
  usuario     User?    @relation("CapturaRapidaUsuario", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@index([clasificado, creadoEn])
  @@map("captura_rapida")
}

model Idea {
  id          String   @id @default(cuid())
  titulo      String
  nota        String?  @db.Text
  area        String?
  tipo        String?  // negocio | operacion | plataforma | estrategia
  estado      String   @default("activa")   // activa | convertida | descartada
  convertidaA String?
  creadoEn    DateTime @default(now())
  creadoPor   String?
  usuario     User?    @relation("IdeaUsuario", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@index([estado, creadoEn])
  @@map("ideas")
}

model Iniciativa {
  id          String               @id @default(cuid())
  titulo      String
  descripcion String?              @db.Text
  area        String?
  responsable String?
  estado      String   @default("planeando") // planeando | en_ejecucion | pausada | completada
  fechaLimite DateTime?
  notas       String?              @db.Text
  subtareas   SubtareaIniciativa[]
  creadoEn    DateTime @default(now())
  creadoPor   String?
  usuario     User?    @relation("IniciativaUsuario", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@index([estado, creadoEn])
  @@map("iniciativas")
}

model SubtareaIniciativa {
  id           String     @id @default(cuid())
  iniciativaId String
  iniciativa   Iniciativa @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  titulo       String
  completada   Boolean    @default(false)
  orden        Int        @default(0)

  @@index([iniciativaId, orden])
  @@map("subtareas_iniciativa")
}

// ─── REPORTE SEMANAL POR ÁREA ────────────────────────────────────────────────

// Reporte semanal por área (lo llena cada responsable de área cada lunes)
model ReporteAreaSemanal {
  id          String   @id @default(cuid())
  area        String   // VENTAS | PRODUCCION | MARKETING | ADMINISTRACION | RRHH | DIRECCION
  semana      String   // Lunes de la semana: "2026-05-04"
  autorId     String
  autor       User     @relation("ReportesAreaAutor", fields: [autorId], references: [id])
  resultados  String   @default("") // Texto libre: logros de la semana
  kpis        String   @default("[]") // JSON: [{ nombre, valor, meta?, unidad? }]
  compromisos String   @default("") // Texto libre: qué se compromete para la siguiente semana
  bloqueo     String?  // Texto libre: qué está bloqueando (opcional)
  revisado    Boolean  @default(false) // Dirección revisó el reporte
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([area, semana])
  @@map("reportes_area_semanal")
}

// ─── EVALUACIÓN DE DIRECCIÓN POR ÁREA ────────────────────────────────────────

// Evaluación mensual que DIRECCIÓN hace sobre la operación de cada área, apoyada
// en su reporte de resultados. Es el juicio (1-5 por dimensión); el reporte del
// área es la materia prima. Standalone a propósito: evaluadorId/responsableId son
// ids de User sin relación inversa (evita tocar el modelo User).
model EvaluacionAreaDireccion {
  id                String    @id @default(cuid())
  area              String    // VENTAS | PRODUCCION | MARKETING | ADMINISTRACION | RRHH
  mes               String    // "2026-07"
  evaluadorId       String?
  evaluadorNombre   String?
  responsableId     String?   // responsable de área evaluado (opcional)
  responsableNombre String?
  calificaciones    String    @default("{}") // JSON: { dimension: 1..5 }
  notas             String    @default("{}") // JSON: { dimension: nota }
  comentario        String    @default("")   // conclusión global de dirección
  finalizada        Boolean   @default(false)
  finalizadaEn      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([area, mes])
  @@map("evaluaciones_area_direccion")
}

// ─── REPORTE MENSUAL DE ÁREA (estándar) ──────────────────────────────────────

// Cierre mensual que el responsable de cada área entrega con una MISMA estructura
// para todas las áreas (materia prima de la evaluación de dirección). Standalone
// a propósito: autorId es un id de User sin relación inversa (evita tocar User).
model ReporteMensualArea {
  id          String    @id @default(cuid())
  area        String    // VENTAS | PRODUCCION | MARKETING | ADMINISTRACION | RRHH
  mes         String    // "2026-07"
  autorId     String?
  autorNombre String?
  resultados  String    @default("")  // Qué se logró este mes
  kpis        String    @default("[]") // JSON: [{ nombre, valor, meta, unidad }]
  analisis    String    @default("")  // Qué pasó y por qué
  bloqueos    String    @default("")  // Riesgos y bloqueos
  compromisos String    @default("")  // Compromisos del próximo mes
  enviado     Boolean   @default(false)
  enviadoEn   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([area, mes])
  @@map("reportes_mensuales_area")
}

// ─── VISIÓN SEMANAL ──────────────────────────────────────────────────────────

// Documento de preparación para la junta de inicio de semana. Uno por área.
// El responsable de cada área lo llena para presentar dónde está, qué viene y
// qué necesita de apoyo. Las tareas y proyectos NO se guardan aquí: se calculan
// en vivo por área al abrir el documento.
model VisionSemanal {
  id          String   @id @default(cuid())
  area        String   // ADMINISTRACION | MARKETING | VENTAS | PRODUCCION | PREPRODUCCION
  semana      String   // Lunes de la semana ISO: "2026-07-13"
  enfoque     String   @default("") @db.Text  // Caja de texto: enfoque de la semana
  entregaInfo Json     @default("[]")         // [{ id, titulo, contenido }] — editable/ampliable
  desbloqueo  String   @default("") @db.Text  // Qué necesita para desbloquear tareas
  comentarios String   @default("") @db.Text  // Comentarios finales (opcional)
  extra       Json     @default("{}")         // Campos específicos de pre-producción
  autorId     String?
  autor       User?    @relation("VisionSemanalAutor", fields: [autorId], references: [id])
  responsableId String?
  responsable   User?  @relation("VisionSemanalResponsable", fields: [responsableId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([area, semana])
  @@map("vision_semanal")
}

// ─── OBJETIVOS / OKRs ────────────────────────────────────────────────────────

model ObjetivoTrimestral {
  id          String      @id @default(cuid())
  area        String      // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  trimestre   String      // Q1 | Q2 | Q3 | Q4
  anio        Int
  objetivo    String
  keyResults  KeyResult[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("objetivos_trimestrales")
}

model KeyResult {
  id           String             @id @default(cuid())
  descripcion  String
  tipo         String             // porcentaje | numero | booleano
  meta         Float?
  metaTexto    String?
  progreso     Float              @default(0)
  completado   Boolean            @default(false)
  conexionAuto String?            // leads_q3 | outbound_q3
  objetivoId   String
  objetivo     ObjetivoTrimestral @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("key_results")
}

// ─── CAPACITACIÓN CON IA ─────────────────────────────────────────────────────

model SesionCapacitacion {
  id              String   @id @default(cuid())
  numero          Int
  titulo          String
  bloque          String
  bloqueLetra     String
  descripcion     String
  objetivos       String[]
  puntosBase      String[]
  puntosEditados  String[]
  semana          Int      @default(1)
  fechaProgramada DateTime?
  duracion        Int      @default(60)
  impartidor      String   @default("Mauricio Hernández")
  estado          String   @default("pendiente")
  notas           String?
  categoriaId     String?
  categoria       CategoriaCapacitacion? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versiones       VersionPresentacion[]
  progreso        ProgresoCapacitacion[]
  evaluacion      EvaluacionCapacitacion?

  @@map("sesiones_capacitacion")
}

// ── PORTAL DE APRENDIZAJE (consumo por el equipo) ────────────────────────────

// Grandes áreas del portal: General, Administración, Marketing, Ventas,
// Producción y las de equipo (Audio EV, RCF, Pioneer, Entarimado, LED…).
model CategoriaCapacitacion {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  color     String   @default("#c9a96a")
  icono     String   @default("GraduationCap")
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sesiones  SesionCapacitacion[]

  @@map("categorias_capacitacion")
}

// Progreso por usuario+sesión. Cronometra tiempo activo (con pausa por inactividad).
model ProgresoCapacitacion {
  id           String    @id @default(cuid())
  usuarioId    String
  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sesionId     String
  sesion       SesionCapacitacion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  estado       String    @default("en-progreso") // en-progreso | completado
  segundos     Int       @default(0)
  iniciadoEn   DateTime  @default(now())
  completadoEn DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([usuarioId, sesionId])
  @@map("progreso_capacitacion")
}

// Examen de opción múltiple autogenerado del contenido de la capacitación.
model EvaluacionCapacitacion {
  id         String    @id @default(cuid())
  sesionId   String    @unique
  sesion     SesionCapacitacion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  preguntas  Json      // [{ pregunta, opciones: string[], correcta: number }]
  minAprobar Int       @default(80)
  generadaEn DateTime  @default(now())
  intentos   IntentoEvaluacion[]

  @@map("evaluaciones_capacitacion")
}

model IntentoEvaluacion {
  id           String   @id @default(cuid())
  evaluacionId String
  evaluacion   EvaluacionCapacitacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  respuestas   Json     // number[]  (índice elegido por pregunta)
  calificacion Int
  aprobado     Boolean
  creadoEn     DateTime @default(now())

  @@map("intentos_evaluacion")
}

model VersionPresentacion {
  id              String             @id @default(cuid())
  sesionId        String
  sesion          SesionCapacitacion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  version         Int
  htmlContent     String             @db.Text
  notasSnapshot   String?
  puntosSnapshot  String[]
  generadaPor     String             @default("Mauricio Hernández")
  generadaEn      DateTime           @default(now())

  @@unique([sesionId, version])
  @@map("versiones_presentacion")
}

// ─── PRESENTACIONES DE VENTA ──────────────────────────────────────────────────

model PresentacionVenta {
  id           String     @id @default(cuid())
  titulo       String
  descripcion  String     @db.Text
  htmlContent  String     @default("") @db.Text
  estado       String     @default("BORRADOR")
  tokenPublico String?    @unique
  tratoId      String?    // prospecto ligado (etapa Descubrimiento) — sin FK a propósito
  creadaPorId  String
  creadaPor    User       @relation("PresentacionesVentaCreadas", fields: [creadaPorId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  imagenes     ImagenPV[]

  @@map("presentaciones_venta")
}

model ImagenPV {
  id             String            @id @default(cuid())
  presentacionId String
  presentacion   PresentacionVenta @relation(fields: [presentacionId], references: [id], onDelete: Cascade)
  blobUrl        String
  nombre         String
  orden          Int               @default(0)
  createdAt      DateTime          @default(now())

  @@map("imagenes_pv")
}

// ─── CATÁLOGO DE TIPOS DE EVENTO ──────────────────────────────────────────────
// Fuente única para categorizar tratos/cotizaciones y alimentar galerías,
// presentaciones por tipo y presentaciones derivadas de cotización.

model TipoEvento {
  id          String           @id @default(cuid())
  slug        String           @unique // "musical" | "social" | "empresarial" | "otro"
  nombre      String                   // "Eventos Musicales"
  emoji       String?
  subtitulo   String?                  // tagline: "Conciertos · Festivales · DJ Sets"
  descripcion String?          @db.Text // base/copy larga del tipo de evento
  orden       Int              @default(0)
  activo      Boolean          @default(true)
  fotos       FotoTipoEvento[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("tipos_evento")
}

model FotoTipoEvento {
  id           String     @id @default(cuid())
  tipoEventoId String
  tipoEvento   TipoEvento @relation(fields: [tipoEventoId], references: [id], onDelete: Cascade)
  url          String                   // blob URL o ruta en /public
  caption      String?
  orden        Int        @default(0)
  destacada    Boolean    @default(false) // "los mejores" — preseleccionadas
  createdAt    DateTime   @default(now())

  @@index([tipoEventoId])
  @@map("fotos_tipo_evento")
}

// ─── CATÁLOGO DE TIPOS DE SERVICIO ────────────────────────────────────────────
// Renta de equipo, producción técnica, dirección técnica y operación técnica.
// Espeja a TipoEvento: alimenta las galerías/presentaciones de servicios con
// fotos y descripciones (algunas generadas con IA) preseleccionadas.

model TipoServicio {
  id          String             @id @default(cuid())
  slug        String             @unique // "renta" | "produccion-tecnica" | "direccion-tecnica" | "operacion-tecnica"
  nombre      String                     // "Renta de equipo"
  emoji       String?
  subtitulo   String?                    // tagline
  descripcion String?            @db.Text // base/copy larga del servicio
  orden       Int                @default(0)
  activo      Boolean            @default(true)
  fotos       FotoTipoServicio[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("tipos_servicio")
}

model FotoTipoServicio {
  id             String       @id @default(cuid())
  tipoServicioId String
  tipoServicio   TipoServicio @relation(fields: [tipoServicioId], references: [id], onDelete: Cascade)
  url            String                   // blob URL o ruta en /public
  caption        String?
  orden          Int          @default(0)
  destacada      Boolean      @default(false) // "los mejores" — preseleccionadas para el hero
  createdAt      DateTime     @default(now())

  @@index([tipoServicioId])
  @@map("fotos_tipo_servicio")
}

// ─── CATÁLOGO DE EVENTOS: NICHOS · ADICIONALES · PREGUNTAS ─────────────────────
// Fuente única de la que derivan el wizard de descubrimiento (interno y público),
// los paquetes y las sugerencias de cotización. Todo editable por admin sin tocar
// código. El linkage con lo existente es por SLUG legacy en mayúscula
// (MUSICAL | SOCIAL | EMPRESARIAL | OTRO) para no migrar los tratos/cotizaciones.
// Tablas creadas lazy (ensureCatalogoTables en src/lib/catalogo-eventos.ts).

model Nicho {
  id               String   @id @default(cuid())
  tipoEventoSlug   String   // legacy: MUSICAL | SOCIAL | EMPRESARIAL | OTRO
  nombre           String   // "Boda", "Festival", "Congreso / Convención"
  slug             String   // slug estable dentro del tipo
  descripcion      String?
  notasComerciales String?  @db.Text // lo que el vendedor debe saber del nicho
  orden            Int      @default(0)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tipoEventoSlug, slug])
  @@index([tipoEventoSlug])
  @@map("nichos")
}

model Adicional {
  id          String    @id @default(cuid())
  nombre      String
  descripcion String?
  tiposEvento String    // JSON array de slugs legacy: ["SOCIAL","MUSICAL"]
  nichos      String?   // JSON array de slugs de nicho; vacío = todo el tipo
  frecuencia  String    @default("frecuente") // frecuente | ocasional
  productoId  String?   // vínculo opcional al inventario
  producto    Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  imagenUrl   String?
  orden       Int       @default(0)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productoId])
  @@map("adicionales")
}

model PreguntaDescubrimiento {
  id            String           @id @default(cuid())
  texto         String
  tipoRespuesta String           @default("SI_NO") // SI_NO | NUMERO | OPCION_UNICA | OPCION_MULTIPLE | TEXTO
  opciones      String?          // JSON array de opciones (si aplica)
  nichos        String?          // JSON array de slugs de nicho donde aplica
  orden         Int              @default(0)
  activa        Boolean          @default(true)
  reglas        ReglaPregunta[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("preguntas_descubrimiento")
}

// Una regla enciende categorías de equipo y/o adicionales cuando la respuesta a
// la pregunta cumple la condición. `condicion` = JSON { op, valor }.
model ReglaPregunta {
  id              String                 @id @default(cuid())
  preguntaId      String
  pregunta        PreguntaDescubrimiento @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  condicion       String                 // JSON { op: "eq"|"gte"|"truthy"|..., valor?: any }
  categoriasEquipo String?               // JSON array de categorías de equipo a encender
  adicionalIds    String?                // JSON array de ids de Adicional a encender

  @@index([preguntaId])
  @@map("reglas_pregunta")
}

// Perfiles de prospecto personalizados (los 13 base viven en src/lib/proceso/perfiles.ts).
// Se agregan cuando un contacto no encaja en ningún perfil base; categoria = tipoEvento.
model PerfilProspecto {
  id             String   @id @default(cuid())
  label          String
  categoria      String                      // MUSICAL | SOCIAL | EMPRESARIAL
  mensajeInicial String?  @db.Text           // plantilla opcional; {nombre} {empresa}. Vacío = genérico por categoría
  materiales     String?                     // JSON array opcional de MaterialId
  orden          Int      @default(0)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("perfiles_prospecto")
}

// Slides del hero de la galería pública (/presentacion/galeria). Independientes
// de los tipos de evento: rotan como carrusel al inicio.
model FotoGaleriaInicio {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("fotos_galeria_inicio")
}

// ── Prospección ──────────────────────────────────────────────────────────────

model Prospeccion {
  id         String  @id @default(cuid())
  tipo       String  // NUEVO_PROSPECTO | CLIENTE_PROPIO
  etapa      String  @default("SIN_ETAPA")
  // SIN_ETAPA | NUEVO_CONTACTO | EN_SEGUIMIENTO | INTERES_CONFIRMADO | EN_EVALUACION | LISTO_PARA_CERRAR
  tipoEvento String  @default("VARIOS") // MUSICAL | SOCIAL | EMPRESARIAL | VARIOS
  origen     String  @default("MANUAL") // META_ADS | MANUAL | REFERIDO | RECOMPRA | ORGANICO | NETWORKING | REDES_SOCIALES | OTRO
  estado     String  @default("SIN_ETAPA")
  // SIN_ETAPA | ACTIVO | EN_TRATO | CONVERTIDO | CANCELADO
  notas      String?

  // ── Ruta de 5 contactos ──────────────────────────────────────────────────
  contacto1Fecha  DateTime?
  contacto1Nota   String?
  contacto1Hecho  Boolean   @default(false)

  contacto2Fecha  DateTime?
  contacto2Nota   String?
  contacto2Hecho  Boolean   @default(false)

  contacto3Fecha  DateTime?
  contacto3Nota   String?
  contacto3Hecho  Boolean   @default(false)

  contacto4Fecha  DateTime?
  contacto4Nota   String?
  contacto4Hecho  Boolean   @default(false)

  contacto5Fecha  DateTime?
  contacto5Nota   String?
  contacto5Hecho  Boolean   @default(false)

  fechaProximoContacto DateTime?

  // ── Información del evento (pre-trato) ───────────────────────────────────
  tipoServicioInteres String?   // RENTA | PRODUCCION_TECNICA | DIRECCION_TECNICA
  fechaEventoEstimada DateTime?
  lugarEstimado       String?
  presupuestoAprox    Float?
  notasEvento         String?

  // ── Relaciones ───────────────────────────────────────────────────────────
  clienteId     String
  cliente       Cliente   @relation(fields: [clienteId], references: [id])
  responsableId String?
  responsable   User?     @relation("ProspeccionResponsable", fields: [responsableId], references: [id])
  trato         Trato?    @relation("TratoProspeccion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prospecciones")
}

// ══════════════════════════════════════════════════════════════════════════════
// MÓDULO: PASIVOS / DEUDAS ESTRUCTURALES
// ══════════════════════════════════════════════════════════════════════════════

model PasivoDeuda {
  id               String    @id @default(cuid())
  nombre           String    // "Crédito Bancomer", "Adeudo Proveedor Audio"
  proveedorId      String?
  proveedor        Proveedor? @relation(fields: [proveedorId], references: [id])
  acreedorNombre   String?   // Nombre libre si no es proveedor del catálogo
  descripcion      String?
  montoTotal       Float
  montoPagado      Float     @default(0)
  categoria        String    @default("PROVEEDOR") // PROVEEDOR | BANCARIO | FISCAL | SOCIO | OTRO
  estado           String    @default("ACTIVO")     // ACTIVO | LIQUIDADO | REFINANCIADO
  fechaAdquisicion DateTime
  tasaInteres      Float?    // % anual si aplica
  notas            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cuotas CuotaDeuda[]

  @@map("pasivos_deuda")
}

model CuotaDeuda {
  id               String      @id @default(cuid())
  pasivoDeudaId    String
  pasivoDeuda      PasivoDeuda @relation(fields: [pasivoDeudaId], references: [id], onDelete: Cascade)
  numeroCuota      Int         // 1, 2, 3...
  monto            Float
  fechaVencimiento DateTime
  estado           String      @default("PENDIENTE") // PENDIENTE | PAGADO | VENCIDO
  cuentaPagarId    String?     @unique
  cuentaPagar      CuentaPagar? @relation("CuotaDeudaCxP", fields: [cuentaPagarId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("cuotas_deuda")
}

// ══════════════════════════════════════════════════════════════════════════════
// MÓDULO: REPARTO DE UTILIDADES
// ══════════════════════════════════════════════════════════════════════════════

model RepartoUtilidad {
  id              String   @id @default(cuid())
  nombre          String   // "Reparto semanal Susana", "Dividendo Mauricio"
  socioId         String?
  socio           Socio?   @relation(fields: [socioId], references: [id])
  beneficiario    String   // nombre del beneficiario (redundante para historial)
  descripcion     String?
  montoBase       Float    // Monto fijo por período
  tipoPeriodo     String   @default("SEMANAL") // SEMANAL | QUINCENAL | MENSUAL | UNICO
  baseCalculo     String   @default("FIJO")    // FIJO | PCT_UTILIDAD | PCT_APORTACION
  pctCalculo      Float?   // % si baseCalculo != FIJO
  activo          Boolean  @default(true)
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cuotas CuotaReparto[]

  @@map("repartos_utilidad")
}

model CuotaReparto {
  id              String          @id @default(cuid())
  repartoId       String
  reparto         RepartoUtilidad @relation(fields: [repartoId], references: [id], onDelete: Cascade)
  periodo         String          // "2026-07" o "2026-W28"
  monto           Float
  estado          String          @default("PENDIENTE") // PENDIENTE | PAGADO
  cuentaPagarId   String?         @unique
  cuentaPagar     CuentaPagar?    @relation("CuotaRepatoCxP", fields: [cuentaPagarId], references: [id], onDelete: SetNull)
  fechaGenerada   DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@map("cuotas_reparto")
}

// ══════════════════════════════════════════════════════════════════════════════
// MÓDULO: ESTADO DE RESULTADOS — ANÁLISIS DIRECTIVO
// ══════════════════════════════════════════════════════════════════════════════

model ReporteERAnalisis {
  id                          String   @id @default(cuid())
  mes                         String   @unique // "2026-07"

  // ── Análisis narrativo ────────────────────────────────────────────────────
  analisisFinanciero          String?  @db.Text
  analisisOperativo           String?  @db.Text
  analisisMercado             String?  @db.Text

  // ── Preguntas estratégicas de dirección ──────────────────────────────────
  queLogramos                 String?  @db.Text  // ¿Qué logramos este mes?
  queNoLogramos               String?  @db.Text  // ¿Qué no logramos y por qué?
  queCambiariamos             String?  @db.Text  // ¿Qué cambiaríamos si pudiéramos?
  decisionesUrgentes          String?  @db.Text  // ¿Qué decisiones urgentes hay que tomar?
  proyeccionSiguiente         String?  @db.Text  // Proyección y enfoque del siguiente mes

  // ── 5 propuestas de mejora ────────────────────────────────────────────────
  propuesta1                  String?  @db.Text
  propuesta2                  String?  @db.Text
  propuesta3                  String?  @db.Text
  propuesta4                  String?  @db.Text
  propuesta5                  String?  @db.Text

  // ── Comentarios finales ───────────────────────────────────────────────────
  comentariosFinales          String?  @db.Text

  // ── Cuenta fiscal (ISR planning) ─────────────────────────────────────────
  saldoCuentaFiscalAnterior   Float?   // Saldo CUFIN/CUCA mes anterior
  saldoCuentaFiscalActual     Float?   // Saldo estimado mes actual
  isrRetenidoMes              Float?   // ISR pagado/retenido en el mes

  // ── Metadata ─────────────────────────────────────────────────────────────
  actualizadoPorId            String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("reporte_er_analisis")
}

// ── Solicitudes de Cotización (inbox de briefs, independiente del CRM) ─────────
model SolicitudCotizacion {
  id             String   @id @default(cuid())
  folio          Int      @default(autoincrement())
  clienteNombre  String
  contactoTelefono String?

  clienteId      String?
  cliente        Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  fechaEvento    DateTime?
  lugarEvento    String?
  etapa          String?  // PROSPECCION | DESCUBRIMIENTO | OPORTUNIDAD | VENTA_CERRADA | VENTA_PERDIDA
  tipoEvento     String?  // MUSICAL | SOCIAL | EMPRESARIAL | OTRO
  tipoServicio   String?  // RENTA | PRODUCCION_TECNICA | DIRECCION_TECNICA
  asistentes     Int?

  equiposDescripcion String?  // texto libre con los equipos a cotizar

  requiereTransporte Boolean @default(false)
  transporteConcepto String?

  llevaDescuento     Boolean @default(false)
  descuentoDetalle   String?

  notaEspecial   String?
  observaciones  String?  // notas/comentarios del vendedor al revisar
  sumaComision   Boolean  @default(false)
  entregable     String   @default("SOLO_PDF") // PRESENTACION_DESCUENTO | SOLO_PDF

  estado         String   @default("NUEVA") // NUEVA | ASIGNADA | COTIZADA | CONVERTIDA

  vendedorId     String?
  vendedor       User?    @relation("SolicitudCotizacionVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)

  creadoPorId    String?
  creadoPor      User?    @relation("SolicitudCotizacionCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)

  tratoId        String?  @unique
  trato          Trato?   @relation(fields: [tratoId], references: [id], onDelete: SetNull)

  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("solicitudes_cotizacion")
}

// Plantilla editable de tareas sugeridas por defecto en proyectos de evento,
// por tipo de servicio (PRODUCCION_TECNICA | RENTA | DIRECCION_TECNICA).
// Una fila = un ítem del checklist guiado. Se siembra desde PLANTILLAS_DEFAULT.
model PlantillaTareaEvento {
  id           String   @id @default(cuid())
  tipoServicio String   // PRODUCCION_TECNICA | RENTA | DIRECCION_TECNICA
  grupo        String   // Resumen | Operación | Producción | Finanzas
  area         String   // PRODUCCION | ADMINISTRACION
  titulo       String
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tipoServicio, activo])
  @@map("plantillas_tareas_evento")
}

// Tareas base por defecto de cada subetapa del proceso comercial. Al entrar un
// trato a una subetapa se instancian como Tarea ligada al trato (tipoOrigen TRATO).
// Se editan desde /crm/proceso. Fuente de verdad viva en BD; semilla en
// src/lib/plantillas-tareas-subetapa.ts. Migración lazy (patrón Neon).
model PlantillaTareaSubetapa {
  id           String   @id @default(cuid())
  etapaInterna String   // código de la subetapa (base o custom)
  titulo       String
  descripcion  String?  // detalle / instrucciones de la tarea (se copia a la Tarea del trato)
  area         String   @default("VENTAS")   // VENTAS | ADMINISTRACION | PRODUCCION | MARKETING | GENERAL
  prioridad    String   @default("MEDIA")     // URGENTE | ALTA | MEDIA | BAJA
  offsetDias   Int?     // vencimiento relativo a la entrada a la subetapa (días)
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([etapaInterna, activo])
  @@map("plantillas_tareas_subetapa")
}
