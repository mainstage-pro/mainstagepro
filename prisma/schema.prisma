model Proveedor {
  id             String   @id @default(cuid())
  nombre         String
  empresa        String?
  empresaId      String?
  compania       Empresa? @relation("ProveedorEmpresa", fields: [empresaId], references: [id])
  giro           String?
  telefono       String?
  correo         String?
  notas          String?
  rfc            String?
  cuentaBancaria String?  // número de cuenta
  clabe          String?
  banco          String?
  noTarjeta      String?
  datosFiscales  String?
  activo         Boolean  @default(true)
  prioridad      Int      @default(0)       // 0=sin prioridad, 1-3=estrellas
