generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  role                String    @default("USER") // ADMIN | USER | READONLY
  area                String?   @default("GENERAL") // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION | GENERAL
  active              Boolean   @default(true)
  fechaInicioVendedor DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tratos          Trato[]
  tratosOrigen    Trato[]            @relation("TratoVendedorOrigen")
  tratosVendedor  Trato[]            @relation("TratoVendedor")
  proyectos       Proyecto[]
  cotizaciones    Cotizacion[]
  bitacoras       ProyectoBitacora[]
  comisionesPagos ComisionPago[]
  moduloAccesos   ModuloAcceso[]
  tareasAsignadas       Tarea[]           @relation("TareasAsignadas")
  tareasCreadoPor       Tarea[]           @relation("TareasCreadoPor")
  tareasVerificadas     Tarea[]           @relation("TareasVerificadas")
  tareasColaborando     TareaColaborador[]
  iniciativasCreadas    IniciativaExterna[] @relation("IniciativasCreadas")
  carpetasCreadas       TareaCarpeta[]    @relation("CarpetasCreadas")
  proyectosTareaCreados TareaProyecto[]   @relation("ProyectosTareaCreados")
  comentariosTarea      TareaComentario[] @relation("ComentariosTarea")
  archivosTarea         TareaArchivo[]    @relation("ArchivosTarea")
  actividades           ActividadUsuario[] @relation("actividades")
  versiones             VersionHistorial[] @relation("versiones")
  clientesVendedor      Cliente[]          @relation("ClientesVendedor")
  notificaciones        Notificacion[]
  progresoCapacitaciones ProgresoCapacitacion[]
  intentosEvaluacion     IntentoEvaluacion[]

  juntasFacilitadas     Junta[]              @relation("JuntaFacilitador")
  juntasParticipadas    JuntaParticipante[]
  temasAdicionales      TemaAdicional[]      @relation("TemaAutor")
  proyectosInternosLider ProyectoInterno[]      @relation("ProyectoInternoLider")
  backlogItems           BacklogItem[]          @relation("BacklogCreadoPor")
  equipoNotasCreadas     EquipoNota[]           @relation("EquipoNotasCreadas")
  unidadObservaciones    UnidadObservacion[]    @relation("UnidadObservaciones")
  proyectoAccesos        ProyectoAcceso[]
  proyectoInternoAccesos ProyectoInternoAcceso[]
  reportesFormulario     ReporteFormulario[]    @relation("ReportesFormularioUser")

  // Plan de Trabajo
  ptTemplatesResponsable PTTareaTemplate[]      @relation("PTTemplateResponsable")
  ptInstanciasAsignadas  PTTareaInstancia[]     @relation("PTInstanciaResponsable")
  ptInstanciasCompletadas PTTareaInstancia[]    @relation("PTInstanciaCompletadaPor")
  ptComentarios          PTComentario[]         @relation("PTComentarioAutor")
  ptHistorial            PTHistorialEjecucion[] @relation("PTHistorialUsuario")

  // ── Captura / Ideas / Iniciativas ────────────────────────────────────────
  capturasRapidas        CapturaRapida[]        @relation("CapturaRapidaUsuario")
  ideasCreadas           Idea[]                 @relation("IdeaUsuario")
  iniciativasCaptura     Iniciativa[]           @relation("IniciativaUsuario")
  reportesArea           ReporteAreaSemanal[]   @relation("ReportesAreaAutor")
  presentacionesVenta    PresentacionVenta[]    @relation("PresentacionesVentaCreadas")
  prospecciones          Prospeccion[]          @relation("ProspeccionResponsable")
  tratosApoyo            TratoApoyo[]           @relation("TratoApoyoUsers")
  solicitudesCotizacionAsignadas SolicitudCotizacion[] @relation("SolicitudCotizacionVendedor")
  solicitudesCotizacionCreadas   SolicitudCotizacion[] @relation("SolicitudCotizacionCreador")
  visionesSemanales              VisionSemanal[]        @relation("VisionSemanalAutor")
  visionesResponsable            VisionSemanal[]        @relation("VisionSemanalResponsable")

  personalInterno PersonalInterno? @relation("PersonalUsuario")

  @@map("users")
}

model ActividadUsuario {
  id          String   @id @default(cuid())
  userId      String
  usuario     User     @relation("actividades", fields: [userId], references: [id])
  accion      String   // CREAR | EDITAR | ELIMINAR | APROBAR | ENVIAR | VER
  entidad     String   // cotizacion | proyecto | cliente | trato | etc.
  entidadId   String?
  descripcion String
  datos       String?  // JSON metadata
  createdAt   DateTime @default(now())
  @@map("actividad_usuario")
  @@index([userId])
  @@index([createdAt])
}

model VersionHistorial {
  id         String   @id @default(cuid())
  entidad    String   // "proyecto" | "cotizacion"
  entidadId  String
  userId     String
  usuario    User     @relation("versiones", fields: [userId], references: [id])
  snapshot   String   // JSON snapshot
  nota       String?
  createdAt  DateTime @default(now())
  @@map("version_historial")
  @@index([entidad, entidadId])
}

// ─── EMPRESA ─────────────────────────────────────────────────────────────────

model Empresa {
  id             String   @id @default(cuid())
  nombre         String
  giro           String?
  telefono       String?
  correo         String?
  sitioWeb       String?
  notas          String?
  rfc            String?
  datosFiscales  String?
  cuentaBancaria String?  // número de cuenta
  clabe          String?
  banco          String?
  noTarjeta      String?
  tipo           String   @default("AMBOS")  // CLIENTE | PROVEEDOR | AMBOS
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contactosCliente   Cliente[]   @relation("ClienteEmpresa")
  contactosProveedor Proveedor[] @relation("ProveedorEmpresa")
  cuentasCobrar      CuentaCobrar[]
  cuentasPagar       CuentaPagar[]

  @@map("empresas")
}

// ─── CLIENTE ─────────────────────────────────────────────────────────────────

model Cliente {
  id            String   @id @default(cuid())
  nombre        String
  empresa       String?
  empresaId     String?
  compania      Empresa? @relation("ClienteEmpresa", fields: [empresaId], references: [id])
  tipoCliente   String   @default("POR_DESCUBRIR") // B2B | B2C | POR_DESCUBRIR
  clasificacion String   @default("NUEVO")          // NUEVO | BASIC | REGULAR | PRIORITY
  perfilProspecto String? // (legacy, single) reemplazado por perfilesProspecto
  perfilesProspecto String? // JSON array de hasta 3 perfiles (built-in id o custom id)
  servicioUsual String?  // RENTA | PRODUCCION_TECNICA | DIRECCION_TECNICA | MULTISERVICIO
  tiposEvento   String?  // JSON: ["MUSICAL","SOCIAL","EMPRESARIAL","VARIOS"]
  telefono      String?
  correo        String?
  notas         String?
  categoriaKARE String?  @default("SIN_CATEGORIZAR") // KEEP | ATTAIN | RECOVER | EXPAND | SIN_CATEGORIZAR
  esProspecto   Boolean  @default(false)             // true mientras no haya tenido VENTA_CERRADA
  // ── Origen del prospecto (se llena al capturar el lead, sin necesitar un Trato) ──
  origenLead    String?  // META_ADS | GOOGLE_ADS | ORGANICO | REFERIDO | RECOMPRA | PROSPECCION | OTRO
  campana       String?  // nombre de la campaña de origen (Meta Ads, Google Ads, etc.)
  vendedorId    String?
  vendedor      User?    @relation("ClientesVendedor", fields: [vendedorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tratos          Trato[]
  cotizaciones    Cotizacion[]
  proyectos       Proyecto[]
  cuentasCobrar   CuentaCobrar[]
  movimientos     MovimientoFinanciero[]
  preciosEquipos  PrecioClienteEquipo[]
  prospecciones   Prospeccion[]
  solicitudesCotizacion SolicitudCotizacion[]
  tareas          Tarea[]  @relation("TareasDeCliente")

  @@map("clientes")
}

model PrecioClienteEquipo {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  equipoId  String
  equipo    Equipo  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  precio         Float
  precioOriginal Float?   // precio de lista al momento de registrar el especial
  nota           String?
  updatedAt      DateTime @updatedAt

  @@unique([clienteId, equipoId])
  @@map("precios_cliente_equipo")
}

// ─── TRATO ───────────────────────────────────────────────────────────────────

model Trato {
  id                  String   @id @default(cuid())
  clienteId           String
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
  responsableId       String?
  responsable         User?    @relation(fields: [responsableId], references: [id])
  tipoEvento          String   @default("OTRO")         // MUSICAL | SOCIAL | EMPRESARIAL | OTRO
  tipoLead            String   @default("INBOUND")      // INBOUND | OUTBOUND
  origenLead          String   @default("ORGANICO")     // META_ADS | GOOGLE_ADS | ORGANICO | RECOMPRA | REFERIDO | PROSPECCION | OTRO
  estatusContacto     String   @default("PENDIENTE")    // PENDIENTE | CONTACTADO
  etapa               String   @default("PROSPECCION") // PROSPECCION | DESCUBRIMIENTO | OPORTUNIDAD | VENTA_CERRADA | VENTA_PERDIDA
  etapaInterna        String?  // sub-etapa del pipeline — valores en src/lib/proceso/valores.ts (ETAPAS_INTERNAS)
  clasificacion       String   @default("PROSPECTO")    // PROSPECTO | BASIC | REGULAR | PRIORITY
  perfilProspecto     String?  // perfil elegido para este trato (built-in id o custom id)

  // ── DEPRECADOS (borrado físico diferido a la fase contract, tras reescribir UI Partes 6/7 + migrar datos Parte 8) ──
  // tipoProspecto: reemplazado por etapaInterna === 'NURTURING'. nurturingData/preferenciaContacto: contienen datos
  // capturados en tratos reales; se migran en la Parte 8 antes de eliminar. etapaContratacion: duplicado de momentoContratacion.
  tipoProspecto       String   @default("ACTIVO")  // @deprecated ACTIVO | NURTURING
  nurturingData       String?  // @deprecated JSON de nurturing
  preferenciaContacto String?  // @deprecated LLAMADA | PROPUESTA
  etapaContratacion   String?  // @deprecated duplicado de momentoContratacion
  tipoServicio        String?  // RENTA | PRODUCCION_TECNICA | DIRECCION_TECNICA
  subtipoEvento       String?  // CONCIERTO | FESTIVAL | ELECTRONICA | PRESENTACION_MUSICAL | FIESTA_PRIVADA | BODA | XV_ANOS | BAUTIZO | CUMPLEANIOS | CONGRESO | TALLER | LANZAMIENTO | FERIA | OTRO

  // ── Descubrimiento ────────────────────────────────────────────────────────
  canalAtencion          String?   // WHATSAPP | FORMULARIO | LLAMADA | REUNION | SCOUTING | INFORMACION
  nombreEvento           String?
  duracionEvento         String?   // ej: "6 horas", "2 días"
  asistentesEstimados    Int?
  serviciosInteres       String?   // JSON: ["AUDIO_PA","ILUMINACION","VIDEO_LED",...]
  ideasReferencias       String?   // links o descripción de referencias
  momentoContratacion    String?   // EXPLORANDO | COTIZANDO | LISTO_PARA_DECIDIR | URGENTE
  posibleDuplicado       Boolean   @default(false) // lo marca el cotejo de cliente para revisión manual
  rutaEntrada            String?   // DESCUBRIR | RIDER_DIRECTO
  continuarPor           String?   // WHATSAPP | LLAMADA | REUNION | COTIZACION
  descubrimientoCompleto Boolean   @default(false)
  descubrimientoNivel    String?   // BASICO | TECNICO — calculado, nunca capturado (ver lib/proceso/motor.ts)
  descubrimientoPendiente Boolean  @default(false) // cotización sin descubrimiento registrado (bandera de migración)
  equiposInteres         String?   // JSON: { categorias: string[], equipos: string[], roles: string[], aCriterioVendedor: boolean }
  modoDescubrimiento     String?   // FORMULARIO | LLAMADA — cómo se levantó el descubrimiento
  // ──────────────────────────────────────────────────────────────────────────

  lugarEstimado       String?
  fechaEventoEstimada DateTime?
  presupuestoEstimado Float?
  notas               String?
  proximaAccion       String?
  fechaProximaAccion  DateTime?
  formToken           String?  @unique
  formEstado          String   @default("NO_ENVIADO") // NO_ENVIADO | ENVIADO | COMPLETADO
  formRespuestas      String?  // JSON con respuestas del prospecto

  // ── Duración del servicio ────────────────────────────────────────────────
  diasServicio       Int?     // días de renta de equipo — se usa para pre-llenar cotizaciones
  fechasEvento       String?  // JSON: ["YYYY-MM-DD", ...] fechas explícitas del evento cuando dura varios días (día 1 = fechaEventoEstimada)
  // ── Horarios del evento (capturados durante ventas) ─────────────────────
  horaInicioEvento   String?  // ej: "18:00"
  horaFinEvento      String?  // ej: "23:00"
  duracionMontajeHrs Float?   // estimado en horas
  // ── Logística del venue ──────────────────────────────────────────────────
  ventanaMontajeInicio  String?  // ej: "08:00" — hora más temprana de acceso al venue
  ventanaMontajeFin     String?  // ej: "14:00" — hora límite para terminar montaje
  horaTerminoMontaje    String?  // hora en que debe concluir el desmontaje / salida del venue
  // ── Contacto del venue ───────────────────────────────────────────────────
  contactoVenueNombre   String?  // nombre del coordinador / encargado del venue
  contactoVenueTelefono String?  // teléfono del coordinador del venue
  // ── Origen de campos (para saber quién capturó qué) ──────────────────────
  camposCliente         String?  // JSON array de IDs de campos llenados por el cliente
  // ─────────────────────────────────────────────────────────────────────────

  scoutingData        String?  // JSON: venue scouting form data
  // ── Mainstage Trade ──────────────────────────────────────────────────────────
  tradeCalificado     Boolean  @default(false)
  tradeNivel          Int?     // 1 = Base | 2 = Estratégico | 3 = Premium
  familyAndFriends    Boolean  @default(false)
  realizarRender      Boolean  @default(false)
  // ─────────────────────────────────────────────────────────────────────────────
  motivoPerdida       String?  // PRECIO | FECHA | COMPETENCIA | SIN_RESPUESTA | EVENTO_CANCELADO
  etapaCambiadaEn     DateTime?
  requiereRevision    Boolean  @default(false)
  briefToken          String?  @unique  // token público para el formulario del cliente
  briefRecibidoEn     DateTime?         // cuando el cliente envió el brief
  origenVenta         String   @default("CLIENTE_PROPIO") // CLIENTE_PROPIO | PUBLICIDAD | ASIGNADO
  vendedorOrigenId    String?
  vendedorOrigen      User?    @relation("TratoVendedorOrigen", fields: [vendedorOrigenId], references: [id])
  vendedorId          String?
  vendedor            User?    @relation("TratoVendedor", fields: [vendedorId], references: [id])
  fechaCierre         DateTime?

  // ── Confirmación operativa (independiente del cierre comercial) ──────────────
  confirmadaEn        DateTime?  // timestamp de confirmación — puede existir en cualquier etapa
  metodoConfirmacion  String?    // VERBAL | ANTICIPO | CONTRATO | OTRO
  notaConfirmacion    String?

  // ── Cierre comercial ─────────────────────────────────────────────────────────
  montoFinal          Float?     // monto real de cierre (distinto de presupuestoEstimado)

  // ── Formulario de descubrimiento (campos adicionales) ───────────────────────
  contactoDecisorNombre String?  // nombre del decisor del cliente
  contactoDecisorCargo  String?  // cargo/rol del decisor

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  prospeccionId          String?    @unique
  prospeccion            Prospeccion? @relation("TratoProspeccion", fields: [prospeccionId], references: [id])

  cotizaciones           Cotizacion[]
  proyectos              Proyecto[]
  archivos               TratoArchivo[]
  levantamientoContenido LevantamientoContenido?
  seguimientos           Seguimiento[]
  apoyoDe                TratoApoyo[]
  solicitudOrigen        SolicitudCotizacion?
  tareas                 Tarea[]      @relation("TareasDeTrato")

  @@map("tratos")
}

// ─── FORMULARIO LEAD (link de descubrimiento huérfano, sin trato previo) ──────
// Se genera desde "+ Nuevo contacto" para que el cliente llene sus datos.
// Al enviarse, coteja/crea el Cliente y crea el Trato en el pipeline.
model FormularioLead {
  id              String   @id @default(cuid())
  token           String   @unique
  origenLead      String   @default("META_ADS")
  tipoServicio    String?
  tipoEvento      String?
  momentoSugerido String?  // EXPLORANDO | COTIZANDO | LISTO_DECIDIR | URGENTE
  responsableId   String?
  usado           Boolean  @default(false)
  tratoId         String?  // se llena cuando el formulario se convierte en trato
  createdAt       DateTime @default(now())

  @@map("formularios_lead")
}

model Seguimiento {
  id              String    @id @default(cuid())
  tratoId         String
  trato           Trato     @relation(fields: [tratoId], references: [id], onDelete: Cascade)
  tipo            String    @default("PROCESO") // TipoSeguimiento: PROCESO | MANUAL
  numero          Int?      // orden del paso dentro de la subetapa (para tipo PROCESO)
  etapaTrato      String?   // etapa (EtapaTrato) del trato al agendar el seguimiento
  etapaInterna    String?   // sub-etapa (EtapaInterna) al agendar el seguimiento
  procesoPasoId   String?   // paso del estándar que generó este seguimiento
  procesoPaso     ProcesoPaso? @relation(fields: [procesoPasoId], references: [id])
  guionSnapshot   String?   // texto del guión congelado al momento de generarse
  canal           String    @default("WHATSAPP") // CanalSeguimiento
  titulo          String
  nota            String?
  notaResultado   String?
  fechaProgramada DateTime
  fechaCompletado DateTime?
  completado      Boolean   @default(false)
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  @@map("seguimientos")
}

// ─── PROCESO COMERCIAL ESTÁNDAR (editable en BD) ─────────────────────────────

model ProcesoSubetapa {
  id                   String        @id @default(cuid())
  etapa                String        // EtapaTrato
  etapaInterna         String        @unique // EtapaInterna
  nombre               String
  descripcion          String?
  orden                Int
  activa               Boolean       @default(true)
  generacionAutomatica Boolean       @default(true)
  pasos                ProcesoPaso[]

  @@map("proceso_subetapas")
}

model ProcesoPaso {
  id              String          @id @default(cuid())
  subetapaId      String
  subetapa        ProcesoSubetapa @relation(fields: [subetapaId], references: [id], onDelete: Cascade)
  orden           Int
  dia             Int             // días desde etapaCambiadaEn
  diaUrgente      Int?
  titulo          String
  objetivo        String
  guion           String
  canal           String          // CanalSeguimiento
  herramienta     String?
  avanzaSubetapaA String?         // EtapaInterna
  activo          Boolean         @default(true)
  seguimientos    Seguimiento[]

  @@map("proceso_pasos")
}

model ProcesoRegla {
  id        String  @id @default(cuid())
  orden     Int
  texto     String
  categoria String  // CategoriaRegla: COMUNICACION | CADENCIA
  activa    Boolean @default(true)

  @@map("proceso_reglas")
}

// ─── TRATO APOYO (equipo de apoyo en la gestión) ─────────────────────────────

model TratoApoyo {
  id      String @id @default(cuid())
  tratoId String
  trato   Trato  @relation(fields: [tratoId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("TratoApoyoUsers", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tratoId, userId])
  @@map("trato_apoyo")
}

model TratoArchivo {
  id        String   @id @default(cuid())
  tratoId   String
  trato     Trato    @relation(fields: [tratoId], references: [id], onDelete: Cascade)
  nombre    String
  url       String
  tipo      String   @default("OTRO") // IMAGEN | DOCUMENTO | REFERENCIA | OTRO
  subidoPor String?
  createdAt DateTime @default(now())

  @@map("trato_archivos")
}

// ─── COTIZACIÓN ──────────────────────────────────────────────────────────────

model Cotizacion {
  id               String   @id @default(cuid())
  numeroCotizacion String   @unique
  version          Int      @default(1)
  opcionLetra      String   @default("A") @map("opcion_letra")
  grupoId          String?  @map("grupo_id")
  nombreCotizacion String?  @map("nombre_cotizacion")     // nombre editable: "Día 1 — Audio", "Escenario VIP", etc.
  descripcionCotizacion String? @map("descripcion_cotizacion") @db.Text // descripción breve visible en resumen global
  tratoId          String?
  trato            Trato?   @relation(fields: [tratoId], references: [id])
  paqueteId        String?  // Paquete comercial base del que se desglosó (para renders en presentación)
  paquete          Paquete? @relation(fields: [paqueteId], references: [id])
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id])
  creadaPorId      String?
  creadaPor        User?    @relation(fields: [creadaPorId], references: [id])
  estado           String   @default("BORRADOR") // BORRADOR | ENVIADA | EN_REVISION | AJUSTE_SOLICITADO | REENVIADA | APROBADA | RECHAZADA | VENCIDA
  eventoConfirmado Boolean  @default(false) // desbloqueo manual del calendario: el evento se confirmó aunque la cotización aún no se cierre/apruebe
  nombreEvento     String?
  tipoEvento       String?
  tipoServicio     String?
  fechaEvento      DateTime?
  lugarEvento      String?
  horasOperacion   Float?
  tipoJornada      String?  // CORTA | MEDIA | LARGA
  notasSecciones   String?  // JSON: { "Audio": "nota", "Iluminación": "nota", ... }

  diasEquipo     Int @default(1)
  diasOperacion  Int @default(1)
  diasTransporte Int @default(1)
  diasHospedaje  Int @default(1)
  diasComidas    Int @default(1)

  subtotalEquiposBruto   Float @default(0)
  descuentoVolumenPct    Float @default(0)
  descuentoB2bPct        Float @default(0)
  descuentoMultidiaPct   Float @default(0)
  descuentoPatrocinioPct Float @default(0)
  descuentoPatrocinioNota String?
  descuentoEspecialPct        Float @default(0)
  descuentoEspecialNota       String?
  descuentoFamilyFriendsPct   Float @default(0)
  descuentoFijoMonto          Float @default(0)
  descuentoManualRazon    String?           // razón interna del descuento manual
  descuentoManualEsMonto  Boolean @default(false)  // true = usa $ (descuentoFijoMonto), false = usa %
  pagoAnticipadoActivo    Boolean @default(false)
  pagoAnticipadoFecha     String?           // fecha límite como YYYY-MM-DD
  pagoAnticipadoTexto     String?           // texto editable de la sección
  descuentoTotalPct           Float @default(0)
  montoDescuento         Float @default(0)
  subtotalEquiposNeto    Float @default(0)
  subtotalPaquetes       Float @default(0)
  subtotalTerceros       Float @default(0)
  subtotalOperacion      Float @default(0)
  subtotalTransporte     Float @default(0)
  subtotalComidas        Float @default(0)
  subtotalHospedaje      Float @default(0)
  total                  Float @default(0)
  aplicaIva              Boolean @default(false)
  incluirChofer          Boolean @default(false)  // Toggle: agregar servicio de chofer ($500)
  montoIva               Float @default(0)
  granTotal              Float @default(0)

  // Gastos de Producción (comisión interna — se suma al granTotal)
  gastosProduccionActivo  Boolean @default(false) @map("gastos_produccion_activo")
  gastosProduccionEsMonto Boolean @default(false) @map("gastos_produccion_es_monto") // true = monto fijo, false = %
  gastosProduccionPct     Float   @default(10)    @map("gastos_produccion_pct")     // % por defecto 10%
  gastosProduccionMonto   Float   @default(0)     @map("gastos_produccion_monto")   // calculado o manual

  tipoBeneficio  String? // DESCUENTO_DIRECTO | SALDO_A_FAVOR
  montoBeneficio Float   @default(0)

  costosTotalesEstimados Float @default(0)
  utilidadEstimada       Float @default(0)
  porcentajeUtilidad     Float @default(0)

  mainstageTradeData  String?  // JSON: { activo, pct, entregables[], checklist, nivelSeleccionado, nivelAplicado, bonoVariable, clienteSeleccionoEn }
  tradeToken          String?  @unique @map("trade_token")
  planPagos           String?  // JSON: esquema de pagos (porcentajes y fechas para CxC)
  jornadasPlan        String?  // JSON: plan operativo de jornadas por fecha (JornadaPlan[])
  zonaEvento          String   @default("LOCAL") // LOCAL | BAJIO | NACIONAL — afecta bonus de personal
  numTecnicosZona     Int      @default(0)
  observaciones       String?
  terminosComerciales String?
  vigenciaDias        Int      @default(30)
  fechaEnvio          DateTime?
  fechaVencimiento    DateTime?
  aprobacionToken     String?  @unique @map("aprobacion_token")
  aprobacionFecha     DateTime? @map("aprobacion_fecha")
  aprobacionNombre    String?  @map("aprobacion_nombre")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lineas        CotizacionLinea[]
  proyecto      Proyecto?
  cuentasCobrar CuentaCobrar[]

  @@map("cotizaciones")
}

model CotizacionLinea {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  tipo         String     // EQUIPO_PROPIO | EQUIPO_EXTERNO | PAQUETE | OPERACION_TECNICA | TRANSPORTE | HOSPEDAJE | COMIDA | DJ | DESCUENTO_BENEFICIO | OTRO
  orden        Int        @default(0)

  equipoId     String?
  equipo       Equipo?     @relation(fields: [equipoId], references: [id])
  rolTecnicoId String?
  rolTecnico   RolTecnico? @relation(fields: [rolTecnicoId], references: [id])

  descripcion    String
  marca          String?
  modelo         String?
  nivel          String?  // AAA | AA | A
  jornada        String?  // CORTA | MEDIA | LARGA
  esExterno      Boolean  @default(false)
  proveedorId    String?
  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id])
  costoExterno   Float?
  cantidad       Float    @default(1)
  dias           Int      @default(1)
  precioUnitario Float    @default(0)
  costoUnitario  Float    @default(0)
  subtotal       Float    @default(0)
  esIncluido     Boolean  @default(false)
  notas          String?

  // Campos para déficit de stock propio (NO aparecen en PDF)
  cantidadPropia   Float?    // cuántas unidades propias se asignan
  cantidadExterna  Float?    // cuántas vienen de proveedor externo (déficit)
  proveedorRentaId String?   // proveedor que cubre el déficit
  proveedorRenta   Proveedor? @relation("ProveedorRentaLineas", fields: [proveedorRentaId], references: [id])
  notasInternas    String?   // notas internas que NO salen en el PDF

  @@map("cotizacion_lineas")
}

// ─── PROYECTO ────────────────────────────────────────────────────────────────

model Proyecto {
  id             String   @id @default(cuid())
  numeroProyecto String   @unique
  tratoId        String?
  trato          Trato?   @relation(fields: [tratoId], references: [id])
  cotizacionId   String   @unique
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id])
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  encargadoId    String?
  encargado      User?    @relation(fields: [encargadoId], references: [id])

  nombre                 String
  estado                 String   @default("PLANEACION") // PLANEACION | CONFIRMADO | EN_CURSO | COMPLETADO | CANCELADO
  tipoEvento             String
  tipoServicio           String?
  fechaEvento            DateTime
  fechasEvento           String?   // JSON: ["YYYY-MM-DD", ...] fechas explícitas cuando el proyecto dura varios días (día 1 = fechaEvento)
  horaInicioEvento       String?
  horaFinEvento          String?
  horariosEvento         String?   // JSON: {"YYYY-MM-DD": {inicio, fin}} horarios por día (día 1 = horaInicioEvento/horaFinEvento)
  fechaMontaje           DateTime?
  horaInicioMontaje      String?
  duracionMontajeHrs     Float?
  montajeDiaAparte       Boolean   @default(false) // true = el montaje es un día adicional (día antes); false = mismo día del evento
  desmontajeDiaAparte    Boolean   @default(false) // true = el desmontaje es un día adicional (día después); false = mismo día (último día del evento)
  fechaDesmontaje        DateTime? // fecha del desmontaje cuando es día aparte
  duracionDesmontajeHrs  Float?    // duración estimada del desmontaje (hrs) → término aproximado = inicio + duración
  // ─ Logística del día del evento ─
  horaMontaje            String?   // Hora de llegada/montaje al venue (día del evento)
  horaInicio             String?   // Hora de inicio del evento
  horaDesmontaje         String?   // Hora estimada de desmontaje y salida
  direccionVenue         String?   // Dirección completa del venue
  linkMaps               String?   // Link de Google Maps o referencia
  indicacionesAcceso     String?   @db.Text // Código de entrada, estacionamiento, persona que recibe
  puntoSalidaBodega      String?   // Punto de salida desde bodega
  horaSalidaBodega       String?   // Hora de salida desde bodega
  indicacionesCliente    String?   @db.Text // Lo que necesita tener listo el cliente
  lugarEvento            String?
  encargadoLugar         String?
  encargadoLugarContacto String?
  descripcionGeneral     String?
  detallesEspecificos    String?
  encargadoCliente         String?  // Nombre del encargado de parte del cliente
  encargadoClienteContacto String?  // Teléfono / contacto del encargado del cliente
  transportes            String?  // Descripción de transportes del evento
  aplicaCatering         Boolean  @default(false) // Si el proyecto requiere catering de producción
  proveedorCatering      String?  // Proveedor de catering / alimentación producción
  contactosDireccion     String?  // Contactos de dirección y coordinación
  cronograma             String?
  contactosEmergencia    String?
  comentariosFinales     String?
  scoreFotoVideo         Int?
  recomendacionFotoVideo String?
  // Logística de renta (JSON con modalidad, fechas, dirección de entrega/devolución)
  logisticaRenta         String?
  // Reporte de catering (JSON: contactoNombre, contactoTelefono, personasCrew, comidas[], notas)
  reporteCatering        String?
  // Marketing content (JSON: { activo: boolean, telefono: string, nombre: string })
  marketingData          String?
  // Documentos técnicos por tipo de evento (JSON estructurado)
  docsTecnicos           String?
  // Reporte post evento del coordinador (hechos + evidencia obligatoria, JSON)
  evaluacionPostEvento   Json?
  // Evaluación de dirección del evento (calificación 1-5 por dimensión, JSON)
  evaluacionDireccion    Json?
  // Chofer asignado al proyecto
  choferNombre           String?   // Nombre del chofer (del personal del proyecto o externo)
  choferExterno          Boolean   @default(false)  // true = chofer externo (genera CxP)
  choferCosto            Float?    // Costo del chofer externo
  // Recolección de equipo rentado (solo proyectos RENTA)
  recoleccionStatus      String    @default("NO_APLICA")  // NO_APLICA | PENDIENTE | EN_CAMINO | COMPLETADA
  recoleccionNotas       String?   // Observaciones al recolectar (daños, faltantes, etc.)
  recoleccionFechaReal   DateTime? // Fecha/hora real en que se recolectó el equipo
  protocoloSalida        String?   // JSON: protocolo de entrega al cliente (responsable, condicion, items[], timestamp)
  protocoloEntrada       String?   // JSON: protocolo de recepción en bodega (responsable, condicion, danios, items[], timestamp)
  portalToken            String?   @unique // Token público para portal de cliente
  infoToken              String?   @unique // Token público para que el cliente confirme/complete la info del resumen
  infoRecibidoEn         DateTime? // Timestamp en que el cliente envió la confirmación de información
  notasPortal            String?   // Mensaje visible al cliente en su portal
  responsables           String?   // JSON: { produccion, logistica, finanzas, marketing } → { userId, nombre }
  proveedoresRenta       String?   // JSON: [{ id, nombre, contacto, equipos: string[] }] — proveedores de subarriendo manuales
  equiposRiderExtra      String?   // JSON: [{ id, descripcion, cantidad, notas?, completado }] — equipos fuera de cotización
  planProduccion         String?   // JSON: plan completo de producción (briefing, equipos, personal, logística, cronograma)
  planProduccionAprobado Boolean   @default(false) // true cuando el encargado aprueba el plan >= 72h antes
  planProduccionAprobadoEn DateTime? // timestamp de aprobación
  zona                   String    @default("LOCAL") // LOCAL | BAJIO | NACIONAL
  // Brief Técnico
  llamadoBodega          DateTime? // hora de presentación en bodega (llamado)
  lugarLlamado           String?   // lugar de presentación (llamado)
  notasBriefTecnico      String?   @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  personal          ProyectoPersonal[]
  equipos           ProyectoEquipo[]
  checklist         ProyectoChecklist[]
  archivos          ProyectoArchivo[]
  bitacora          ProyectoBitacora[]
  cuentasCobrar     CuentaCobrar[]
  cuentasPagar      CuentaPagar[]
  movimientos       MovimientoFinanciero[]
  evaluacionInterna EvaluacionInterna?
  evaluacionCliente EvaluacionCliente?
  reportePostEvento ReportePostEvento?
  gastosOperativos  GastoOperativo[]
  ordenesCompra     OrdenCompra[]
  cierreFinanciero  CierreFinanciero?
  tareas            Tarea[]            @relation("TareasDeProyecto")
  proveedoresEvento ProveedorEvento[]
  actasEvento       ActaAdministrativa[] @relation("ActaEventoProyecto")

  @@map("proyectos")
}

// Bandeja de entrada de proyectos: ideas capturadas antes de convertirse en un
// proyecto de evento formal. Sin relaciones Prisma (ids planos) para mantenerlo
// autocontenido. La tabla se crea de forma lazy en prod (ver ensureProyectoIdeasTable).
model ProyectoIdea {
  id            String   @id @default(cuid())
  titulo        String
  descripcion   String?  @db.Text
  area          String   @default("GENERAL") // VENTAS | ADMINISTRACION | PRODUCCION | MARKETING | RRHH | DIRECCION | GENERAL
  responsableId String?  // User.id del responsable (sin relación Prisma)
  estado        String   @default("PENDIENTE") // PENDIENTE | CONVERTIDA | DESCARTADA
  proyectoId    String?  // Proyecto.id creado al convertir la idea
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("proyecto_ideas")
}

model ProyectoPersonal {
  id              String   @id @default(cuid())
  proyectoId      String
  proyecto        Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tecnicoId       String?
  tecnico         Tecnico? @relation(fields: [tecnicoId], references: [id])
  rolTecnicoId    String?
  rolTecnico      RolTecnico? @relation(fields: [rolTecnicoId], references: [id])
  participacion   String?  // OPERACION | MONTAJE | DESMONTAJE | TRANSPORTE | OTRO
  fechaJornada    String?  // YYYY-MM-DD — fecha específica de la jornada (del plan de jornadas)
  nivel           String?  // AAA | AA | A
  jornada         String?  // CORTA | MEDIA | LARGA
  responsabilidad String?
  confirmado      Boolean  @default(false)
  confirmRespuesta String? // CONFIRMADO | RECHAZADO
  confirmToken    String?  @unique // Token para link de confirmación por WhatsApp
  tarifaAcordada  Float?
  estadoPago      String   @default("PENDIENTE") // PENDIENTE | PAGADO
  movimientoId    String?  @unique // Movimiento financiero (GASTO) generado al marcar PAGADO
  movimiento      MovimientoFinanciero? @relation(fields: [movimientoId], references: [id])
  notas           String?
  rolEnEvento     String?  // Rol específico en este evento (ej: Operador de audio, Iluminación)
  esAdicional     Boolean  @default(false) // Técnico agregado fuera de lo cotizado (marcador interno; NO afecta PDFs)
  necesitaRevision Boolean @default(false) // El rol se quitó de la cotización — revisar sin borrar (sync)

  @@map("proyecto_personal")
}

model ProyectoEquipo {
  id               String    @id @default(cuid())
  proyectoId       String
  proyecto         Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  equipoId         String
  equipo           Equipo    @relation(fields: [equipoId], references: [id])
  tipo             String    @default("PROPIO") // PROPIO | EXTERNO
  cantidad         Int       @default(1)
  dias             Int       @default(1)
  costoExterno     Float?
  proveedorId      String?
  proveedor        Proveedor? @relation(fields: [proveedorId], references: [id])
  confirmado       Boolean   @default(false)
  confirmDisponible Boolean? // Respuesta del proveedor sobre disponibilidad
  confirmToken     String?   @unique // Token para link de confirmación al proveedor
  notas            String?   // Comentarios / instrucciones de carga para este equipo
  necesitaRevision Boolean   @default(false) // El equipo se quitó/redujo en la cotización — revisar sin borrar (sync)
  riderAccesorios  RiderAccesorio[]

  @@map("proyecto_equipos")
}

// Accesorios de rider para un equipo en un proyecto específico
model RiderAccesorio {
  id               String         @id @default(cuid())
  proyectoEquipoId String
  proyectoEquipo   ProyectoEquipo @relation(fields: [proyectoEquipoId], references: [id], onDelete: Cascade)
  nombre           String
  cantidad         Int            @default(1)
  categoria        String?        // cable | herramienta | consumible | soporte | otro
  completado       Boolean        @default(false)
  esSugerencia     Boolean        @default(false)
  orden            Int            @default(0)
  createdAt        DateTime       @default(now())

  @@map("rider_accesorios")
}

model ProyectoChecklist {
  id              String    @id @default(cuid())
  proyectoId      String
  proyecto        Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tipo            String    @default("OPERACION") // OPERACION | RIDER
  item            String
  completado      Boolean   @default(false)
  completadoPor   String?
  fechaCompletado DateTime?
  orden           Int       @default(0)
  notas           String?

  @@map("proyecto_checklist")
}

model ProyectoArchivo {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tipo       String   // RENDER | PLOT_PATCH | INPUT_LIST | RIDER | ITINERARIO | DOCUMENTO | OTRO
  nombre     String
  url        String
  subidoPor  String?
  createdAt  DateTime @default(now())

  @@map("proyecto_archivos")
}

model ProyectoBitacora {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuarioId  String?
  usuario    User?    @relation(fields: [usuarioId], references: [id])
  tipo       String   @default("NOTA") // NOTA | CAMBIO | ALERTA | ACCION
  contenido  String
  createdAt  DateTime @default(now())

  @@map("proyecto_bitacora")
}

// ─── CATÁLOGOS ───────────────────────────────────────────────────────────────

model Equipo {
  id                   String          @id @default(cuid())
  categoriaId          String
  categoria            CategoriaEquipo @relation(fields: [categoriaId], references: [id])
  subcategoria         String?
  marca                String?
  modelo               String?
  descripcion          String
  cantidadTotal        Int             @default(1)
  tipo                 String          @default("PROPIO") // PROPIO | EXTERNO
  proveedorDefaultId   String?
  proveedorDefault     Proveedor?      @relation("ProveedorDefault", fields: [proveedorDefaultId], references: [id])
  precioRenta          Float           @default(0)  // Precio que cobramos al cliente
  costoProveedor       Float?                        // Costo que nos cobra el proveedor (solo equipos externos)
  costoInternoEstimado Float?                        // Costo interno estimado (mantenimiento, para equipos propios)
  estado               String          @default("ACTIVO") // ACTIVO | EN_MANTENIMIENTO | DADO_DE_BAJA
  amperajeRequerido    Float?          // Consumo eléctrico en amperes
  voltajeRequerido     String?         // Voltaje requerido ("110" | "220" | "AMBOS")
  notas                String?
  descripcionInterna   String?         // Descripción interna del equipo (qué es / para qué sirve), no visible al cliente
  imagenUrl            String?         // URL principal del equipo (ruta /inventario/equipos/... o base64)
  imagenesUrls         String?         // JSON array de URLs adicionales
  propietario          String          @default("MAINSTAGE") // MAINSTAGE | HERVAM
  activo               Boolean         @default(true)
  fechaBaja            DateTime?       // Fecha en que se dió de baja (estado = DADO_DE_BAJA)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  cotizacionLineas     CotizacionLinea[]
  proyectoEquipos      ProyectoEquipo[]
  mantenimientos       MantenimientoEquipo[]
  plantillaItems       PlantillaEquipoItem[]
  plantillaCotizacionLineas PlantillaCotizacionLinea[]
  preciosClientes      PrecioClienteEquipo[]
  checklistBodegaItems ChecklistBodegaItem[]
  unidades             EquipoUnidad[]
  accesorios           EquipoAccesorio[]
  notasEquipo          EquipoNota[]
  proveedoresPrecios   EquipoProveedorPrecio[] @relation("EquipoProveedores")
  productoItems        ProductoEquipo[]
  productosDominante   Producto[]              @relation("ProductoEquipoDominante")
  paqueteItems         PaqueteItem[]

  @@map("equipos")
}

model EquipoProveedorPrecio {
  id          String    @id @default(cuid())
  equipoId    String
  equipo      Equipo    @relation("EquipoProveedores", fields: [equipoId], references: [id], onDelete: Cascade)
  proveedorId String
  proveedor   Proveedor @relation("ProveedorEquiposPrecios", fields: [proveedorId], references: [id], onDelete: Cascade)
  precio      Float     @default(0)   // precio que nos cobra este proveedor por día
  notas       String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([equipoId, proveedorId])
  @@map("equipo_proveedor_precios")
}

model EquipoNota {
  id          String   @id @default(cuid())
  equipoId    String
  equipo      Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  contenido   String
  creadoPorId String
  creadoPor   User     @relation("EquipoNotasCreadas", fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@map("equipo_notas")
}

// Biblioteca permanente de accesorios por equipo (persiste entre proyectos)
model EquipoAccesorio {
  id        String   @id @default(cuid())
  equipoId  String
  equipo    Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  nombre    String
  categoria String?  // cable | herramienta | consumible | soporte | otro
  createdAt DateTime @default(now())

  @@map("equipo_accesorios")
}

model CategoriaEquipo {
  id                 String   @id @default(cuid())
  nombre             String   @unique
  orden              Int      @default(0)
  descripcionInterna String?  // Descripción amplia interna (módulo de inventario)
  descMusical        String?  // Descripción amigable para eventos musicales (cotización/presentación)
  descSocial         String?  // Descripción amigable para eventos sociales
  descEmpresarial    String?  // Descripción amigable para eventos empresariales
  equipos            Equipo[]

  @@map("categoria_equipos")
}

// Producto/paquete comercial: agrupa varios equipos del inventario en un solo
// concepto vendible ("Sistema EV EKX12P — 2 medios + 2 bajos"). El precio y la
// disponibilidad siempre se derivan del inventario (Equipo), nunca se duplican.
model Producto {
  id                 String   @id @default(cuid())
  nombre             String
  descripcion        String?
  categoria          String?  // AUDIO | ILUMINACION | VIDEO | DJ | ESTRUCTURA | OTRO — agrupa en la UI
  tiposEvento        String?  // JSON array: ["MUSICAL","SOCIAL","EMPRESARIAL"] — sugerencia por tipo de evento
  imagenUrl          String?  // imagen del producto (por default la del equipo dominante; editable)
  equipoDominanteId  String?  // equipo cuya imagen se usa por default
  equipoDominante    Equipo?  @relation("ProductoEquipoDominante", fields: [equipoDominanteId], references: [id])
  precioManual       Float?   // override opcional; si es null el precio = suma de rentas de los items
  precioFinal        Float    @default(0) // cache: precioManual ?? Σ(cantidad × equipo.precioRenta)
  activo             Boolean  @default(true)
  orden              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items              ProductoEquipo[]
  coberturas         ProductoCobertura[]
  paqueteItems       PaqueteItem[]
  adicionales        Adicional[]

  @@map("productos")
}

// Cobertura de capacidad de un producto POR tipo de evento. Un mismo producto
// puede ser suficiente para más gente en un evento social que en uno musical,
// así que la capacidad se define por tipo de evento, no global. Los rangos son
// los mismos labels editables de paquete_rangos (0-50, 100-200, ...). `subtipos`
// (eventos específicos) es opcional: vacío = aplica a todos los del tipo.
model ProductoCobertura {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipoEvento String   // MUSICAL | SOCIAL | EMPRESARIAL
  rangos     String?  // JSON array de labels de rango cubiertos en este tipo
  subtipos   String?  // JSON array de eventos específicos (labels); vacío = todos

  @@unique([productoId, tipoEvento])
  @@index([productoId])
  @@map("producto_coberturas")
}

model ProductoEquipo {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  equipoId   String
  equipo     Equipo   @relation(fields: [equipoId], references: [id])
  cantidad   Int      @default(1)
  orden      Int      @default(0)

  @@map("producto_equipos")
}

// ── Paquetes ──────────────────────────────────────────────────────────────────
// Un Paquete es una propuesta base cotizable por tipo y tamaño de evento. Agrupa
// equipos del inventario y/o productos armados, más los conceptos operativos
// (personal, transporte, hospedaje, comida/viáticos, otros). Al elegirse en el
// descubrimiento se vuelca DESGLOSADO a la cotización. Tablas creadas lazy
// (ensurePaquetesTables en src/lib/paquetes.ts) — patrón Neon sin migración formal.
model Paquete {
  id             String   @id @default(cuid())
  nombre         String
  tipoEvento     String   // MUSICAL | SOCIAL | EMPRESARIAL — define la pestaña
  rangoPersonas  String?  // "1-100" | "100-300" | ... | "3000-5000"
  subtiposEvento String?  // JSON array de subtipos específicos (Boda, Concierto, etc.)
  resumen        String?  // resumen corto (generable con IA)
  descripcion    String?  @db.Text // descripción general (generable con IA)
  propuestaValor String?  @db.Text // propuesta de valor (generable con IA)
  activo         Boolean  @default(true)
  orden          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items        PaqueteItem[]
  conceptos    PaqueteConcepto[]
  imagenes     PaqueteImagen[]
  cotizaciones Cotizacion[]

  @@map("paquetes")
}

model PaqueteItem {
  id         String    @id @default(cuid())
  paqueteId  String
  paquete    Paquete   @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  tipo       String    @default("EQUIPO") // EQUIPO | PRODUCTO
  equipoId   String?
  equipo     Equipo?   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cantidad   Int       @default(1)
  orden      Int       @default(0)

  @@index([paqueteId])
  @@map("paquete_items")
}

model PaqueteConcepto {
  id            String      @id @default(cuid())
  paqueteId     String
  paquete       Paquete     @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  tipo          String      // OPERACION_TECNICA | TRANSPORTE | HOSPEDAJE | COMIDA | OTRO
  descripcion   String
  rolTecnicoId  String?
  rolTecnico    RolTecnico? @relation(fields: [rolTecnicoId], references: [id], onDelete: SetNull)
  nivel         String?     // AAA | AA | A (para OPERACION_TECNICA)
  jornada       String?     // CORTA | MEDIA | LARGA (para OPERACION_TECNICA)
  cantidad      Float       @default(1)
  dias          Int         @default(1)
  precioUnitario Float      @default(0)
  orden         Int         @default(0)

  @@index([paqueteId])
  @@map("paquete_conceptos")
}

model PaqueteImagen {
  id        String  @id @default(cuid())
  paqueteId String
  paquete   Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  url       String
  orden     Int     @default(0)

  @@index([paqueteId])
  @@map("paquete_imagenes")
}

model PaqueteRango {
  id        String   @id @default(cuid())
  label     String   @unique // "0-50" | "100-200" | ... — rango de personas editable
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("paquete_rangos")
}

model RolTecnico {
  id          String  @id @default(cuid())
  nombre      String
  disciplina  String? // AUDIO | ILUMINACION | VIDEO | RIGGING | STAGE | DJ | STAFF_GENERAL — categoría para ligar con la BD de técnicos
  tipoPago    String  @default("POR_JORNADA") // POR_JORNADA | POR_PROYECTO | POR_HORA | TARIFA_PLANA

  tarifaAAACorta Float?
  tarifaAAAMedia Float?
  tarifaAAALarga Float?
  tarifaAACorta  Float?
  tarifaAAMedia  Float?
  tarifaAALarga  Float?
  tarifaACorta   Float?
  tarifaAMedia   Float?
  tarifaALarga   Float?

  tarifaPlanaAAA Float?
  tarifaPlanaAA  Float?
  tarifaPlanaA   Float?

  tarifaHoraAAA Float?
  tarifaHoraAA  Float?
  tarifaHoraA   Float?

  descripcion String?
  activo      Boolean @default(true)
  orden       Int     @default(0)

  cotizacionLineas CotizacionLinea[]
  proyectoPersonal ProyectoPersonal[]
  tecnicos         Tecnico[]
  paqueteConceptos PaqueteConcepto[]

  @@map("roles_tecnicos")
}

model Tecnico {
  id                 String     @id @default(cuid())
  nombre             String
  celular            String?
  rolId              String?
  rol                RolTecnico? @relation(fields: [rolId], references: [id])
  nivel              String     @default("A") // AAA | AA | A
  zonaHabitual       String?
  evaluacionPromedio Float?
  cuentaBancaria     String?
  datosFiscales      String?
  activo             Boolean    @default(true)
  prioridad          Int        @default(0)        // 0=sin prioridad, 1-3=estrellas
  comentarios        String?
  habilidades        String?    // JSON array of skill tags
  disciplina         String[]   @default([])
  createdAt          DateTime   @default(now())

  proyectoPersonal ProyectoPersonal[]
  cuentasPagar     CuentaPagar[]

  @@map("tecnicos")
}

model Proveedor {
  id             String   @id @default(cuid())
  nombre         String
  empresa        String?
  empresaId      String?
  compania       Empresa? @relation("ProveedorEmpresa", fields: [empresaId], references: [id])
  giro           String?
  telefono       String?
  correo         String?
  notas          String?
  rfc            String?
  cuentaBancaria String?  // número de cuenta
  clabe          String?
  banco          String?
  noTarjeta      String?
  datosFiscales  String?
  activo         Boolean  @default(true)
  prioridad      Int      @default(0)       // 0=sin prioridad, 1-3=estrellas
  portalToken    String?  @unique @map("portal_token")
  createdAt      DateTime @default(now())

  equiposDefault   Equipo[]           @relation("ProveedorDefault")
  cotizacionLineas CotizacionLinea[]
  proyectoEquipos  ProyectoEquipo[]
  cuentasPagar     CuentaPagar[]
  movimientos      MovimientoFinanciero[]
  ordenesCompra    OrdenCompra[]
  equiposPortal    EquipoProveedor[]
  equiposPrecios   EquipoProveedorPrecio[] @relation("ProveedorEquiposPrecios")
  lineasRenta      CotizacionLinea[]      @relation("ProveedorRentaLineas")
  pasivosDeuda     PasivoDeuda[]

  @@map("proveedores")
}

model GiroProveedor {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())

  @@map("giros_proveedor")
}

model EquipoProveedor {
  id               String    @id @default(cuid())
  proveedorId      String    @map("proveedor_id")
  proveedor        Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  // Identificación
  categoria        String    @default("OTRO")  // AUDIO | VIDEO | ILUMINACION | BACKLINE | ESCENOGRAFIA | LOGISTICA | OTRO
  descripcion      String
  marca            String?
  modelo           String?
  serialNum        String?   @map("serial_num")
  anioFabricacion  Int?      @map("anio_fabricacion")

  // Inventario y condición
  cantidad         Int       @default(1)
  condicion        String    @default("BUENO")  // NUEVO | BUENO | REGULAR | NECESITA_REVISION
  disponibilidad   String    @default("DISPONIBLE") // DISPONIBLE | EN_USO | EN_MANTENIMIENTO | NO_DISPONIBLE

  // Especificaciones técnicas
  potenciaW        Float?    @map("potencia_w")
  voltaje          String?   // "110" | "220" | "110/220"
  amperaje         Float?
  pesoKg           Float?    @map("peso_kg")
  dimensiones      String?   // "L x A x H cm"
  incluyeCase      Boolean   @default(false) @map("incluye_case")
  tiempoSetupMin   Int?      @map("tiempo_setup_min")

  // Precios (legado)
  precioDia        Float?    @map("precio_dia")
  precioEventoFull Float?    @map("precio_evento_full")
  precioMinimoEvent Float?   @map("precio_minimo_event")
  // Precios nuevos
  precioPublico    Float?    @map("precio_publico")    // Precio sugerido al público por el proveedor
  precioMainstage  Float?    @map("precio_mainstage")  // Precio que cobra a Mainstage

  // Notas y documentación
  notas            String?
  fotosUrls        String?   @map("fotos_urls")   // JSON array de URLs
  fichaTecnicaUrl  String?   @map("ficha_tecnica_url")

  // Control interno
  aprobado         Boolean   @default(false)
  importadoEquipoId String?  @map("importado_equipo_id")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")

  @@map("equipos_proveedor")
}

// ─── ÓRDENES DE COMPRA ───────────────────────────────────────────────────────

model OrdenCompra {
  id            String    @id @default(cuid())
  numero        String    @unique
  proveedorId   String    @map("proveedor_id")
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])
  proyectoId    String?   @map("proyecto_id")
  proyecto      Proyecto? @relation(fields: [proyectoId], references: [id])
  descripcion   String
  estado        String    @default("PENDIENTE") @map("estado") // PENDIENTE | CONFIRMADA | RECIBIDA | CANCELADA
  fechaRequerida DateTime? @map("fecha_requerida")
  fechaEntrega   DateTime? @map("fecha_entrega")
  monto         Float     @default(0)
  montoIva      Float     @default(0) @map("monto_iva")
  total         Float     @default(0)
  notas         String?
  lineas        String?   // JSON: [{descripcion, cantidad, precioUnitario, subtotal}]
  creadoPorId   String?   @map("creado_por_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  @@map("ordenes_compra")
}

// ─── FINANZAS ────────────────────────────────────────────────────────────────

model CuentaBancaria {
  id           String  @id @default(cuid())
  nombre       String
  banco        String?
  numeroCuenta String?
  clabe        String?
  titular      String?
  rfc          String?
  activa       Boolean @default(true)

  movimientosEntrada MovimientoFinanciero[] @relation("CuentaDestino")
  movimientosSalida  MovimientoFinanciero[] @relation("CuentaOrigen")
  cuentasCobrar      CuentaCobrar[]
  cuentasPagar       CuentaPagar[]
  pagosNomina        PagoNomina[]
  abonos             Abono[]
  abonosPago         AbonoPago[]

  @@map("cuentas_bancarias")
}

model TipoMovimiento {
  id              String  @id @default(cuid())
  clave           String  @unique // llave usada en MovimientoFinanciero.tipo / CategoriaFinanciera.tipo
  nombre          String
  naturaleza      String  @default("SALIDA") // ENTRADA (entra a caja) | SALIDA (sale de caja) | NEUTRO (entre cuentas)
  afectaResultado Boolean @default(true) // cuenta en el estado de resultados (ingreso/gasto operativo)
  color           String  @default("gray")
  orden           Int     @default(0)
  sistema         Boolean @default(false) // tipos base: no se pueden eliminar ni renombrar la clave
  activo          Boolean @default(true)

  @@map("tipos_movimiento")
}

model CategoriaFinanciera {
  id          String  @id @default(cuid())
  nombre      String
  tipo        String // clave de TipoMovimiento (INGRESO | GASTO | TRANSFERENCIA | INVERSION | RETIRO | personalizados)
  orden       Int     @default(0)
  descripcion String?

  movimientos  MovimientoFinanciero[]
  cuentasPagar CuentaPagar[]

  @@map("categorias_financieras")
}

model MovimientoFinanciero {
  id                  String   @id @default(cuid())
  fecha               DateTime
  cuentaOrigenId      String?
  cuentaOrigen        CuentaBancaria? @relation("CuentaOrigen", fields: [cuentaOrigenId], references: [id])
  cuentaDestinoId     String?
  cuentaDestino       CuentaBancaria? @relation("CuentaDestino", fields: [cuentaDestinoId], references: [id])
  tipo                String   // INGRESO | GASTO | TRANSFERENCIA | INVERSION | RETIRO
  clienteId           String?
  cliente             Cliente? @relation(fields: [clienteId], references: [id])
  proveedorId         String?
  proveedor           Proveedor? @relation(fields: [proveedorId], references: [id])
  proyectoId          String?
  proyecto            Proyecto? @relation(fields: [proyectoId], references: [id])
  categoriaId         String?
  categoria           CategoriaFinanciera? @relation(fields: [categoriaId], references: [id])
  concepto            String
  monto               Float
  metodoPago          String   @default("TRANSFERENCIA") // TRANSFERENCIA | EFECTIVO | TARJETA | CHEQUE
  referencia          String?
  estatusConciliacion String   @default("PENDIENTE") // PENDIENTE | CONCILIADO
  comprobanteUrl      String?
  notas               String?
  creadoPor           String?
  createdAt           DateTime @default(now())

  cuentaPagar       CuentaPagar?
  pagoNomina        PagoNomina?
  abono             Abono?
  abonoPago         AbonoPago?
  proyectoPersonal  ProyectoPersonal?

  @@map("movimientos_financieros")
}

model CuentaCobrar {
  id              String   @id @default(cuid())
  clienteId       String?
  cliente         Cliente? @relation(fields: [clienteId], references: [id])
  empresaId       String?
  empresa         Empresa? @relation(fields: [empresaId], references: [id])
  proyectoId      String?
  proyecto        Proyecto? @relation(fields: [proyectoId], references: [id])
  cotizacionId    String?
  cotizacion      Cotizacion? @relation(fields: [cotizacionId], references: [id])
  concepto        String
  tipoPago        String   @default("TOTAL") // TOTAL | ANTICIPO | LIQUIDACION | OTRO
  monto           Float
  fechaCompromiso DateTime
  fechaCobroReal  DateTime?
  estado          String   @default("PENDIENTE") // PENDIENTE | PARCIAL | LIQUIDADO | VENCIDO
  montoCobrado    Float    @default(0)
  cuentaDestinoId String?
  cuentaDestino   CuentaBancaria? @relation(fields: [cuentaDestinoId], references: [id])
  notas           String?
  montoOriginal   Float?   // monto al momento de la creación, antes de ajustes
  ajustesLog      String?  // JSON: [{fecha, de, a, motivo, usuario}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  abonos          Abono[]
  cuotas          CuotaCobro[]

  @@map("cuentas_cobrar")
}

model Abono {
  id               String   @id @default(cuid())
  cuentaCobrarId   String
  cuentaCobrar     CuentaCobrar @relation(fields: [cuentaCobrarId], references: [id], onDelete: Cascade)
  monto            Float
  fecha            DateTime
  metodoPago       String   @default("TRANSFERENCIA") // TRANSFERENCIA | EFECTIVO | TARJETA | CHEQUE
  notas            String?
  cuentaDestinoId  String?
  cuentaDestino    CuentaBancaria? @relation(fields: [cuentaDestinoId], references: [id])
  movimientoId     String?  @unique
  movimiento       MovimientoFinanciero? @relation(fields: [movimientoId], references: [id], onDelete: SetNull)
  creadoPor        String?
  createdAt        DateTime @default(now())

  cuotaCobro       CuotaCobro?

  @@map("abonos")
}

model CuentaPagar {
  id              String   @id @default(cuid())
  tipoAcreedor    String   // PROVEEDOR | TECNICO | PERSONAL_INTERNO | OTRO | EMPRESA | SOCIO
  tecnicoId       String?
  tecnico         Tecnico? @relation(fields: [tecnicoId], references: [id])
  proveedorId     String?
  proveedor       Proveedor? @relation(fields: [proveedorId], references: [id])
  empresaId       String?
  empresa         Empresa? @relation(fields: [empresaId], references: [id])
  socioId         String?
  socio           Socio? @relation(fields: [socioId], references: [id])
  proyectoId      String?
  proyecto        Proyecto? @relation(fields: [proyectoId], references: [id])
  concepto        String
  monto           Float
  montoPagado     Float    @default(0)
  fechaCompromiso DateTime
  fechaPagoReal   DateTime?
  estado          String   @default("PENDIENTE") // PENDIENTE | PARCIAL | LIQUIDADO | VENCIDO
  cuentaOrigenId  String?
  cuentaOrigen    CuentaBancaria? @relation(fields: [cuentaOrigenId], references: [id])
  categoriaId     String?
  categoria       CategoriaFinanciera? @relation(fields: [categoriaId], references: [id])
  movimientoId    String?  @unique
  movimiento      MovimientoFinanciero? @relation(fields: [movimientoId], references: [id])
  notas           String?
  montoOriginal   Float?   // monto al momento de la creación, antes de ajustes
  ajustesLog      String?  // JSON: [{fecha, de, a, motivo, usuario}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  abonos          AbonoPago[]
  cuotas          CuotaPago[]
  cuotaDeuda      CuotaDeuda?     @relation("CuotaDeudaCxP")
  cuotaReparto    CuotaReparto?   @relation("CuotaRepatoCxP")
  pagoNomina      PagoNomina?     @relation("PagoNominaCxP")
  // tipo extra para identificar origen en cobros-pagos
  esDeuda         Boolean  @default(false) // true si viene de PasivoDeuda
  esReparto       Boolean  @default(false) // true si viene de RepartoUtilidad
  esNomina        Boolean  @default(false) // true si viene de nómina de personal interno

  @@map("cuentas_pagar")
}

model AbonoPago {
  id              String      @id @default(cuid())
  cuentaPagarId   String
  cuentaPagar     CuentaPagar @relation(fields: [cuentaPagarId], references: [id], onDelete: Cascade)
  monto           Float
  fecha           DateTime
  metodoPago      String      @default("TRANSFERENCIA") // TRANSFERENCIA | EFECTIVO | TARJETA | CHEQUE
  notas           String?
  cuentaOrigenId  String?
  cuentaOrigen    CuentaBancaria? @relation(fields: [cuentaOrigenId], references: [id])
  movimientoId    String?     @unique
  movimiento      MovimientoFinanciero? @relation(fields: [movimientoId], references: [id], onDelete: SetNull)
  creadoPor       String?
  createdAt       DateTime    @default(now())

  cuotaPago       CuotaPago?

  @@map("abonos_pago")
}

// ─── PLAN DE CUOTAS ──────────────────────────────────────────────────────────

model CuotaPago {
  id              String      @id @default(cuid())
  cuentaPagarId   String
  cuentaPagar     CuentaPagar @relation(fields: [cuentaPagarId], references: [id], onDelete: Cascade)
  numeroCuota     Int         // 1, 2, 3...
  monto           Float
  fechaCompromiso DateTime
  estado          String      @default("PENDIENTE") // PENDIENTE | PAGADO
  abonoPagoId     String?     @unique
  abonoPago       AbonoPago?  @relation(fields: [abonoPagoId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("cuotas_pago")
}

model CuotaCobro {
  id               String       @id @default(cuid())
  cuentaCobrarId   String
  cuentaCobrar     CuentaCobrar @relation(fields: [cuentaCobrarId], references: [id], onDelete: Cascade)
  numeroCuota      Int
  monto            Float
  fechaCompromiso  DateTime
  estado           String       @default("PENDIENTE") // PENDIENTE | PAGADO
  abonoId          String?      @unique
  abono            Abono?       @relation(fields: [abonoId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("cuotas_cobro")
}

// ─── EVALUACIÓN ──────────────────────────────────────────────────────────────

model EvaluacionInterna {
  id                    String   @id @default(cuid())
  proyectoId            String   @unique
  proyecto              Proyecto @relation(fields: [proyectoId], references: [id])
  planeacionPrevia      Int?
  cumplimientoTecnico   Int?
  puntualidad           Int?
  resolucionOperativa   Int?
  desempenoPersonal     Int?
  comunicacionInterna   Int?
  comunicacionCliente   Int?
  usoEquipo             Int?
  rentabilidadReal      Int?
  resultadoGeneral      Int?
  promedioCalculado     Float?
  notas                 String?
  comentariosCriterios  String?  // JSON: {criterioKey: "texto"}
  reportePostEvento     String?  // JSON: [{area, problema, causa, solucion}]
  createdAt             DateTime @default(now())

  @@map("evaluaciones_internas")
}

// ─── EVALUACIÓN CLIENTE ──────────────────────────────────────────────────────

model EvaluacionCliente {
  id                        String    @id @default(cuid())
  proyectoId                String    @unique
  proyecto                  Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tokenAcceso               String    @unique @default(cuid())
  enviada                   Boolean   @default(false)
  respondida                Boolean   @default(false)
  // Criterios 1-10
  satisfaccionGeneral       Int?
  calidadServicio           Int?
  puntualidad               Int?
  atencionEquipo            Int?
  claridadComunicacion      Int?
  relacionCalidadPrecio     Int?
  // NPS 1-10
  probabilidadRecontratacion Int?
  // Texto libre
  loMejor                   String?
  loMejorable               String?
  comentarioAdicional       String?
  promedioCalculado         Float?
  createdAt                 DateTime  @default(now())
  respondidaEn              DateTime?

  @@map("evaluaciones_clientes")
}

// ─── VENTAS / COMISIONES ─────────────────────────────────────────────────────

model ConfigComisiones {
  id                   String   @id @default(cuid())
  // Metas ramp-up
  metaMes1             Float    @default(60000)
  metaMes2             Float    @default(80000)
  metaMes3             Float    @default(100000)
  metaMesNormal        Float    @default(150000)
  // Porcentajes comisión base
  pctClientePropio     Float    @default(10)   // 10% cliente propio
  pctPublicidad        Float    @default(5)    // 5% lead por publicidad
  pctAsignadoVendedor  Float    @default(5)    // 5% al vendedor que cierra (cliente asignado)
  pctAsignadoOrigen    Float    @default(5)    // 5% al vendedor original (cliente asignado)
  // Bono
  pctBono              Float    @default(3)    // 3% si alcanza el piso
  // Metas de prospección outbound
  metaProspectoDiaria  Int      @default(12)   // prospectos outbound mínimos por día
  updatedAt            DateTime @updatedAt

  @@map("config_comisiones")
}

model ComisionPago {
  id          String   @id @default(cuid())
  vendedorId  String
  vendedor    User     @relation(fields: [vendedorId], references: [id])
  mes         String   // "2026-04"
  montoTotal  Float
  notas       String?
  pagadoEn    DateTime @default(now())

  @@map("comision_pagos")
}

// ─── MANTENIMIENTO ───────────────────────────────────────────────────────────

model EquipoUnidad {
  id        String   @id @default(cuid())
  equipoId  String
  equipo    Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  codigo    String?  // Número de serie, tag, etiqueta, ej: "SN-12345" o "Unidad 1"
  estado    String   @default("ACTIVO") // ACTIVO | EN_MANTENIMIENTO | DADO_DE_BAJA
  voltaje   String?  // Voltaje de esta unidad ("110" | "220" | "AMBOS")
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  mantenimientos MantenimientoEquipo[]
  observaciones  UnidadObservacion[]

  @@map("equipo_unidades")
}

model UnidadObservacion {
  id          String       @id @default(cuid())
  unidadId    String
  unidad      EquipoUnidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  contenido   String
  creadoPorId String?
  creadoPor   User?        @relation("UnidadObservaciones", fields: [creadoPorId], references: [id])
  createdAt   DateTime     @default(now())

  @@map("unidad_observaciones")
}

model MantenimientoEquipo {
  id                   String        @id @default(cuid())
  equipoId             String
  equipo               Equipo        @relation(fields: [equipoId], references: [id])
  unidadId             String?
  unidad               EquipoUnidad? @relation(fields: [unidadId], references: [id])
  fecha                DateTime
  tipo                 String        // PREVENTIVO | CORRECTIVO | ESTETICO | FUNCIONAL
  accionRealizada      String
  estadoEquipo         String?
  comentarios          String?
  proximoMantenimiento DateTime?
  fotoEvidencia        String?       // base64 data URL
  costoReparacion      Float?        // Costo del servicio o reparación ($)
  descripcionReparacion String?      // Descripción adicional del gasto de reparación
  createdAt            DateTime      @default(now())

  @@map("mantenimientos_equipos")
}

// ─── RECURSOS HUMANOS ────────────────────────────────────────────────────────

// Puesto operativo: la columna ESTABLE del sistema (objetivo, responsabilidades
// permanentes, estructura de reporte y estándares). Espeja el Acuerdo de Alineación.
// El plan de trabajo (variable) cuelga de estas responsabilidades, no al revés.
model Puesto {
  id                String  @id @default(cuid())
  nombre            String
  area              String  @default("GENERAL") // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION | RRHH | GENERAL
  objetivoArea      String? @db.Text @map("objetivo_area")   // §4.1 objetivo del área
  misionPuesto      String? @db.Text @map("mision_puesto")   // propósito del rol
  responsabilidades String? @db.Text                          // JSON string[] — responsabilidades permanentes (§4.2)
  // Estructura de reporte (§4.3)
  reportaAId   String?  @map("reporta_a_id")
  reportaA     Puesto?  @relation("PuestoJerarquia", fields: [reportaAId], references: [id], onDelete: SetNull)
  subordinados Puesto[] @relation("PuestoJerarquia")
  coordinaCon  String?  @db.Text @map("coordina_con") // JSON string[]
  supervisaA   String?  @db.Text @map("supervisa_a")  // JSON string[]
  // Subárea del maestro (Áreas y organización). Ubica el puesto dentro de su área.
  subAreaId String?     @map("sub_area_id")
  subArea   PTSubArea?  @relation("PuestoSubArea", fields: [subAreaId], references: [id], onDelete: SetNull)
  // Estándares de desempeño (§6) — JSON: [{ subarea, responsabilidad, estandar }]
  estandares String? @db.Text
  // Condiciones laborales — fuente para el acuerdo laboral
  funciones    String? @db.Text                 // JSON string[] — funciones/actividades del puesto
  prestaciones String? @db.Text                 // JSON string[] — prestaciones/beneficios
  tipoContrato String? @map("tipo_contrato")    // Ej: "Indeterminado", "Determinado"
  modalidad    String?                          // Ej: "Presencial", "Híbrido", "Remoto"
  horario      String?                          // Ej: "L-V 9:00-18:00"
  // Presentación / organigrama
  color     String?
  posX      Float?   @map("pos_x") // posición X en el lienzo del organigrama
  posY      Float?   @map("pos_y") // posición Y en el lienzo del organigrama
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  ocupantes     PersonalInterno[] @relation("PuestoTitular")
  postulaciones Postulacion[]

  @@map("puestos")
}

model PersonalInterno {
  id             String    @id @default(cuid())
  nombre         String
  puesto         String    // Ej: "Bodega", "Coordinación Logística" (texto libre legado; ver puestoRef)
  departamento   String    @default("GENERAL") // BODEGA | COORDINACION | PRODUCCION | ADMINISTRACION | VENTAS | GENERAL
  tipo           String    @default("EMPLEADO") // EMPLEADO | FREELANCE_RECURRENTE
  telefono       String?
  correo         String?
  salario        Float?    // Mensual (empleado) o tarifa base (freelance recurrente)
  periodoPago    String    @default("MENSUAL") // MENSUAL | QUINCENAL | SEMANAL | POR_EVENTO
  fechaIngreso   DateTime?
  diasLaborables Int[]     @default([1, 2, 3, 4, 5]) // 0=Dom, 1=Lun, ..., 6=Sab
  activo         Boolean   @default(true)
  cuentaBancaria String?
  datosFiscales  String?
  notas          String?
  // Datos bancarios
  banco          String?
  clabe          String?   @map("clabe")
  numeroCuenta   String?   @map("numero_cuenta")
  numeroTarjeta  String?   @map("numero_tarjeta")
  // Datos personales
  ineUrl         String?   @map("ine_url")
  domicilio      String?
  // Contacto de emergencia
  emergenciaNombre String? @map("emergencia_nombre")
  emergenciaTel    String? @map("emergencia_tel")
  // Salud
  padecimientos  String?
  // Identidad fiscal y legal (México)
  rfc             String?
  curp            String?
  nss             String?   // Número de Seguridad Social (IMSS)
  fechaNacimiento DateTime? @map("fecha_nacimiento")
  estadoCivil     String?   @map("estado_civil")
  fotoUrl         String?   @map("foto_url")
  // Baja
  fechaBaja      DateTime? @map("fecha_baja")
  motivoBaja     String?   @map("motivo_baja") // RENUNCIA | DESPIDO | TERMINO_CONTRATO | ABANDONO | OTRO
  // Jerarquía interna: jefe directo (además del organigrama de puestos)
  jefeId         String?   @map("jefe_id")
  jefe           PersonalInterno?  @relation("PersonalJerarquia", fields: [jefeId], references: [id], onDelete: SetNull)
  subordinados   PersonalInterno[] @relation("PersonalJerarquia")
  // Puente de identidad: la MISMA persona que hace login y se mide en rendimiento
  userId         String?   @unique @map("user_id")
  usuario        User?     @relation("PersonalUsuario", fields: [userId], references: [id], onDelete: SetNull)
  // Puesto principal (para medición). El organigrama permite ocupar varios nodos.
  puestoId       String?   @map("puesto_id")
  puestoRef      Puesto?   @relation("PuestoTitular", fields: [puestoId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documentos    DocumentoPersonal[]
  docsLaborales DocumentoLaboral[]  @relation("PersonalDocsLaborales")
  pagos         PagoNomina[]
  asistencias   Asistencia[]
  incidencias   Incidencia[]
  actas         ActaAdministrativa[]
  evaluaciones  EvaluacionEmpleado[]
  vacaciones    SolicitudVacaciones[]
  encuestasSatisfaccion EncuestaSatisfaccionEquipo[]
  capacitaciones CapacitacionParticipante[]

  @@map("personal_interno")
}

// Solicitud de vacaciones. El saldo (derecho LFT por antigüedad − días tomados)
// se calcula en tiempo real desde fechaIngreso; aquí solo se registran los períodos.
model SolicitudVacaciones {
  id          String   @id @default(cuid())
  personalId  String   @map("personal_id")
  personal    PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  fechaInicio DateTime @map("fecha_inicio")
  fechaFin    DateTime @map("fecha_fin")
  dias        Float    // días hábiles solicitados
  estado      String   @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA | CANCELADA
  motivo      String?
  aprobadaPor String?  @map("aprobada_por")
  aprobadaEn  DateTime? @map("aprobada_en")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([personalId])
  @@map("solicitudes_vacaciones")
}

// Documento generado (oferta de trabajo / acuerdo laboral) con snapshot inmutable
// de los datos al momento de generarlo y acuse de recibo por token público.
model DocumentoLaboral {
  id             String   @id @default(cuid())
  personalId     String   @map("personal_id")
  personal       PersonalInterno @relation("PersonalDocsLaborales", fields: [personalId], references: [id], onDelete: Cascade)
  puestoId       String?  @map("puesto_id")
  tipo           String   // OFERTA | ACUERDO
  datos          String   @db.Text // JSON: snapshot de props del PDF al generar
  token          String   @unique
  aceptado       Boolean  @default(false)
  aceptadoNombre String?  @map("aceptado_nombre")
  aceptadoEn     DateTime? @map("aceptado_en")
  aceptadoIp     String?  @map("aceptado_ip")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  @@map("documentos_laborales")
}

// ─── POLÍTICAS Y NORMATIVA INTERNA ───────────────────────────────────────────

// Documento normativo editable y versionado dentro de la plataforma (reglamento,
// código de conducta, política de X). El contenido vive en markdown; cada
// publicación congela una versión y puede requerir acuse de recibo del equipo.
model Politica {
  id           String   @id @default(cuid())
  titulo       String
  categoria    String   @default("GENERAL") // GENERAL | CONDUCTA | OPERACION | SEGURIDAD | RRHH | GOBIERNO
  resumen      String?  @db.Text
  contenido    String   @db.Text // markdown de la versión de trabajo (borrador o publicada)
  version      Int      @default(1)
  estado       String   @default("BORRADOR") // BORRADOR | PUBLICADA | ARCHIVADA
  requiereAcuse Boolean @default(true) @map("requiere_acuse")
  orden        Int      @default(0)
  publicadaEn  DateTime? @map("publicada_en")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  versiones PoliticaVersion[]
  acuses    PoliticaAcuse[]

  @@map("politicas")
}

// Snapshot inmutable del contenido al momento de publicar una versión.
model PoliticaVersion {
  id          String   @id @default(cuid())
  politicaId  String   @map("politica_id")
  politica    Politica @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  version     Int
  titulo      String
  contenido   String   @db.Text
  nota        String?  // qué cambió en esta versión
  autorNombre String?  @map("autor_nombre")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([politicaId, version])
  @@map("politica_versiones")
}

// Acuse de recibo de una persona sobre una versión específica de una política.
model PoliticaAcuse {
  id             String   @id @default(cuid())
  politicaId     String   @map("politica_id")
  politica       Politica @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  version        Int
  personalId     String?  @map("personal_id")
  personalNombre String?  @map("personal_nombre")
  token          String   @unique
  aceptado       Boolean  @default(false)
  aceptadoNombre String?  @map("aceptado_nombre")
  aceptadoEn     DateTime? @map("aceptado_en")
  aceptadoIp     String?  @map("aceptado_ip")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("politica_acuses")
}

model DocumentoPersonal {
  id               String          @id @default(cuid())
  personalId       String
  personal         PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  tipo             String          // CONTRATO | IDENTIFICACION | CURP | RFC | COMPROBANTE_DOMICILIO | OTRO
  nombre           String
  url              String
  fechaVencimiento DateTime?
  createdAt        DateTime        @default(now())

  @@map("documentos_personal")
}

model PagoNomina {
  id             String               @id @default(cuid())
  personalId     String
  personal       PersonalInterno      @relation(fields: [personalId], references: [id])
  periodo        String               // "2026-04" o "2026-WXX"
  tipoPeriodo    String               @default("MENSUAL") // MENSUAL | QUINCENAL | SEMANAL | EVENTO
  monto          Float
  concepto       String?
  estado         String               @default("PENDIENTE") // PENDIENTE | PAGADO
  fechaPago      DateTime?
  metodoPago     String               @default("TRANSFERENCIA")
  cuentaOrigenId String?
  cuentaOrigen   CuentaBancaria?      @relation(fields: [cuentaOrigenId], references: [id])
  movimientoId   String?              @unique
  movimiento     MovimientoFinanciero? @relation(fields: [movimientoId], references: [id])
  cuentaPagarId  String?              @unique
  cuentaPagar    CuentaPagar?         @relation("PagoNominaCxP", fields: [cuentaPagarId], references: [id])
  notas          String?
  createdAt      DateTime             @default(now())

  @@map("pagos_nomina")
}

// ─── ASISTENCIA E INCIDENCIAS ────────────────────────────────────────────────

model Asistencia {
  id             String          @id @default(cuid())
  personalId     String
  personal       PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  fecha          DateTime
  estado         String          // PRESENTE | FALTA | RETARDO | PERMISO | VACACIONES | INCAPACIDAD
  minutosRetardo Int?
  horaEntrada    String?
  horaSalida     String?
  notas          String?
  justificada    Boolean         @default(false) @map("justificada")
  documentoUrl   String?         @map("documento_url")
  createdAt      DateTime        @default(now())

  @@unique([personalId, fecha])
  @@map("asistencias")
}

// Configuración única (singleton) de las reglas de asistencia y penalización.
model ConfigAsistencia {
  id               String   @id @default("singleton")
  horaEntrada      String   @default("09:00") @map("hora_entrada")
  toleranciaMin    Int      @default(10)  @map("tolerancia_min")       // minutos de gracia antes de retardo
  retardoMaxMin    Int      @default(30)  @map("retardo_max_min")      // pasado esto ya se considera falta
  retardosPorFalta Int      @default(3)   @map("retardos_por_falta")   // N retardos acumulados = 1 falta
  descuentaRetardo Boolean  @default(true) @map("descuenta_retardo")   // los retardos acumulados generan falta descontable
  descuentaFalta   Boolean  @default(true) @map("descuenta_falta")     // la falta injustificada descuenta el día no laborado
  requiereDocFalta Boolean  @default(true) @map("requiere_doc_falta")  // sin documento, la falta es injustificada
  faltasCausalBaja Int      @default(3)   @map("faltas_causal_baja")   // faltas injustificadas en 30 días (art. 47 LFT, informativo)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("config_asistencia")
}

model TipoIncidencia {
  id          String  @id @default(cuid())
  codigo      String? @unique // código estable del catálogo semilla (FL-ORDEN, FG-GASTO, FMG-CONFID…)
  nombre      String
  categoria   String  // ASISTENCIA | CONDUCTA | OPERACION | DESEMPEÑO | RECONOCIMIENTO
  gravedad    String  @default("LEVE") // LEVE | GRAVE | MUY_GRAVE (N/A para RECONOCIMIENTO)
  deteccion   String  @default("MANUAL") // MANUAL | AUTO (AUTO = derivada de asistencia/plan de trabajo)
  calculoTipo String  @default("SIN_DESCUENTO") // FIJO | PORCENTAJE_DIA | PORCENTAJE_HORA | SIN_DESCUENTO
  valor       Float   @default(0)
  esDescuento Boolean @default(true)
  descripcion String?
  activo      Boolean @default(true)

  incidencias Incidencia[]
  actas       ActaAdministrativa[]

  @@map("tipos_incidencia")
}

// Acta administrativa: formaliza una falta contra una persona con hechos, evidencia,
// descargo del colaborador, nivel de escalón (reincidencia) y consecuencia aplicada.
// Cuenta para el escalón 1ra→2da→3ra del Reglamento Interno y, si la consecuencia
// es económica, se liga a una Incidencia (el descuento) para que impacte nómina.
model ActaAdministrativa {
  id             String           @id @default(cuid())
  folio          String           @unique // ACTA-2026-0001
  // Rama del acta: INTERNA (empleado, temas laborales) | EVENTO (técnico/staff de un evento).
  ambito         String           @default("INTERNA")
  personalId     String?          @map("personal_id")
  personal       PersonalInterno? @relation(fields: [personalId], references: [id], onDelete: Cascade)
  // Snapshot del nombre: permite levantar acta de evento a freelance sin ficha interna.
  personaNombre  String?          @map("persona_nombre")
  // Proyecto de evento del que deriva un acta de EVENTO (nulo en actas internas).
  proyectoId     String?          @map("proyecto_id")
  proyecto       Proyecto?        @relation("ActaEventoProyecto", fields: [proyectoId], references: [id], onDelete: SetNull)
  tipoId         String?          @map("tipo_id")
  tipo           TipoIncidencia?  @relation(fields: [tipoId], references: [id], onDelete: SetNull)
  puestoId       String?          @map("puesto_id")
  gravedad       String           @default("LEVE") // snapshot de la gravedad al levantar el acta
  fecha          DateTime
  hechos         String          @db.Text // descripción objetiva de lo ocurrido
  evidenciaUrl   String?         @map("evidencia_url")
  nivelEscalon   Int             @default(1) @map("nivel_escalon") // 1ra, 2da, 3ra reincidencia
  consecuencia   String          @db.Text // acción tomada (sugerida por la matriz, editable)
  montoDescuento Float?          @map("monto_descuento")
  incidenciaId   String?         @unique @map("incidencia_id") // Incidencia ligada si hay descuento
  descargo       String?         @db.Text // versión / descargo del colaborador
  levantadaPor   String?         @map("levantada_por")
  estado         String          @default("ABIERTA") // ABIERTA | NOTIFICADA | ACEPTADA | ANULADA
  token          String          @unique // acuse/firma del colaborador por enlace
  aceptada       Boolean         @default(false)
  aceptadaNombre String?         @map("aceptada_nombre")
  aceptadaEn     DateTime?       @map("aceptada_en")
  aceptadaIp     String?         @map("aceptada_ip")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([personalId])
  @@index([proyectoId])
  @@map("actas_administrativas")
}

model Incidencia {
  id             String          @id @default(cuid())
  personalId     String
  personal       PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  tipoId         String
  tipo           TipoIncidencia  @relation(fields: [tipoId], references: [id])
  fecha          DateTime
  descripcion    String?
  montoCalculado Float?
  periodoNomina  String?         // "2026-04"
  estado         String          @default("PROPUESTA") @map("estado") // PROPUESTA | APROBADA | RECHAZADA
  origen         String          @default("MANUAL") @map("origen")     // MANUAL | AUTO
  evidenciaUrl   String?         @map("evidencia_url")
  aprobadaPor    String?         @map("aprobada_por")
  aprobadaEn     DateTime?       @map("aprobada_en")
  aplicada       Boolean         @default(false)
  notificada     Boolean         @default(false)
  createdAt      DateTime        @default(now())

  @@map("incidencias")
}

model EvaluacionEmpleado {
  id           String          @id @default(cuid())
  personalId   String
  personal     PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  periodo      String
  evaluador    String?
  fecha        DateTime        @default(now())

  puntualidad      Int @default(0)
  ordenLimpieza    Int @default(0)
  actitud          Int @default(0)
  comunicacion     Int @default(0)
  resolucionProb   Int @default(0)
  propuestasMejora Int @default(0)
  calidadTrabajo   Int @default(0)
  trabajoEquipo    Int @default(0)

  aspectosPositivos String?
  areasMejora       String?
  incidentesNota    String?
  observaciones     String?

  // Snapshot de los estándares del puesto evaluados: [{ subarea, responsabilidad, estandar, puntaje }]
  criterios         String? @db.Text

  // Acuerdos / compromisos con seguimiento mes a mes: [{ texto, estado, nota }]
  acuerdos          String? @db.Text

  // Objetivos SMART del período: [{ texto, resultado, comentario, evidencias: string[] }]
  objetivos         String? @db.Text
  // Comentarios por competencia general: { puntualidad, ordenLimpieza, ... }
  competenciaNotas  String? @db.Text
  // Calificación final nombrada: EXCEDE | CUMPLE | EN_DESARROLLO | NO_CUMPLE
  calificacionFinal String?

  // Autoevaluación (180°) que el colaborador llena por enlace público con token
  autoToken     String?   @unique
  autoEstado    String    @default("PENDIENTE") // PENDIENTE | ENVIADA
  autoData      String?   @db.Text // snapshot de su autocalificación + comentarios
  autoEnviadaEn DateTime?

  // Acuse de firma del colaborador sobre la evaluación cerrada
  firmada       Boolean   @default(false)
  firmadaEn     DateTime?
  firmadaNombre String?

  puntajeGeneral Float? // promedio de competencias generales (0-5)
  puntajePuesto  Float? // promedio de estándares del puesto (0-5)
  puntajeTotal   Float? // ponderado: 40% general + 60% puesto (o el único disponible)
  estado       String   @default("BORRADOR") // BORRADOR | COMPLETADA
  createdAt    DateTime @default(now())

  @@map("evaluaciones_empleado")
}

// ─── BODEGA ──────────────────────────────────────────────────────────────────

model ItemTemplateBodega {
  id          String  @id @default(cuid())
  descripcion String
  categoria   String  @default("GENERAL") // AUDIO | ILUMINACION | VIDEO | CABLES | HERRAMIENTAS | TRANSPORTES | GENERAL
  orden       Int     @default(0)
  activo      Boolean @default(true)

  @@map("items_template_bodega")
}

model ChecklistBodega {
  id          String    @id @default(cuid())
  semana      String    // "2026-W15" (ISO año + semana)
  fechaInicio DateTime
  estado      String    @default("EN_PROGRESO") // EN_PROGRESO | COMPLETADO | CON_ALERTAS
  notas       String?
  creadoPor   String?
  cerradoEn   DateTime?
  createdAt   DateTime  @default(now())

  items ChecklistBodegaItem[]

  @@unique([semana])
  @@map("checklist_bodega")
}

model ChecklistBodegaItem {
  id                String          @id @default(cuid())
  checklistId       String
  checklist         ChecklistBodega @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  descripcion       String
  categoria         String          @default("GENERAL")
  estado            String          @default("PENDIENTE") // PENDIENTE | EN_BODEGA | EN_RENTA_O_USO | EXTRAVIADO | PERDIDO
  notas             String?
  equipoId          String?
  equipo            Equipo?         @relation(fields: [equipoId], references: [id])
  orden             Int             @default(0)
  cantidadEsperada  Int?
  cantidadContada   Int?

  @@map("checklist_bodega_items")
}

// ─── MARKETING ───────────────────────────────────────────────────────────────

model TipoContenido {
  id           String  @id @default(cuid())
  nombre       String
  formato      String  @default("POST") // POST | REEL | STORIE | TIK_TOK
  objetivo     String?
  diaSemana    String? // Día(s) separados por coma, ej: "LUNES,VIERNES"
  semanaDelMes Int?    // 1=primer, 2=segundo, 3=tercer, 4=cuarto (para publicaciones 1x/mes en día específico)
  recurrencia  String?
  cantMes      Int?
  descripcion  String?
  activo       Boolean @default(true)
  orden        Int     @default(0)
  enFacebook   Boolean @default(false)
  enInstagram  Boolean @default(false)
  enTiktok     Boolean @default(false)
  enYoutube    Boolean @default(false)
  enFeedIG     Boolean @default(false) // Aparece en previsualización Feed IG

  publicaciones Publicacion[]

  @@map("tipos_contenido")
}

model Publicacion {
  id             String         @id @default(cuid())
  fecha          DateTime
  tipoId         String?
  tipo           TipoContenido? @relation(fields: [tipoId], references: [id])
  formato        String?
  objetivo       String?
  descripcion    String?
  copy           String?
  enFacebook     Boolean        @default(false)
  enInstagram    Boolean        @default(false)
  enTiktok       Boolean        @default(false)
  enYoutube      Boolean        @default(false)
  materialLink   String?
  portadaUrl     String?        // URL de imagen de portada opción A (feed IG)
  portadaUrlB    String?        // URL de imagen de portada opción B (A/B test)
  colaboradores  String?
  estado         String         @default("PENDIENTE")
  comentarios    String?
  alcance        Int?
  impresiones    Int?
  interacciones  Int?
  seguidoresGanados Int?
  pruebaPubUrl   String?        // URL del archivo de prueba de publicación (apelación)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("publicaciones")
}

// ─── DISEÑOS GUARDADOS (módulo de diseño) ────────────────────────────────────
// Instancia de un diseño (plantilla del registro) aplicado a un proyecto, con
// ediciones manuales del usuario (texto y fotos) guardadas como overrides.
// Genérico: sirve para brief-técnico y toda plantilla futura. Los overrides son
// { texto: { "ruta.al.campo": valor }, fotos: { "slideId": url } }.
model DisenoGuardado {
  id            String   @id @default(cuid())
  template      String   // id de la plantilla en el registro (ej. "brief-tecnico")
  proyectoId    String?  // evento fuente (null = muestra)
  titulo        String   // etiqueta legible (normalmente el nombre del evento)
  overrides     Json     @default("{}")
  estado        String   @default("BORRADOR") // BORRADOR | GUARDADO
  publicacionId String?  // si ya se calendarizó, la Publicacion creada
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([template])
  @@index([proyectoId])
  @@map("disenos_guardados")
}

// ─── ENCUESTA SATISFACCIÓN EQUIPO ────────────────────────────────────────────
// Los empleados/freelancers responden cómo perciben trabajar en Mainstage

model EncuestaSatisfaccionEquipo {
  id          String    @id @default(cuid())
  personalId  String
  personal    PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  periodo     String    // ej. "Q1-2026" o "2026-05"
  token       String    @unique @default(cuid())
  enviada     Boolean   @default(false)
  respondida  Boolean   @default(false)
  respondidaEn DateTime?

  // Criterios 1-10
  claridadInstrucciones  Int?  // ¿Las instrucciones de trabajo son claras?
  pagosPuntuales         Int?  // ¿Los pagos son puntuales?
  tratoJusto             Int?  // ¿Sientes que te tratan de forma justa?
  organizacion           Int?  // ¿Mainstage está bien organizada?
  comunicacion           Int?  // ¿La comunicación contigo es fluida?
  herramientas           Int?  // ¿Tienes los equipos/herramientas que necesitas?
  crecimiento            Int?  // ¿Sientes que puedes crecer aquí?
  ambiente               Int?  // ¿Cómo es el ambiente de trabajo?

  // NPS 0-10
  probabilidadRecomendar Int?  // ¿Recomendarías trabajar en Mainstage?

  // Texto libre
  loMejor         String?  // ¿Qué es lo que más valoras de trabajar en Mainstage?
  loMejorable     String?  // ¿Qué cambiarías?
  comentarios     String?

  // Respuestas del cuestionario extendido (ver src/lib/satisfaccion-form.ts).
  // Mapa { preguntaId: number | string | string[] }. Reemplaza los campos fijos de arriba.
  respuestas      Json?

  promedioCalculado Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([personalId, periodo])
  @@map("encuestas_satisfaccion_equipo")
}

// Capacitaciones del equipo
model Capacitacion {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  area        String   @default("GENERAL") // área responsable
  tipo        String   @default("TECNICA") // TECNICA | SEGURIDAD | PROCEDIMIENTOS | DESARROLLO | INDUCCION
  modalidad   String   @default("PRESENCIAL") // PRESENCIAL | VIRTUAL | AUTOAPRENDIZAJE
  fechaInicio DateTime
  fechaFin    DateTime?
  duracionHrs Float?
  instructor  String?
  material    String?  // URL o descripción del material
  estado      String   @default("PROGRAMADA") // PROGRAMADA | EN_CURSO | COMPLETADA | CANCELADA
  obligatoria Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participantes CapacitacionParticipante[]
  @@map("capacitaciones")
}

model CapacitacionParticipante {
  id              String       @id @default(cuid())
  capacitacionId  String
  capacitacion    Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  personalId      String
  personal        PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  asistio         Boolean      @default(false)
  calificacion    Float?
  notas           String?
  createdAt       DateTime     @default(now())

  @@unique([capacitacionId, personalId])
  @@map("capacitacion_participantes")
}

// ─── CONFIGURACIÓN DE LA APP ─────────────────────────────────────────────────

model AppConfig {
  id           String  @id @default(cuid())
  key          String  @unique
  value        String
  section      String  @default("general")
  label        String  @default("")
  description  String?
  type         String  @default("text")
  defaultValue String?
  orden        Int     @default(0)
  @@map("app_config")
}

model ModuloAcceso {
  id        String   @id @default(cuid())
  moduloKey String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([moduloKey, userId])
  @@map("modulo_accesos")
}

// ─── PLANTILLAS DE EQUIPO (sugerencias por tipo evento/servicio/capacidad) ───

model PlantillaEquipo {
  id           String   @id @default(cuid())
  nombre       String
  tipoServicio String   @default("TODOS") // PRODUCCION_TECNICA | RENTA | TODOS
  tipoEvento   String   @default("TODOS") // MUSICAL | SOCIAL | EMPRESARIAL | OTRO | TODOS
  capacidadMin Int      @default(0)
  capacidadMax Int      @default(9999)
  descripcion  String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  items        PlantillaEquipoItem[]
  @@map("plantillas_equipo")
}

model PlantillaEquipoItem {
  id          String          @id @default(cuid())
  plantillaId String
  plantilla   PlantillaEquipo @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  equipoId    String?
  equipo      Equipo?         @relation(fields: [equipoId], references: [id])
  descripcion String
  cantidad    Int             @default(1)
  esOpcional  Boolean         @default(false)
  orden       Int             @default(0)
  notas       String?
  @@map("plantillas_equipo_items")
}

// ─── VEHÍCULOS Y MANTENIMIENTO ───────────────────────────────────────────────

model Vehiculo {
  id                   String    @id @default(cuid())
  nombre               String    // Nombre identificador Ej. "Sprinter Negra"
  marca                String?
  modelo               String?
  anio                 Int?
  placas               String?
  color                String?
  kilometraje          Int?      // Km actuales del odómetro
  proximoServicioKm    Int?      // Km en que toca el próximo servicio
  proximoServicioFecha DateTime? // Fecha del próximo servicio programado
  activo               Boolean   @default(true)
  notas                String?
  fotos                String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  mantenimientos       MantenimientoVehiculo[]
  @@map("vehiculos")
}

model MantenimientoVehiculo {
  id             String    @id @default(cuid())
  vehiculoId     String
  vehiculo       Vehiculo  @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  fecha          DateTime
  km             Int?      // Km al momento del registro
  tipoRegistro   String    // SERVICIO | REPARACION | REVISION | ACCIDENTE | OTRO
  servicio       String    // Descripción del trabajo realizado
  aceite         String?   // Tipo/número de aceite utilizado
  anticongelante String?   // Tipo/número de anticongelante
  estadoLlantas  String?   // Descripción del estado de llantas
  proximoKm      Int?      // Km para el próximo servicio
  proximaFecha   DateTime? // Fecha para el próximo servicio
  prioridad      String    @default("NORMAL") // BAJA | NORMAL | ALTA | URGENTE
  estatus        String    @default("COMPLETADO") // PENDIENTE | EN_PROCESO | COMPLETADO
  costo          Float?
  comentarios    String?
  fotos          String[]  @default([])
  createdAt      DateTime  @default(now())
  @@map("mantenimiento_vehiculos")
}

// ─── OPERACIONES ─────────────────────────────────────────────────────────────

model IniciativaExterna {
  id          String    @id @default(cuid())
  nombre      String
  descripcion String?
  area        String    @default("GENERAL") // VENTAS | ADMINISTRACION | PRODUCCION | MARKETING | RRHH | GENERAL
  estado      String    @default("ACTIVA")  // ACTIVA | COMPLETADA | ARCHIVADA
  color       String?
  creadoPorId String?
  creadoPor   User?     @relation("IniciativasCreadas", fields: [creadoPorId], references: [id])
  fechaInicio DateTime?
  fechaFin    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tareas Tarea[]

  @@map("iniciativas_externas")
}

model Tarea {
  id               String             @id @default(cuid())
  titulo           String
  descripcion      String?
  prioridad        String             @default("MEDIA")    // URGENTE | ALTA | MEDIA | BAJA
  area             String             @default("GENERAL")  // VENTAS | ADMINISTRACION | PRODUCCION | MARKETING | RRHH | GENERAL
  estado           String             @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | CANCELADA
  asignadoAId      String?
  asignadoA        User?              @relation("TareasAsignadas",  fields: [asignadoAId], references: [id])
  creadoPorId      String?
  creadoPor        User?              @relation("TareasCreadoPor",  fields: [creadoPorId], references: [id])
  iniciativaId     String?
  iniciativa       IniciativaExterna? @relation(fields: [iniciativaId], references: [id], onDelete: SetNull)
  // ── Hierarchy ──────────────────────────────────────────────────────────────
  carpetaId        String?
  carpeta          TareaCarpeta?      @relation(fields: [carpetaId], references: [id], onDelete: SetNull)
  proyectoTareaId  String?
  proyectoTarea    TareaProyecto?     @relation(fields: [proyectoTareaId], references: [id], onDelete: SetNull)
  seccionId        String?
  seccion          TareaSeccion?      @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  parentId         String?
  parent           Tarea?             @relation("TareaSubtareas", fields: [parentId], references: [id], onDelete: Cascade)
  subtareas        Tarea[]            @relation("TareaSubtareas")
  // ── Proyecto Evento ──────────────────────────────────────────────────────────
  proyectoEventoId String?
  proyectoEvento   Proyecto?          @relation("TareasDeProyecto", fields: [proyectoEventoId], references: [id], onDelete: SetNull)
  // ── Trato (venta) ────────────────────────────────────────────────────────────
  tratoId          String?
  trato            Trato?             @relation("TareasDeTrato", fields: [tratoId], references: [id], onDelete: SetNull)
  // ── Cliente (atención específica: recurrencia de eventos, cumpleaños, fechas especiales) ──
  clienteId        String?
  cliente          Cliente?           @relation("TareasDeCliente", fields: [clienteId], references: [id], onDelete: SetNull)
  // ── Scheduling ──────────────────────────────────────────────────────────────
  fecha            DateTime?  // When to work on it (shows in Hoy)
  fechaVencimiento DateTime?
  fechaCompletada  DateTime?
  recurrencia      String?    // JSON: RecurrenciaConfig
  orden            Int        @default(0)
  // ── Content ──────────────────────────────────────────────────────────────
  notas            String?
  etiquetas        String?    // JSON string[]
  // ── Origen ───────────────────────────────────────────────────────────────
  juntaOrigenId    String?
  juntaOrigen      Junta?             @relation("JuntaOrigen", fields: [juntaOrigenId], references: [id], onDelete: SetNull)
  // ── Plan de trabajo ───────────────────────────────────────────────────────
  // origenPlan: marca de tarea de plan (aún usada por rendimiento/evaluaciones).
  // El modelo v1 PlanTrabajoActividad quedó retirado; su tabla se conserva como archivo.
  origenPlan        Boolean  @default(false)
  // ── Proyecto interno ─────────────────────────────────────────────────────
  proyectoInternoId String?
  proyectoInterno   ProyectoInterno? @relation("TareasDeProyectoInterno", fields: [proyectoInternoId], references: [id], onDelete: SetNull)
  faseInternaId     String?
  faseInterna       FaseProyectoInterno? @relation("TareasDeFase", fields: [faseInternaId], references: [id], onDelete: SetNull)
  esSeguimiento     Boolean  @default(false)   // seguimiento agendado de un proyecto interno
  // ── Capa aditiva: hub de ejecución ────────────────────────────────────────
  tipoOrigen         String   @default("TAREA")           // TAREA | PLAN | PROYECTO | EVENTO | TRATO
  requiereEvidencia  Boolean  @default(false)
  tipoEvidencia      String?                              // FOTO | ARCHIVO | ENLACE_MODULO | NOTA
  evidenciaNota      String?  @db.Text
  estadoVerificacion String   @default("NO_REQUIERE")     // NO_REQUIERE | PENDIENTE_VERIFICACION | VERIFICADA | RECHAZADA
  verificadaPorId    String?
  verificadaPor      User?    @relation("TareasVerificadas", fields: [verificadaPorId], references: [id], onDelete: SetNull)
  verificadaAt       DateTime?
  motivoRechazo      String?  @db.Text
  // ── No realizada: la tarea no se hizo, con motivo justificado ──
  noRealizada           Boolean @default(false)
  motivoNoRealizada     String?                              // NO_NECESARIA | NO_SUPE | NO_CLARA | OTRO
  justificacionNoRealizada String? @db.Text
  // ── Historial de evidencias de ocurrencias pasadas (tareas recurrentes) ──
  // JSON: EvidenciaHistorialEntry[] — snapshot de la evidencia al completar cada
  // ocurrencia, para que la siguiente recurrencia arranque con evidencia fresca.
  evidenciasHistorial   String? @db.Text
  porqueSeHace       String?  @db.Text
  estandarMinimo     String?  @db.Text
  siNoSeHace         String?  @db.Text
  cuando             String?                              // texto ej: "Cada lunes antes de 10:30"
  moduloDestino      String?
  moduloTexto        String?
  moduloDisponible   Boolean  @default(true)
  esAccionCampo      Boolean  @default(false)
  ptTemplateId       String?
  ptTemplate         PTTareaTemplate? @relation("TareasDeTemplate", fields: [ptTemplateId], references: [id], onDelete: SetNull)
  // ── Envío de evidencia (WhatsApp) — precondición para verificar ──
  evidenciaEnviadaAt    DateTime?
  evidenciaEnviadaPorId String?
  evidenciaEnviadaCanal String?                              // WHATSAPP | ...
  // ── Bandeja de entrada: la tarea se movió al inbox de Gestión Operativa
  // (se oculta de Operaciones y se agrupa por `area` en la bandeja). ──
  enBandeja        Boolean    @default(false)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  comentarios      TareaComentario[]
  archivos         TareaArchivo[]
  colaboradores    TareaColaborador[]

  @@index([tipoOrigen, estado])
  @@index([estadoVerificacion])
  @@index([asignadoAId, fecha])
  @@index([ptTemplateId])
  @@index([tratoId])
  @@index([clienteId])
  @@map("tareas")
}

model TareaColaborador {
  tareaId   String
  usuarioId String
  tarea     Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tareaId, usuarioId])
  @@index([usuarioId])
  @@map("tarea_colaboradores")
}

model TareaCarpeta {
  id          String          @id @default(cuid())
  nombre      String
  color       String?
  icono       String?
  orden       Int             @default(0)
  creadoPorId String?
  creadoPor   User?           @relation("CarpetasCreadas", fields: [creadoPorId], references: [id])
  proyectos   TareaProyecto[]
  tareas      Tarea[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("tarea_carpetas")
}

model TareaProyecto {
  id          String         @id @default(cuid())
  nombre      String
  descripcion String?
  color       String?
  icono       String?
  orden       Int            @default(0)
  archivado   Boolean        @default(false)
  carpetaId   String?
  carpeta     TareaCarpeta?  @relation(fields: [carpetaId], references: [id], onDelete: SetNull)
  creadoPorId String?
  creadoPor   User?          @relation("ProyectosTareaCreados", fields: [creadoPorId], references: [id])
  secciones   TareaSeccion[]
  tareas      Tarea[]
  accesos     ProyectoAcceso[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("tarea_proyectos")
}

model TareaSeccion {
  id         String        @id @default(cuid())
  nombre     String
  descripcion String?      @db.Text   // objetivo/subtítulo editable de la sección
  orden      Int           @default(0)
  colapsada  Boolean       @default(false)
  tipoModulo String        @default("TAREA")   // TAREA | PLAN — sub-módulo del hub al que pertenece
  proyectoId String
  proyecto   TareaProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  subAreaId  String?       // vínculo al maestro de subáreas (Áreas y organización); el maestro gobierna el nombre visible
  subArea    PTSubArea?    @relation("SeccionSubArea", fields: [subAreaId], references: [id], onDelete: SetNull)
  tareas     Tarea[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("tarea_secciones")
}

model TareaComentario {
  id        String   @id @default(cuid())
  contenido String
  tareaId   String
  tarea     Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  autorId   String?
  autor     User?    @relation("ComentariosTarea", fields: [autorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tarea_comentarios")
}

// ─── GASTOS OPERATIVOS ───────────────────────────────────────────────────────
// Efectivo que coordinación necesita antes del evento: comidas, transporte, hospedaje.
// Se jalan de las líneas de cotización y admin marca si ya se entregó el dinero.
model GastoOperativo {
  id          String   @id @default(cuid())
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tipo        String   // COMIDA | TRANSPORTE | HOSPEDAJE | OTRO
  concepto    String
  monto       Float
  cantidad    Int      @default(1)
  // Estado de entrega del efectivo a coordinación
  entregado   Boolean  @default(false)
  fechaEntrega DateTime?
  notas       String?
  createdAt   DateTime @default(now())

  @@map("gastos_operativos")
}

model TareaArchivo {
  id          String   @id @default(cuid())
  nombre      String
  url         String
  tipo        String?  // MIME type or category
  tamano      Int?     // bytes
  tareaId     String
  tarea       Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  subidoPorId String?
  subidoPor   User?    @relation("ArchivosTarea", fields: [subidoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@map("tarea_archivos")
}

// ─── TALENTO / ATS ───────────────────────────────────────────────────────────

model Candidato {
  id       String  @id @default(cuid())
  nombre   String
  correo   String?
  telefono String?
  ciudad   String?
  edad     Int?
  nivelEstudios String? @map("nivel_estudios")
  carrera  String?

  // Discovery form
  experienciaEventos      String?  @map("experiencia_eventos")
  aniosExperienciaEventos Int?     @map("anios_experiencia_eventos")
  eventoDestacado         String?  @map("evento_destacado")
  situacionResuelta       String?  @map("situacion_resuelta")
  comoResolveria          String?  @map("como_resolveria")
  motivacion              String?
  visionLargoPlazo        String?  @map("vision_largo_plazo")
  disposicionHorario      Boolean? @map("disposicion_horario")
  disposicionFines        Boolean? @map("disposicion_fines")
  salarioEsperado         Float?   @map("salario_esperado")
  habilidades             String?
  experienciaPrevia       String?  @map("experiencia_previa")
  linkedin                String?
  portfolio               String?
  notas                   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  postulaciones Postulacion[]

  @@map("candidatos")
}

model Postulacion {
  id          String  @id @default(cuid())
  candidatoId String  @map("candidato_id")
  candidato   Candidato   @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  puestoId    String? @map("puesto_id")
  puesto      Puesto? @relation(fields: [puestoId], references: [id])

  // Puesto manual si no hay puesto operativo vinculado
  puestoManual String? @map("puesto_manual")
  areaManual   String? @map("area_manual")

  // Pipeline
  etapa String @default("NUEVO") // NUEVO | EVALUACION | PROPUESTA_ENVIADA | APROBADO | CONTRATADO | RECHAZADO

  // Propuesta de trabajo
  salarioPropuesto     Float?    @map("salario_propuesto")
  fechaIngresoEstimada DateTime? @map("fecha_ingreso_estimada")
  beneficios           String?   // JSON array
  observaciones        String?
  propuestaToken       String?   @unique @map("propuesta_token")
  propuestaAceptada    Boolean?  @map("propuesta_aceptada")
  propuestaFechaEnvio  DateTime? @map("propuesta_fecha_envio")

  // Contrato
  contratoGenerado Boolean  @default(false) @map("contrato_generado")
  contratoFecha    DateTime? @map("contrato_fecha")

  // Link al PersonalInterno creado al contratar
  personalInternoId String? @map("personal_interno_id")

  // Evaluación vs perfil
  notasEvaluacion String? @map("notas_evaluacion")
  puntajeTotal    Float?  @map("puntaje_total")

  // Onboarding checklist (JSON: [{id,label,done,fecha}])
  onboardingData  String?

  onboardingPlan  OnboardingPlan?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("postulaciones")
}

// ─── ONBOARDING ───────────────────────────────────────────────────────────────

model OnboardingPlan {
  id             String   @id @default(cuid())
  nombre         String
  puesto         String
  area           String?
  fechaIngreso   DateTime? @map("fecha_ingreso")
  estado         String   @default("EN_CURSO") // EN_CURSO | COMPLETADO | PAUSADO | CANCELADO
  notas          String?
  postulacionId  String?  @unique @map("postulacion_id")
  postulacion    Postulacion? @relation(fields: [postulacionId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")
  modulos        OnboardingModulo[]

  @@map("onboarding_planes")
}

model OnboardingModulo {
  id           String   @id @default(cuid())
  planId       String   @map("plan_id")
  plan         OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  nombre       String
  descripcion  String?
  tipo         String   @default("ALINEACION") // ALINEACION | TECNICO | ADMINISTRATIVO | CULTURAL | PRACTICO
  orden        Int      @default(0)
  duracionDias Int?     @map("duracion_dias")
  completado   Boolean  @default(false)
  tareas       OnboardingTarea[]

  @@map("onboarding_modulos")
}

model OnboardingTarea {
  id           String    @id @default(cuid())
  moduloId     String    @map("modulo_id")
  modulo       OnboardingModulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  titulo       String
  descripcion  String?
  tipo         String    @default("LECTURA") // LECTURA | VIDEO | PRACTICA | EVALUACION | REUNION | SHADOWING
  orden        Int       @default(0)
  completada   Boolean   @default(false)
  completadaEn DateTime? @map("completada_en")
  recurso      String?
  notas        String?

  @@map("onboarding_tareas")
}

// ─── CAMPAÑAS ─────────────────────────────────────────────────────────────────

model TipoCampana {
  id                  String   @id @default(cuid())
  nombre              String
  objetivo            String   @default("INFORMATIVO")  // INFORMATIVO | VENTA | ENTRETENIMIENTO | POSICIONAMIENTO
  objetivoMeta        String   @default("RECONOCIMIENTO") // RECONOCIMIENTO | TRAFICO | INTERACCION | LEADS | VENTAS
  formato             String   @default("VIDEO")         // IMAGEN | VIDEO | CARRUSEL | REEL | HISTORIA | COLECCION
  recurrencia         String   @default("MENSUAL")       // MENSUAL | QUINCENAL | SEMANAL
  canal               String   @default("META")
  duracionDias        Int      @default(14)
  presupuestoEstimado Float?
  publicoEdadMin      Int      @default(25)
  publicoEdadMax      Int      @default(55)
  publicoGenero       String   @default("TODOS")         // TODOS | HOMBRES | MUJERES
  ubicaciones         String   @default("FEED_IG,REELS_IG,STORIES_IG")
  cta                 String   @default("MAS_INFORMACION")
  copyReferencia      String?
  pixelEvento         String?
  descripcion         String?
  grupo               String?  // Sub-sección libre: "Servicios generales", "Tipo de servicio", "Tipo de evento", etc.
  color               String   @default("#B3985B")
  categoria           String   @default("base")         // base | eventual
  vigenciaDesde       DateTime?                          // solo eventual
  vigenciaHasta       DateTime?                          // solo eventual
  briefTemplate       String?                            // JSON: plantilla default del brief
  activo              Boolean  @default(true)
  orden               Int      @default(0)
  createdAt           DateTime @default(now())

  ejecuciones         EjecucionCampana[]

  @@map("tipos_campana")
}

model EjecucionCampana {
  id             String       @id @default(cuid())
  tipoId         String?
  tipo           TipoCampana? @relation(fields: [tipoId], references: [id])
  nombre         String
  objetivo       String?
  canal          String?
  color          String?
  fechaInicio    DateTime
  fechaFin       DateTime
  estado         String       @default("PLANIFICADA") // PLANIFICADA | EN_EJECUCION | COMPLETADA | CANCELADA
  brief          String?      // JSON: clon editable de TipoCampana.briefTemplate
  briefCompleto  Boolean      @default(false) // lo define el checklist de lanzamiento del brief
  presupuesto    Float?
  notas          String?
  mes            String       // YYYY-MM
  idMetaAds      String?
  audiencia      String?      // segmentación heredada de la plantilla, editable
  ubicaciones    String?      // CSV de ubicaciones (FEED_IG, REELS_IG, ...)
  // KPIs planos legacy: se conservan pero el sistema nuevo usa resultados[] por periodo.
  alcance        Int?
  impresiones    Int?
  clics          Int?
  ctr            Float?
  cantResultados Int?
  costoResultado Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  anuncios       AnuncioCampana[]
  resultados     ResultadoCampana[]

  @@map("ejecuciones_campana")
}

// Anuncio (creativo) dentro de una campaña. Reemplaza a MetaAnuncio en el sistema unificado.
model AnuncioCampana {
  id          String           @id @default(cuid())
  ejecucionId String
  ejecucion   EjecucionCampana @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  nombre      String
  formato     String           @default("IMAGEN") // IMAGEN | VIDEO | CARRUSEL | REEL | HISTORIA | COLECCION
  titular     String?
  copy        String?          // texto principal del anuncio
  cta         String?          // MAS_INFORMACION | CONTACTAR | ENVIAR_MENSAJE | ...
  urlDestino  String?
  estado      String           @default("ACTIVO") // ACTIVO | PAUSADO | RECHAZADO
  createdAt   DateTime         @default(now())

  @@index([ejecucionId])
  @@map("anuncios_campana")
}

// Resultado por periodo de una campaña. Reemplaza a MetaResultado en el sistema unificado.
model ResultadoCampana {
  id          String           @id @default(cuid())
  ejecucionId String
  ejecucion   EjecucionCampana @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  fecha       DateTime
  impresiones Int              @default(0)
  alcance     Int              @default(0)
  clics       Int              @default(0)
  leads       Int              @default(0)
  gastado     Float            @default(0)
  cpm         Float?
  cpc         Float?
  cpl         Float?
  frecuencia  Float?
  notas       String?
  createdAt   DateTime         @default(now())

  @@index([ejecucionId])
  @@map("resultados_campana")
}

// ─── META ADS ─────────────────────────────────────────────────────────────────

model MetaCampana {
  id             String   @id @default(cuid())
  nombre         String
  objetivo       String   @default("LEADS")   // LEADS | AWARENESS | CONVERSIONES | TRAFICO
  estado         String   @default("BORRADOR") // BORRADOR | ACTIVA | PAUSADA | FINALIZADA
  presupuesto    Float    @default(0)
  fechaInicio    DateTime?
  fechaFin       DateTime?
  audiencia      String?  // JSON: segmentación de audiencia
  ubicaciones    String?  // JSON: plataformas (Facebook, Instagram, Audience Network)
  notas          String?
  creadoPorId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  anuncios       MetaAnuncio[]
  resultados     MetaResultado[]

  @@map("meta_campanas")
}

model MetaAnuncio {
  id          String   @id @default(cuid())
  campanaId   String
  campana     MetaCampana @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  nombre      String
  formato     String   @default("IMAGEN") // IMAGEN | VIDEO | CARRUSEL | HISTORIA
  titular     String?
  descripcion String?
  cta         String?  // Texto del call-to-action
  urlDestino  String?
  estado      String   @default("ACTIVO") // ACTIVO | PAUSADO | RECHAZADO
  notas       String?
  createdAt   DateTime @default(now())

  @@map("meta_anuncios")
}

model MetaResultado {
  id             String   @id @default(cuid())
  campanaId      String
  campana        MetaCampana @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha          DateTime
  impresiones    Int      @default(0)
  alcance        Int      @default(0)
  clics          Int      @default(0)
  leads          Int      @default(0)
  gastado        Float    @default(0)
  cpm            Float?   // Costo por mil impresiones
  cpc            Float?   // Costo por clic
  cpl            Float?   // Costo por lead
  frecuencia     Float?
  notas          String?
  createdAt      DateTime @default(now())

  @@map("meta_resultados")
}

// ─── LEVANTAMIENTO DE CONTENIDO ──────────────────────────────────────────────

model LevantamientoContenido {
  id                          String    @id @default(cuid())
  tratoId                     String    @unique
  trato                       Trato     @relation(fields: [tratoId], references: [id], onDelete: Cascade)

  nombreEvento                String?
  tipoEvento                  String?
  fecha                       DateTime?
  horarioEvento               String?
  horarioCobertura            String?
  lugar                       String?
  nombreCliente               String?
  redesSocialesCliente        String?
  tieneProveedoresAdicionales String?   // SI | NO | SIN_INFO
  proveedoresDetalle          String?
  objetivosContenido          String?   // JSON array de strings
  detalleObjetivo             String?
  planCobertura               String?   // BASICO | ESTANDAR | PLUS | INTEGRAL | OTRO
  planCoberturaOtro           String?
  temasSugeridos              String?
  colaboradoresCamara         Boolean?
  colaboradoresNombres        String?
  notasAdicionales            String?
  scoreFotoVideo              Int?
  recomendacionFotoVideo      String?
  estadoLevantamiento         String    @default("PENDIENTE") // PENDIENTE | CONFIRMADO | REALIZADO | CANCELADO

  activos   ActivoEvento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("levantamientos_contenido")
}

// ─── VENUES ──────────────────────────────────────────────────────────────────

model Venue {
  id                  String   @id @default(cuid())
  nombre              String
  direccion           String?
  ciudad              String?
  contacto            String?
  telefonoContacto    String?
  emailContacto       String?
  capacidadPersonas   Int?
  // Dimensiones
  largoM              Float?
  anchoM              Float?
  alturaMaximaM       Float?
  // Acceso
  accesoVehicular     String?
  puntoDescarga       String?
  // Electricidad
  voltajeDisponible   String?
  amperajeTotal       Float?
  fases               String?
  ubicacionTablero    String?
  // Restricciones
  restriccionDecibeles  String?
  restriccionHorario    String?
  restriccionInstalacion String?
  // Información adicional
  tiposEvento         String?  // JSON: ["MUSICAL","SOCIAL","EMPRESARIAL"]
  calificacion        Float?   // 1-5
  notas               String?
  fotoPortada         String?  // base64
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("venues")
}

// ─── PLANTILLAS DE COTIZACIÓN ─────────────────────────────────────────────────

model PlantillaCotizacion {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  tipoEvento    String?
  tipoServicio  String?
  activo        Boolean  @default(true)
  creadaPorId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Campos de cotización que se copian
  horasOperacion   Float?
  tipoJornada      String?
  diasEquipo       Int     @default(1)
  diasOperacion    Int     @default(1)
  diasTransporte   Int     @default(1)
  diasHospedaje    Int     @default(1)
  diasComidas      Int     @default(1)
  observaciones    String?
  terminosComerciales String?
  vigenciaDias     Int     @default(30)
  aplicaIva        Boolean @default(false)

  lineas PlantillaCotizacionLinea[]

  @@map("plantillas_cotizacion")
}

model PlantillaCotizacionLinea {
  id          String               @id @default(cuid())
  plantillaId String
  plantilla   PlantillaCotizacion  @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  tipo         String
  equipoId     String?
  equipo       Equipo?  @relation(fields: [equipoId], references: [id])
  rolTecnicoId String?
  descripcion    String
  marca          String?
  modelo         String?
  nivel          String?
  jornada        String?
  esExterno      Boolean @default(false)
  cantidad       Float   @default(1)
  dias           Int     @default(1)
  precioUnitario Float   @default(0)
  costoUnitario  Float   @default(0)
  subtotal       Float   @default(0)
  esIncluido     Boolean @default(false)
  notas          String?
  orden          Int     @default(0)

  @@map("plantillas_cotizacion_lineas")
}

// ─── CIERRE FINANCIERO DE PROYECTO ───────────────────────────────────────────

model CierreFinanciero {
  id         String   @id @default(cuid())
  proyectoId String   @unique
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  // Estimado (de cotización)
  granTotalEstimado       Float @default(0)
  costoEstimado           Float @default(0)
  utilidadEstimada        Float @default(0)

  // Real (calculado al cierre)
  totalCobrado            Float @default(0)
  totalGastado            Float @default(0)
  utilidadReal            Float @default(0)
  margenReal              Float @default(0)

  // Detalle por categoría (JSON)
  desgloseCostos          String? // JSON: [{categoria, monto}]
  notas                   String?

  cerradoEn               DateTime @default(now())
  cerradoPorId            String?

  @@map("cierres_financieros")
}

// ─── ESTRUCTURA DE CAPITAL (HERVAM) ──────────────────────────────────────────

model HervamActivo {
  id               String   @id @default(cuid())
  nombre           String
  marca            String?
  modelo           String?
  descripcion      String?
  cantidad         Int      @default(1)
  categoria        String   @default("EQUIPO") // EQUIPO | VEHICULO | INMUEBLE | INTANGIBLE | OTRO | OFICINA
  propietario      String   @default("MAINSTAGE") // MAINSTAGE | HERVAM
  valorAdquisicion Float    @default(0)
  valorActual      Float    @default(0)
  precioRenta      Float    @default(0)  // Ingreso mensual estimado por renta del activo
  fechaAdquisicion DateTime?
  activo           Boolean  @default(true)
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@map("hervam_activos")
}

model HervamConfig {
  id                   String   @id @default(cuid())
  socioId              String?
  socio                Socio?   @relation(fields: [socioId], references: [id])
  // Valuación
  valorTotalActivos    Float    @default(5000000)
  tasaAnualRendimiento Float    @default(15)
  usarSumaActivos      Boolean  @default(false) // true = calcula desde activos; false = usa valorTotalActivos
  // Modo
  modoActivo           String   @default("HIBRIDO") // FIJO | VARIABLE | HIBRIDO
  porcentajeVariable   Float    @default(25)
  pisoMinimoFijo       Float    @default(50)  // % del monto fijo como garantía mínima
  // Crédito
  creditoSaldoInicial  Float    @default(800000)
  creditoSaldoActual   Float    @default(800000)
  creditoCuotaMensual  Float    @default(0)
  creditoPlazoMeses    Int      @default(48)
  creditoFechaInicio   DateTime?
  // Meta
  notas                String?
  actualizadoEn        DateTime @updatedAt
  @@map("hervam_config")
}

model HervamPago {
  id            String    @id @default(cuid())
  mes           Int
  anio          Int
  montoFijo     Float
  utilidadMes   Float?
  montoVariable Float?
  montoAcordado Float
  montoPagado   Float     @default(0)
  estado        String    @default("PENDIENTE") // PENDIENTE | PARCIAL | PAGADO | DIFERIDO
  modoPago      String?   // FIJO | VARIABLE
  notas         String?
  pagadoEn      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([mes, anio])
  @@map("hervam_pagos")
}

// ─── SOCIOS DE ACTIVOS ────────────────────────────────────────────────────────

model Socio {
  id             String    @id @default(cuid())
  nombre         String
  tipo           String    @default("FISICA") // FISICA | MORAL
  esFundador     Boolean   @default(false)
  rfc            String?
  curp           String?
  telefono       String?
  email          String?
  domicilio      String?
  colonia        String?
  ciudad         String?
  estado         String?
  cp             String?
  status         String    @default("EN_REVISION") // EN_REVISION | ACTIVO | SUSPENDIDO | INACTIVO
  notas          String?
  contratoInicio DateTime?
  contratoFin    DateTime?
  pctSocio       Float     @default(70)
  pctMainstage   Float     @default(30)
  // ── Estructura societaria ─────────────────────────────────────────────────
  razonSocial       String?  // Nombre legal de la empresa (ej. "Escenario Principal S.A. de C.V.")
  pctParticipacion  Float?   // % de participación en la sociedad (ej. 90.0 o 10.0)
  esRepresentante   Boolean  @default(false) // Si es el representante legal
  // ── Reparto de utilidades ────────────────────────────────────────────────
  esRepartoUtilidades Boolean @default(false) // Si recibe reparto (no nómina)
  montoRepartoSemanal Float?  // Monto fijo semanal de reparto (ej. 4000)
  personalInternoId   String? @unique // Referencia al PersonalInterno que se migró
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activos      SocioActivo[]
  reportes     SocioReporte[]
  checklist    SocioRequisitoItem[]
  cuentasPagar CuentaPagar[]
  hervamConfig HervamConfig[]
  repartos     RepartoUtilidad[]

  @@map("socios")
}

model SocioRequisitoItem {
  id         String   @id @default(cuid())
  socioId    String
  socio      Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  requisito  String
  completado Boolean  @default(false)
  notas      String?
  orden      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("socios_requisitos")
}

model SocioActivo {
  id                   String    @id @default(cuid())
  socioId              String
  socio                Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  codigoInventario     String    @unique
  nombre               String
  marca                String?
  modelo               String?
  serial               String?
  categoria            String    @default("AUDIO") // AUDIO | ILUMINACION | VIDEO | ESTRUCTURAS | ACCESORIOS | OTRO
  condicion            String    @default("BUENO")  // NUEVO | EXCELENTE | BUENO | REGULAR | REQUIERE_MANTENIMIENTO
  valorDeclarado       Float     @default(0)
  precioDia            Float     @default(0)
  pctSocioOverride     Float?
  pctMainstageOverride Float?
  fotosUrls            String    @default("[]")
  activo               Boolean   @default(true)
  notas                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rentas         SocioRenta[]
  mantenimientos SocioMantenimiento[]

  @@map("socios_activos")
}

model SocioMantenimiento {
  id             String      @id @default(cuid())
  activoId       String
  activo         SocioActivo @relation(fields: [activoId], references: [id], onDelete: Cascade)
  tipo           String      // PREVENTIVO | CORRECTIVO | INSPECCION
  descripcion    String
  fechaEjecucion DateTime?
  costoTotal     Float       @default(0)
  costoSocio     Float       @default(0)
  costoMainstage Float       @default(0)
  realizadoPor   String?
  notas          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("socios_mantenimientos")
}

model SocioRenta {
  id             String      @id @default(cuid())
  activoId       String
  activo         SocioActivo @relation(fields: [activoId], references: [id], onDelete: Cascade)
  descripcion    String
  proyectoId     String?
  mes            Int
  anio           Int
  fechaInicio    DateTime?
  fechaFin       DateTime?
  dias           Int         @default(1)
  precioDia      Float
  subtotal       Float
  pctSocio       Float
  pctMainstage   Float
  montoSocio     Float
  montoMainstage Float
  notas          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("socios_rentas")
}

model SocioReporte {
  id             String    @id @default(cuid())
  socioId        String
  socio          Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  mes            Int
  anio           Int
  totalEventos   Int       @default(0)
  totalDias      Int       @default(0)
  totalFacturado Float     @default(0)
  totalSocio     Float     @default(0)
  totalMainstage Float     @default(0)
  estado         String    @default("BORRADOR") // BORRADOR | ENVIADO | PAGADO
  pagadoEn       DateTime?
  notas          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([socioId, mes, anio])
  @@map("socios_reportes")
}


// ─── MÉTRICAS ORGÁNICAS ───────────────────────────────────────────────────────

model MetricaOrganica {
