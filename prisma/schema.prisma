model ConfigComisiones {
  id                   String   @id @default(cuid())
  // Metas ramp-up
  metaMes1             Float    @default(60000)
  metaMes2             Float    @default(80000)
  metaMes3             Float    @default(100000)
  metaMesNormal        Float    @default(150000)
  // Porcentajes comisión base
  pctClientePropio     Float    @default(10)   // 10% cliente propio
  pctPublicidad        Float    @default(5)    // 5% lead por publicidad
  pctAsignadoVendedor  Float    @default(5)    // 5% al vendedor que cierra (cliente asignado)
  pctAsignadoOrigen    Float    @default(5)    // 5% al vendedor original (cliente asignado)
  // Bono
  pctBono              Float    @default(3)    // 3% si alcanza el piso
  // Metas de prospección outbound
  metaProspectoDiaria  Int      @default(12)   // prospectos outbound mínimos por día
  updatedAt            DateTime @updatedAt

  @@map("config_comisiones")
}

model ComisionPago {
  id          String   @id @default(cuid())
  vendedorId  String
  vendedor    User     @relation(fields: [vendedorId], references: [id])
  mes         String   // "2026-04"
  montoTotal  Float
  notas       String?
  pagadoEn    DateTime @default(now())

  @@map("comision_pagos")
}

// ─── MANTENIMIENTO ───────────────────────────────────────────────────────────

model EquipoUnidad {
  id        String   @id @default(cuid())
  equipoId  String
  equipo    Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  codigo    String?  // Número de serie, tag, etiqueta, ej: "SN-12345" o "Unidad 1"
  estado    String   @default("ACTIVO") // ACTIVO | EN_MANTENIMIENTO | DADO_DE_BAJA
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  mantenimientos MantenimientoEquipo[]

  @@map("equipo_unidades")
}

model MantenimientoEquipo {
  id                   String        @id @default(cuid())
  equipoId             String
  equipo               Equipo        @relation(fields: [equipoId], references: [id])
  unidadId             String?
  unidad               EquipoUnidad? @relation(fields: [unidadId], references: [id])
  fecha                DateTime
  tipo                 String        // PREVENTIVO | CORRECTIVO | ESTETICO | FUNCIONAL
  accionRealizada      String
  estadoEquipo         String?
  comentarios          String?
  proximoMantenimiento DateTime?
  fotoEvidencia        String?       // base64 data URL
  createdAt            DateTime      @default(now())

  @@map("mantenimientos_equipos")
}

// ─── RECURSOS HUMANOS ────────────────────────────────────────────────────────

model PersonalInterno {
  id             String    @id @default(cuid())
  nombre         String
  puesto         String    // Ej: "Bodega", "Coordinación Logística"
  departamento   String    @default("GENERAL") // BODEGA | COORDINACION | PRODUCCION | ADMINISTRACION | VENTAS | GENERAL
  tipo           String    @default("EMPLEADO") // EMPLEADO | FREELANCE_RECURRENTE
  telefono       String?
  correo         String?
  salario        Float?    // Mensual (empleado) o tarifa base (freelance recurrente)
  periodoPago    String    @default("MENSUAL") // MENSUAL | QUINCENAL | SEMANAL | POR_EVENTO
  fechaIngreso   DateTime?
  activo         Boolean   @default(true)
  cuentaBancaria String?
  datosFiscales  String?
  notas          String?
  // Datos bancarios
  banco          String?
  clabe          String?   @map("clabe")
  numeroCuenta   String?   @map("numero_cuenta")
  numeroTarjeta  String?   @map("numero_tarjeta")
  // Datos personales
  ineUrl         String?   @map("ine_url")
  domicilio      String?
  // Contacto de emergencia
  emergenciaNombre String? @map("emergencia_nombre")
  emergenciaTel    String? @map("emergencia_tel")
  // Salud
  padecimientos  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documentos    DocumentoPersonal[]
  pagos         PagoNomina[]
  asistencias   Asistencia[]
  incidencias   Incidencia[]
  evaluaciones  EvaluacionEmpleado[]
  encuestasSatisfaccion EncuestaSatisfaccionEquipo[]
  capacitaciones CapacitacionParticipante[]

  @@map("personal_interno")
}

model DocumentoPersonal {
  id               String          @id @default(cuid())
  personalId       String
  personal         PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  tipo             String          // CONTRATO | IDENTIFICACION | CURP | RFC | COMPROBANTE_DOMICILIO | OTRO
  nombre           String
  url              String
  fechaVencimiento DateTime?
  createdAt        DateTime        @default(now())

  @@map("documentos_personal")
}

model PagoNomina {
  id             String               @id @default(cuid())
  personalId     String
  personal       PersonalInterno      @relation(fields: [personalId], references: [id])
  periodo        String               // "2026-04"
  tipoPeriodo    String               @default("MENSUAL") // MENSUAL | QUINCENAL | SEMANAL | EVENTO
  monto          Float
  concepto       String?
  estado         String               @default("PENDIENTE") // PENDIENTE | PAGADO
  fechaPago      DateTime?
  metodoPago     String               @default("TRANSFERENCIA")
  cuentaOrigenId String?
  cuentaOrigen   CuentaBancaria?      @relation(fields: [cuentaOrigenId], references: [id])
  movimientoId   String?              @unique
  movimiento     MovimientoFinanciero? @relation(fields: [movimientoId], references: [id])
  notas          String?
  createdAt      DateTime             @default(now())

  @@map("pagos_nomina")
}

// ─── ASISTENCIA E INCIDENCIAS ────────────────────────────────────────────────

model Asistencia {
  id             String          @id @default(cuid())
  personalId     String
  personal       PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  fecha          DateTime
  estado         String          // PRESENTE | FALTA | RETARDO | PERMISO | VACACIONES | INCAPACIDAD
  minutosRetardo Int?
  horaEntrada    String?
  horaSalida     String?
  notas          String?
  createdAt      DateTime        @default(now())

  @@unique([personalId, fecha])
  @@map("asistencias")
}

model TipoIncidencia {
  id          String  @id @default(cuid())
  nombre      String
  categoria   String  // ASISTENCIA | CONDUCTA | DESEMPEÑO | RECONOCIMIENTO
  calculoTipo String  @default("SIN_DESCUENTO") // FIJO | PORCENTAJE_DIA | PORCENTAJE_HORA | SIN_DESCUENTO
  valor       Float   @default(0)
  esDescuento Boolean @default(true)
  descripcion String?
  activo      Boolean @default(true)

  incidencias Incidencia[]

  @@map("tipos_incidencia")
}

model Incidencia {
  id             String          @id @default(cuid())
  personalId     String
  personal       PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  tipoId         String
  tipo           TipoIncidencia  @relation(fields: [tipoId], references: [id])
  fecha          DateTime
  descripcion    String?
  montoCalculado Float?
  periodoNomina  String?         // "2026-04"
  aplicada       Boolean         @default(false)
  notificada     Boolean         @default(false)
  createdAt      DateTime        @default(now())

  @@map("incidencias")
}

model EvaluacionEmpleado {
  id           String          @id @default(cuid())
  personalId   String
  personal     PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  periodo      String
  evaluador    String?
  fecha        DateTime        @default(now())

  puntualidad      Int @default(0)
  ordenLimpieza    Int @default(0)
  actitud          Int @default(0)
  comunicacion     Int @default(0)
  resolucionProb   Int @default(0)
  propuestasMejora Int @default(0)
  calidadTrabajo   Int @default(0)
  trabajoEquipo    Int @default(0)

  aspectosPositivos String?
  areasMejora       String?
  incidentesNota    String?
  observaciones     String?

  puntajeTotal Float?
  estado       String   @default("BORRADOR") // BORRADOR | COMPLETADA
  createdAt    DateTime @default(now())

  @@map("evaluaciones_empleado")
}

// ─── BODEGA ──────────────────────────────────────────────────────────────────

model ItemTemplateBodega {
  id          String  @id @default(cuid())
  descripcion String
  categoria   String  @default("GENERAL") // AUDIO | ILUMINACION | VIDEO | CABLES | HERRAMIENTAS | TRANSPORTES | GENERAL
  orden       Int     @default(0)
  activo      Boolean @default(true)

  @@map("items_template_bodega")
}

model ChecklistBodega {
  id          String    @id @default(cuid())
  semana      String    // "2026-W15" (ISO año + semana)
  fechaInicio DateTime
  estado      String    @default("EN_PROGRESO") // EN_PROGRESO | COMPLETADO | CON_ALERTAS
  notas       String?
  creadoPor   String?
  cerradoEn   DateTime?
  createdAt   DateTime  @default(now())

  items ChecklistBodegaItem[]

  @@unique([semana])
  @@map("checklist_bodega")
}

model ChecklistBodegaItem {
  id                String          @id @default(cuid())
  checklistId       String
  checklist         ChecklistBodega @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  descripcion       String
  categoria         String          @default("GENERAL")
  estado            String          @default("PENDIENTE") // PENDIENTE | EN_BODEGA | EN_RENTA_O_USO | EXTRAVIADO | PERDIDO
  notas             String?
  equipoId          String?
  equipo            Equipo?         @relation(fields: [equipoId], references: [id])
  orden             Int             @default(0)
  cantidadEsperada  Int?
  cantidadContada   Int?

  @@map("checklist_bodega_items")
}

// ─── MARKETING ───────────────────────────────────────────────────────────────

model TipoContenido {
  id           String  @id @default(cuid())
  nombre       String
  formato      String  @default("POST") // POST | REEL | STORIE | TIK_TOK
  objetivo     String?
  diaSemana    String? // Día(s) separados por coma, ej: "LUNES,VIERNES"
  semanaDelMes Int?    // 1=primer, 2=segundo, 3=tercer, 4=cuarto (para publicaciones 1x/mes en día específico)
  recurrencia  String?
  cantMes      Int?
  descripcion  String?
  activo       Boolean @default(true)
  orden        Int     @default(0)
  enFacebook   Boolean @default(false)
  enInstagram  Boolean @default(false)
  enTiktok     Boolean @default(false)
  enYoutube    Boolean @default(false)
  enFeedIG     Boolean @default(false) // Aparece en previsualización Feed IG

  publicaciones Publicacion[]

  @@map("tipos_contenido")
}

model Publicacion {
  id             String         @id @default(cuid())
  fecha          DateTime
  tipoId         String?
  tipo           TipoContenido? @relation(fields: [tipoId], references: [id])
  formato        String?
  objetivo       String?
  descripcion    String?
  copy           String?
  enFacebook     Boolean        @default(false)
  enInstagram    Boolean        @default(false)
  enTiktok       Boolean        @default(false)
  enYoutube      Boolean        @default(false)
  materialLink   String?
  portadaUrl     String?        // URL de imagen de portada opción A (feed IG)
  portadaUrlB    String?        // URL de imagen de portada opción B (A/B test)
  colaboradores  String?
  estado         String         @default("PENDIENTE")
  comentarios    String?
  alcance        Int?
  impresiones    Int?
  interacciones  Int?
  seguidoresGanados Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("publicaciones")
}

// ─── ENCUESTA SATISFACCIÓN EQUIPO ────────────────────────────────────────────
// Los empleados/freelancers responden cómo perciben trabajar en Mainstage

model EncuestaSatisfaccionEquipo {
  id          String    @id @default(cuid())
  personalId  String
  personal    PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  periodo     String    // ej. "Q1-2026" o "2026-05"
  token       String    @unique @default(cuid())
  enviada     Boolean   @default(false)
  respondida  Boolean   @default(false)
  respondidaEn DateTime?

  // Criterios 1-10
  claridadInstrucciones  Int?  // ¿Las instrucciones de trabajo son claras?
  pagosPuntuales         Int?  // ¿Los pagos son puntuales?
  tratoJusto             Int?  // ¿Sientes que te tratan de forma justa?
  organizacion           Int?  // ¿Mainstage está bien organizada?
  comunicacion           Int?  // ¿La comunicación contigo es fluida?
  herramientas           Int?  // ¿Tienes los equipos/herramientas que necesitas?
  crecimiento            Int?  // ¿Sientes que puedes crecer aquí?
  ambiente               Int?  // ¿Cómo es el ambiente de trabajo?

  // NPS 0-10
  probabilidadRecomendar Int?  // ¿Recomendarías trabajar en Mainstage?

  // Texto libre
  loMejor         String?  // ¿Qué es lo que más valoras de trabajar en Mainstage?
  loMejorable     String?  // ¿Qué cambiarías?
  comentarios     String?

  promedioCalculado Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([personalId, periodo])
  @@map("encuestas_satisfaccion_equipo")
}

// Capacitaciones del equipo
model Capacitacion {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  area        String   @default("GENERAL") // área responsable
  tipo        String   @default("TECNICA") // TECNICA | SEGURIDAD | PROCEDIMIENTOS | DESARROLLO | INDUCCION
  modalidad   String   @default("PRESENCIAL") // PRESENCIAL | VIRTUAL | AUTOAPRENDIZAJE
  fechaInicio DateTime
  fechaFin    DateTime?
  duracionHrs Float?
  instructor  String?
  material    String?  // URL o descripción del material
  estado      String   @default("PROGRAMADA") // PROGRAMADA | EN_CURSO | COMPLETADA | CANCELADA
  obligatoria Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participantes CapacitacionParticipante[]
  @@map("capacitaciones")
}

model CapacitacionParticipante {
  id              String       @id @default(cuid())
  capacitacionId  String
  capacitacion    Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  personalId      String
  personal        PersonalInterno @relation(fields: [personalId], references: [id], onDelete: Cascade)
  asistio         Boolean      @default(false)
  calificacion    Float?
  notas           String?
  createdAt       DateTime     @default(now())

  @@unique([capacitacionId, personalId])
  @@map("capacitacion_participantes")
}

// ─── CONFIGURACIÓN DE LA APP ─────────────────────────────────────────────────

model AppConfig {
  id           String  @id @default(cuid())
  key          String  @unique
  value        String
  section      String  @default("general")
  label        String  @default("")
  description  String?
  type         String  @default("text")
  defaultValue String?
  orden        Int     @default(0)
  @@map("app_config")
}

model ModuloAcceso {
  id        String   @id @default(cuid())
  moduloKey String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([moduloKey, userId])
  @@map("modulo_accesos")
}

// ─── PLANTILLAS DE EQUIPO (sugerencias por tipo evento/servicio/capacidad) ───

model PlantillaEquipo {
  id           String   @id @default(cuid())
  nombre       String
  tipoServicio String   @default("TODOS") // PRODUCCION_TECNICA | RENTA | TODOS
  tipoEvento   String   @default("TODOS") // MUSICAL | SOCIAL | EMPRESARIAL | OTRO | TODOS
  capacidadMin Int      @default(0)
  capacidadMax Int      @default(9999)
  descripcion  String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  items        PlantillaEquipoItem[]
  @@map("plantillas_equipo")
}

model PlantillaEquipoItem {
  id          String          @id @default(cuid())
  plantillaId String
  plantilla   PlantillaEquipo @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  equipoId    String?
  equipo      Equipo?         @relation(fields: [equipoId], references: [id])
  descripcion String
  cantidad    Int             @default(1)
  esOpcional  Boolean         @default(false)
  orden       Int             @default(0)
  notas       String?
  @@map("plantillas_equipo_items")
}

// ─── VEHÍCULOS Y MANTENIMIENTO ───────────────────────────────────────────────

model Vehiculo {
  id                   String    @id @default(cuid())
  nombre               String    // Nombre identificador Ej. "Sprinter Negra"
  marca                String?
  modelo               String?
  anio                 Int?
  placas               String?
  color                String?
  kilometraje          Int?      // Km actuales del odómetro
  proximoServicioKm    Int?      // Km en que toca el próximo servicio
  proximoServicioFecha DateTime? // Fecha del próximo servicio programado
  activo               Boolean   @default(true)
  notas                String?
  fotos                String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  mantenimientos       MantenimientoVehiculo[]
  @@map("vehiculos")
}

model MantenimientoVehiculo {
  id             String    @id @default(cuid())
  vehiculoId     String
  vehiculo       Vehiculo  @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  fecha          DateTime
  km             Int?      // Km al momento del registro
  tipoRegistro   String    // SERVICIO | REPARACION | REVISION | ACCIDENTE | OTRO
  servicio       String    // Descripción del trabajo realizado
  aceite         String?   // Tipo/número de aceite utilizado
  anticongelante String?   // Tipo/número de anticongelante
  estadoLlantas  String?   // Descripción del estado de llantas
  proximoKm      Int?      // Km para el próximo servicio
  proximaFecha   DateTime? // Fecha para el próximo servicio
  prioridad      String    @default("NORMAL") // BAJA | NORMAL | ALTA | URGENTE
  estatus        String    @default("COMPLETADO") // PENDIENTE | EN_PROCESO | COMPLETADO
  costo          Float?
  comentarios    String?
  fotos          String[]  @default([])
  createdAt      DateTime  @default(now())
  @@map("mantenimiento_vehiculos")
}

// ─── OPERACIONES ─────────────────────────────────────────────────────────────

model IniciativaExterna {
  id          String    @id @default(cuid())
  nombre      String
  descripcion String?
  area        String    @default("GENERAL") // VENTAS | ADMINISTRACION | PRODUCCION | MARKETING | RRHH | GENERAL
  estado      String    @default("ACTIVA")  // ACTIVA | COMPLETADA | ARCHIVADA
  color       String?
  creadoPorId String?
  creadoPor   User?     @relation("IniciativasCreadas", fields: [creadoPorId], references: [id])
  fechaInicio DateTime?
  fechaFin    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tareas Tarea[]

  @@map("iniciativas_externas")
}

model Tarea {
  id               String             @id @default(cuid())
  titulo           String
  descripcion      String?
  prioridad        String             @default("MEDIA")    // URGENTE | ALTA | MEDIA | BAJA
  area             String             @default("GENERAL")  // VENTAS | ADMINISTRACION | PRODUCCION | MARKETING | RRHH | GENERAL
  estado           String             @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | CANCELADA
  asignadoAId      String?
  asignadoA        User?              @relation("TareasAsignadas",  fields: [asignadoAId], references: [id])
  creadoPorId      String?
  creadoPor        User?              @relation("TareasCreadoPor",  fields: [creadoPorId], references: [id])
  iniciativaId     String?
  iniciativa       IniciativaExterna? @relation(fields: [iniciativaId], references: [id], onDelete: SetNull)
  // ── Hierarchy ──────────────────────────────────────────────────────────────
  carpetaId        String?
  carpeta          TareaCarpeta?      @relation(fields: [carpetaId], references: [id], onDelete: SetNull)
  proyectoTareaId  String?
  proyectoTarea    TareaProyecto?     @relation(fields: [proyectoTareaId], references: [id], onDelete: SetNull)
  seccionId        String?
  seccion          TareaSeccion?      @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  parentId         String?
  parent           Tarea?             @relation("TareaSubtareas", fields: [parentId], references: [id], onDelete: Cascade)
  subtareas        Tarea[]            @relation("TareaSubtareas")
  // ── Proyecto Evento ──────────────────────────────────────────────────────────
  proyectoEventoId String?
  proyectoEvento   Proyecto?          @relation("TareasDeProyecto", fields: [proyectoEventoId], references: [id], onDelete: SetNull)
  // ── Scheduling ──────────────────────────────────────────────────────────────
  fecha            DateTime?  // When to work on it (shows in Hoy)
  fechaVencimiento DateTime?
  fechaCompletada  DateTime?
  recurrencia      String?    // JSON: RecurrenciaConfig
  orden            Int        @default(0)
  // ── Content ──────────────────────────────────────────────────────────────
  notas            String?
  etiquetas        String?    // JSON string[]
  // ── Contexto de delegaci\u00f3n ──────────────────────────────────────────────
  paraQueSirve      String?   // \u00bfPara qu\u00e9 sirve? impacto positivo
  quePasaSiNoSeHace String?   // \u00bfQu\u00e9 pasa si no se hace?
  dondeSeEjecuta    String?   // M\u00f3dulo, herramienta o espacio
  pasos             Json?     // [{orden: number, texto: string}]
  // ── Origen ───────────────────────────────────────────────────────────────
  juntaOrigenId    String?
  juntaOrigen      Junta?             @relation("JuntaOrigen", fields: [juntaOrigenId], references: [id], onDelete: SetNull)
  // ── Plan de trabajo ───────────────────────────────────────────────────────
  origenPlan        Boolean  @default(false)
  planActividadId   String?
  planActividad     PlanTrabajoActividad? @relation("TareasDePlan", fields: [planActividadId], references: [id], onDelete: SetNull)
  // ── Proyecto interno ─────────────────────────────────────────────────────
  proyectoInternoId String?
  proyectoInterno   ProyectoInterno? @relation("TareasDeProyectoInterno", fields: [proyectoInternoId], references: [id], onDelete: SetNull)
  faseInternaId     String?
  faseInterna       FaseProyectoInterno? @relation("TareasDeFase", fields: [faseInternaId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  comentarios      TareaComentario[]
  archivos         TareaArchivo[]

  @@map("tareas")
}

model TareaCarpeta {
  id          String          @id @default(cuid())
  nombre      String
  color       String?
  icono       String?
  orden       Int             @default(0)
  creadoPorId String?
  creadoPor   User?           @relation("CarpetasCreadas", fields: [creadoPorId], references: [id])
  proyectos   TareaProyecto[]
  tareas      Tarea[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("tarea_carpetas")
}

model TareaProyecto {
  id          String         @id @default(cuid())
  nombre      String
  descripcion String?
  color       String?
  icono       String?
  orden       Int            @default(0)
  archivado   Boolean        @default(false)
  carpetaId   String?
  carpeta     TareaCarpeta?  @relation(fields: [carpetaId], references: [id], onDelete: SetNull)
  creadoPorId String?
  creadoPor   User?          @relation("ProyectosTareaCreados", fields: [creadoPorId], references: [id])
  secciones   TareaSeccion[]
  tareas      Tarea[]
  accesos     ProyectoAcceso[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("tarea_proyectos")
}

model TareaSeccion {
  id         String        @id @default(cuid())
  nombre     String
  orden      Int           @default(0)
  colapsada  Boolean       @default(false)
  proyectoId String
  proyecto   TareaProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tareas     Tarea[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("tarea_secciones")
}

model TareaComentario {
  id        String   @id @default(cuid())
  contenido String
  tareaId   String
  tarea     Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  autorId   String?
  autor     User?    @relation("ComentariosTarea", fields: [autorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tarea_comentarios")
}

// ─── GASTOS OPERATIVOS ───────────────────────────────────────────────────────
// Efectivo que coordinación necesita antes del evento: comidas, transporte, hospedaje.
// Se jalan de las líneas de cotización y admin marca si ya se entregó el dinero.
model GastoOperativo {
  id          String   @id @default(cuid())
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tipo        String   // COMIDA | TRANSPORTE | HOSPEDAJE | OTRO
  concepto    String
  monto       Float
  cantidad    Int      @default(1)
  // Estado de entrega del efectivo a coordinación
  entregado   Boolean  @default(false)
  fechaEntrega DateTime?
  notas       String?
  createdAt   DateTime @default(now())

  @@map("gastos_operativos")
}

model TareaArchivo {
  id          String   @id @default(cuid())
  nombre      String
  url         String
  tipo        String?  // MIME type or category
  tamano      Int?     // bytes
  tareaId     String
  tarea       Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  subidoPorId String?
  subidoPor   User?    @relation("ArchivosTarea", fields: [subidoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@map("tarea_archivos")
}

// ─── TALENTO / ATS ───────────────────────────────────────────────────────────

model PuestoIdeal {
  id          String  @id @default(cuid())
  titulo      String
  area        String  // PRODUCCION | ADMINISTRACION | COMERCIAL | OPERACIONES | RRHH | TECNOLOGIA
  descripcion String?
  objetivoRol String? @map("objetivo_rol")

  // Perfil demográfico
  edadMin           Int?    @map("edad_min")
  edadMax           Int?    @map("edad_max")
  ciudades          String? // JSON array
  nivelEstudios     String? @map("nivel_estudios") // BACHILLERATO | LICENCIATURA | POSGRADO | INDIFERENTE
  carrerasSugeridas String? @map("carreras_sugeridas")

  // Competencias (JSON arrays de strings)
  habilidadesTecnicas String? @map("habilidades_tecnicas")
  habilidadesBlandas  String? @map("habilidades_blandas")
  conocimientos       String?
  aptitudes           String?
  valores             String?
  areasDesarrollo     String? @map("areas_desarrollo")

  // Criterios de evaluación JSON: [{criterio, peso, descripcion}]
  criteriosEvaluacion String? @map("criterios_evaluacion")

  // Condiciones
  salarioMin   Float?  @map("salario_min")
  salarioMax   Float?  @map("salario_max")
  tipoContrato String? @map("tipo_contrato") // NOMINA | HONORARIOS | FREELANCE
  modalidad    String? // PRESENCIAL | REMOTO | HIBRIDO
  horario      String?
  prestaciones String? // JSON array

  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  postulaciones Postulacion[]

  @@map("puestos_ideales")
}

model Candidato {
  id       String  @id @default(cuid())
  nombre   String
  correo   String?
  telefono String?
  ciudad   String?
  edad     Int?
  nivelEstudios String? @map("nivel_estudios")
  carrera  String?

  // Discovery form
  experienciaEventos      String?  @map("experiencia_eventos")
  aniosExperienciaEventos Int?     @map("anios_experiencia_eventos")
  eventoDestacado         String?  @map("evento_destacado")
  situacionResuelta       String?  @map("situacion_resuelta")
  comoResolveria          String?  @map("como_resolveria")
  motivacion              String?
  visionLargoPlazo        String?  @map("vision_largo_plazo")
  disposicionHorario      Boolean? @map("disposicion_horario")
  disposicionFines        Boolean? @map("disposicion_fines")
  salarioEsperado         Float?   @map("salario_esperado")
  habilidades             String?
  experienciaPrevia       String?  @map("experiencia_previa")
  linkedin                String?
  portfolio               String?
  notas                   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  postulaciones Postulacion[]

  @@map("candidatos")
}

model Postulacion {
  id          String  @id @default(cuid())
  candidatoId String  @map("candidato_id")
  candidato   Candidato   @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  puestoId    String? @map("puesto_id")
  puesto      PuestoIdeal? @relation(fields: [puestoId], references: [id])

  // Puesto manual si no hay PuestoIdeal vinculado
  puestoManual String? @map("puesto_manual")
  areaManual   String? @map("area_manual")

  // Pipeline
  etapa String @default("NUEVO") // NUEVO | EVALUACION | PROPUESTA_ENVIADA | APROBADO | CONTRATADO | RECHAZADO

  // Propuesta de trabajo
  salarioPropuesto     Float?    @map("salario_propuesto")
  fechaIngresoEstimada DateTime? @map("fecha_ingreso_estimada")
  beneficios           String?   // JSON array
  observaciones        String?
  propuestaToken       String?   @unique @map("propuesta_token")
  propuestaAceptada    Boolean?  @map("propuesta_aceptada")
  propuestaFechaEnvio  DateTime? @map("propuesta_fecha_envio")

  // Contrato
  contratoGenerado Boolean  @default(false) @map("contrato_generado")
  contratoFecha    DateTime? @map("contrato_fecha")

  // Link al PersonalInterno creado al contratar
  personalInternoId String? @map("personal_interno_id")

  // Evaluación vs perfil
  notasEvaluacion String? @map("notas_evaluacion")
  puntajeTotal    Float?  @map("puntaje_total")

  // Onboarding checklist (JSON: [{id,label,done,fecha}])
  onboardingData  String?

  onboardingPlan  OnboardingPlan?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("postulaciones")
}

// ─── ONBOARDING ───────────────────────────────────────────────────────────────

model OnboardingPlan {
  id             String   @id @default(cuid())
  nombre         String
  puesto         String
  area           String?
  fechaIngreso   DateTime? @map("fecha_ingreso")
  estado         String   @default("EN_CURSO") // EN_CURSO | COMPLETADO | PAUSADO | CANCELADO
  notas          String?
  postulacionId  String?  @unique @map("postulacion_id")
  postulacion    Postulacion? @relation(fields: [postulacionId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")
  modulos        OnboardingModulo[]

  @@map("onboarding_planes")
}

model OnboardingModulo {
  id           String   @id @default(cuid())
  planId       String   @map("plan_id")
  plan         OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  nombre       String
  descripcion  String?
  tipo         String   @default("ALINEACION") // ALINEACION | TECNICO | ADMINISTRATIVO | CULTURAL | PRACTICO
  orden        Int      @default(0)
  duracionDias Int?     @map("duracion_dias")
  completado   Boolean  @default(false)
  tareas       OnboardingTarea[]

  @@map("onboarding_modulos")
}

model OnboardingTarea {
  id           String    @id @default(cuid())
  moduloId     String    @map("modulo_id")
  modulo       OnboardingModulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  titulo       String
  descripcion  String?
  tipo         String    @default("LECTURA") // LECTURA | VIDEO | PRACTICA | EVALUACION | REUNION | SHADOWING
  orden        Int       @default(0)
  completada   Boolean   @default(false)
  completadaEn DateTime? @map("completada_en")
  recurso      String?
  notas        String?

  @@map("onboarding_tareas")
}

// ─── CAMPAÑAS ─────────────────────────────────────────────────────────────────

model TipoCampana {
  id                  String   @id @default(cuid())
  nombre              String
  objetivo            String   @default("INFORMATIVO")  // INFORMATIVO | VENTA | ENTRETENIMIENTO | POSICIONAMIENTO
  objetivoMeta        String   @default("RECONOCIMIENTO") // RECONOCIMIENTO | TRAFICO | INTERACCION | LEADS | VENTAS
  formato             String   @default("VIDEO")         // IMAGEN | VIDEO | CARRUSEL | REEL | HISTORIA | COLECCION
  recurrencia         String   @default("MENSUAL")       // MENSUAL | QUINCENAL | SEMANAL
  canal               String   @default("META")
  duracionDias        Int      @default(14)
  presupuestoEstimado Float?
  publicoEdadMin      Int      @default(25)
  publicoEdadMax      Int      @default(55)
  publicoGenero       String   @default("TODOS")         // TODOS | HOMBRES | MUJERES
  ubicaciones         String   @default("FEED_IG,REELS_IG,STORIES_IG")
  cta                 String   @default("MAS_INFORMACION")
  copyReferencia      String?
  pixelEvento         String?
  descripcion         String?
  grupo               String?  // Sub-sección libre: "Servicios generales", "Tipo de servicio", "Tipo de evento", etc.
  color               String   @default("#B3985B")
  activo              Boolean  @default(true)
  orden               Int      @default(0)
  createdAt           DateTime @default(now())

  ejecuciones         EjecucionCampana[]

  @@map("tipos_campana")
}

model EjecucionCampana {
  id             String       @id @default(cuid())
  tipoId         String?
  tipo           TipoCampana? @relation(fields: [tipoId], references: [id])
  nombre         String
  objetivo       String?
  canal          String?
  color          String?
  fechaInicio    DateTime
  fechaFin       DateTime
  estado         String       @default("PLANIFICADA") // PLANIFICADA | EN_EJECUCION | COMPLETADA | CANCELADA
  presupuesto    Float?
  notas          String?
  mes            String       // YYYY-MM
  idMetaAds      String?
  alcance        Int?
  impresiones    Int?
  clics          Int?
  ctr            Float?
  cantResultados Int?
  costoResultado Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("ejecuciones_campana")
}

// ─── META ADS ─────────────────────────────────────────────────────────────────

model MetaCampana {
  id             String   @id @default(cuid())
  nombre         String
  objetivo       String   @default("LEADS")   // LEADS | AWARENESS | CONVERSIONES | TRAFICO
  estado         String   @default("BORRADOR") // BORRADOR | ACTIVA | PAUSADA | FINALIZADA
  presupuesto    Float    @default(0)
  fechaInicio    DateTime?
  fechaFin       DateTime?
  audiencia      String?  // JSON: segmentación de audiencia
  ubicaciones    String?  // JSON: plataformas (Facebook, Instagram, Audience Network)
  notas          String?
  creadoPorId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  anuncios       MetaAnuncio[]
  resultados     MetaResultado[]

  @@map("meta_campanas")
}

model MetaAnuncio {
  id          String   @id @default(cuid())
  campanaId   String
  campana     MetaCampana @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  nombre      String
  formato     String   @default("IMAGEN") // IMAGEN | VIDEO | CARRUSEL | HISTORIA
  titular     String?
  descripcion String?
  cta         String?  // Texto del call-to-action
  urlDestino  String?
  estado      String   @default("ACTIVO") // ACTIVO | PAUSADO | RECHAZADO
  notas       String?
  createdAt   DateTime @default(now())

  @@map("meta_anuncios")
}

model MetaResultado {
  id             String   @id @default(cuid())
  campanaId      String
  campana        MetaCampana @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha          DateTime
  impresiones    Int      @default(0)
  alcance        Int      @default(0)
  clics          Int      @default(0)
  leads          Int      @default(0)
  gastado        Float    @default(0)
  cpm            Float?   // Costo por mil impresiones
  cpc            Float?   // Costo por clic
  cpl            Float?   // Costo por lead
  frecuencia     Float?
  notas          String?
  createdAt      DateTime @default(now())

  @@map("meta_resultados")
}

// ─── LEVANTAMIENTO DE CONTENIDO ──────────────────────────────────────────────

model LevantamientoContenido {
  id                          String    @id @default(cuid())
  tratoId                     String    @unique
  trato                       Trato     @relation(fields: [tratoId], references: [id], onDelete: Cascade)

  nombreEvento                String?
  tipoEvento                  String?
  fecha                       DateTime?
  horarioEvento               String?
  horarioCobertura            String?
  lugar                       String?
  nombreCliente               String?
  redesSocialesCliente        String?
  tieneProveedoresAdicionales String?   // SI | NO | SIN_INFO
  proveedoresDetalle          String?
  objetivosContenido          String?   // JSON array de strings
  detalleObjetivo             String?
  planCobertura               String?   // BASICO | ESTANDAR | PLUS | INTEGRAL | OTRO
  planCoberturaOtro           String?
  temasSugeridos              String?
  colaboradoresCamara         Boolean?
  colaboradoresNombres        String?
  notasAdicionales            String?
  scoreFotoVideo              Int?
  recomendacionFotoVideo      String?
  estadoLevantamiento         String    @default("PENDIENTE") // PENDIENTE | CONFIRMADO | REALIZADO | CANCELADO

  activos   ActivoEvento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("levantamientos_contenido")
}

// ─── VENUES ──────────────────────────────────────────────────────────────────

model Venue {
  id                  String   @id @default(cuid())
  nombre              String
  direccion           String?
  ciudad              String?
  contacto            String?
  telefonoContacto    String?
  emailContacto       String?
  capacidadPersonas   Int?
  // Dimensiones
  largoM              Float?
  anchoM              Float?
  alturaMaximaM       Float?
  // Acceso
  accesoVehicular     String?
  puntoDescarga       String?
  // Electricidad
  voltajeDisponible   String?
  amperajeTotal       Float?
  fases               String?
  ubicacionTablero    String?
  // Restricciones
  restriccionDecibeles  String?
  restriccionHorario    String?
  restriccionInstalacion String?
  // Información adicional
  tiposEvento         String?  // JSON: ["MUSICAL","SOCIAL","EMPRESARIAL"]
  calificacion        Float?   // 1-5
  notas               String?
  fotoPortada         String?  // base64
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("venues")
}

// ─── PLANTILLAS DE COTIZACIÓN ─────────────────────────────────────────────────

model PlantillaCotizacion {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  tipoEvento    String?
  tipoServicio  String?
  activo        Boolean  @default(true)
  creadaPorId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Campos de cotización que se copian
  horasOperacion   Float?
  tipoJornada      String?
  diasEquipo       Int     @default(1)
  diasOperacion    Int     @default(1)
  diasTransporte   Int     @default(1)
  diasHospedaje    Int     @default(1)
  diasComidas      Int     @default(1)
  observaciones    String?
  terminosComerciales String?
  vigenciaDias     Int     @default(30)
  aplicaIva        Boolean @default(false)

  lineas PlantillaCotizacionLinea[]

  @@map("plantillas_cotizacion")
}

model PlantillaCotizacionLinea {
  id          String               @id @default(cuid())
  plantillaId String
  plantilla   PlantillaCotizacion  @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  tipo         String
  equipoId     String?
  equipo       Equipo?  @relation(fields: [equipoId], references: [id])
  rolTecnicoId String?
  descripcion    String
  marca          String?
  modelo         String?
  nivel          String?
  jornada        String?
  esExterno      Boolean @default(false)
  cantidad       Float   @default(1)
  dias           Int     @default(1)
  precioUnitario Float   @default(0)
  costoUnitario  Float   @default(0)
  subtotal       Float   @default(0)
  esIncluido     Boolean @default(false)
  notas          String?
  orden          Int     @default(0)

  @@map("plantillas_cotizacion_lineas")
}

// ─── CIERRE FINANCIERO DE PROYECTO ───────────────────────────────────────────

model CierreFinanciero {
  id         String   @id @default(cuid())
  proyectoId String   @unique
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  // Estimado (de cotización)
  granTotalEstimado       Float @default(0)
  costoEstimado           Float @default(0)
  utilidadEstimada        Float @default(0)

  // Real (calculado al cierre)
  totalCobrado            Float @default(0)
  totalGastado            Float @default(0)
  utilidadReal            Float @default(0)
  margenReal              Float @default(0)

  // Detalle por categoría (JSON)
  desgloseCostos          String? // JSON: [{categoria, monto}]
  notas                   String?

  cerradoEn               DateTime @default(now())
  cerradoPorId            String?

  @@map("cierres_financieros")
}

// ─── ESTRUCTURA DE CAPITAL (HERVAM) ──────────────────────────────────────────

model HervamActivo {
  id               String   @id @default(cuid())
  nombre           String
  descripcion      String?
  categoria        String   @default("EQUIPO") // EQUIPO | VEHICULO | INMUEBLE | INTANGIBLE | OTRO
  valorAdquisicion Float    @default(0)
  valorActual      Float    @default(0)
  fechaAdquisicion DateTime?
  activo           Boolean  @default(true)
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@map("hervam_activos")
}

model HervamConfig {
  id                   String   @id @default(cuid())
  socioId              String?
  socio                Socio?   @relation(fields: [socioId], references: [id])
  // Valuación
  valorTotalActivos    Float    @default(5000000)
  tasaAnualRendimiento Float    @default(15)
  usarSumaActivos      Boolean  @default(false) // true = calcula desde activos; false = usa valorTotalActivos
  // Modo
  modoActivo           String   @default("HIBRIDO") // FIJO | VARIABLE | HIBRIDO
  porcentajeVariable   Float    @default(25)
  pisoMinimoFijo       Float    @default(50)  // % del monto fijo como garantía mínima
  // Crédito
  creditoSaldoInicial  Float    @default(800000)
  creditoSaldoActual   Float    @default(800000)
  creditoCuotaMensual  Float    @default(0)
  creditoPlazoMeses    Int      @default(48)
  creditoFechaInicio   DateTime?
  // Meta
  notas                String?
  actualizadoEn        DateTime @updatedAt
  @@map("hervam_config")
}

model HervamPago {
  id            String    @id @default(cuid())
  mes           Int
  anio          Int
  montoFijo     Float
  utilidadMes   Float?
  montoVariable Float?
  montoAcordado Float
  montoPagado   Float     @default(0)
  estado        String    @default("PENDIENTE") // PENDIENTE | PARCIAL | PAGADO | DIFERIDO
  modoPago      String?   // FIJO | VARIABLE
  notas         String?
  pagadoEn      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([mes, anio])
  @@map("hervam_pagos")
}

// ─── SOCIOS DE ACTIVOS ────────────────────────────────────────────────────────

model Socio {
  id             String    @id @default(cuid())
  nombre         String
  tipo           String    @default("FISICA") // FISICA | MORAL
  esFundador     Boolean   @default(false)
  rfc            String?
  curp           String?
  telefono       String?
  email          String?
  domicilio      String?
  colonia        String?
  ciudad         String?
  estado         String?
  cp             String?
  status         String    @default("EN_REVISION") // EN_REVISION | ACTIVO | SUSPENDIDO | INACTIVO
  notas          String?
  contratoInicio DateTime?
  contratoFin    DateTime?
  pctSocio       Float     @default(70)
  pctMainstage   Float     @default(30)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activos      SocioActivo[]
  reportes     SocioReporte[]
  checklist    SocioRequisitoItem[]
  cuentasPagar CuentaPagar[]
  hervamConfig HervamConfig[]

  @@map("socios")
}

model SocioRequisitoItem {
  id         String   @id @default(cuid())
  socioId    String
  socio      Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  requisito  String
  completado Boolean  @default(false)
  notas      String?
  orden      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("socios_requisitos")
}

model SocioActivo {
  id                   String    @id @default(cuid())
  socioId              String
  socio                Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  codigoInventario     String    @unique
  nombre               String
  marca                String?
  modelo               String?
  serial               String?
  categoria            String    @default("AUDIO") // AUDIO | ILUMINACION | VIDEO | ESTRUCTURAS | ACCESORIOS | OTRO
  condicion            String    @default("BUENO")  // NUEVO | EXCELENTE | BUENO | REGULAR | REQUIERE_MANTENIMIENTO
  valorDeclarado       Float     @default(0)
  precioDia            Float     @default(0)
  pctSocioOverride     Float?
  pctMainstageOverride Float?
  fotosUrls            String    @default("[]")
  activo               Boolean   @default(true)
  notas                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rentas         SocioRenta[]
  mantenimientos SocioMantenimiento[]

  @@map("socios_activos")
}

model SocioMantenimiento {
  id             String      @id @default(cuid())
  activoId       String
  activo         SocioActivo @relation(fields: [activoId], references: [id], onDelete: Cascade)
  tipo           String      // PREVENTIVO | CORRECTIVO | INSPECCION
  descripcion    String
  fechaEjecucion DateTime?
  costoTotal     Float       @default(0)
  costoSocio     Float       @default(0)
  costoMainstage Float       @default(0)
  realizadoPor   String?
  notas          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("socios_mantenimientos")
}

model SocioRenta {
  id             String      @id @default(cuid())
  activoId       String
  activo         SocioActivo @relation(fields: [activoId], references: [id], onDelete: Cascade)
  descripcion    String
  proyectoId     String?
  mes            Int
  anio           Int
  fechaInicio    DateTime?
  fechaFin       DateTime?
  dias           Int         @default(1)
  precioDia      Float
  subtotal       Float
  pctSocio       Float
  pctMainstage   Float
  montoSocio     Float
  montoMainstage Float
  notas          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("socios_rentas")
}

model SocioReporte {
  id             String    @id @default(cuid())
  socioId        String
  socio          Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  mes            Int
  anio           Int
  totalEventos   Int       @default(0)
  totalDias      Int       @default(0)
  totalFacturado Float     @default(0)
  totalSocio     Float     @default(0)
  totalMainstage Float     @default(0)
  estado         String    @default("BORRADOR") // BORRADOR | ENVIADO | PAGADO
  pagadoEn       DateTime?
  notas          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([socioId, mes, anio])
  @@map("socios_reportes")
}


// ─── MÉTRICAS ORGÁNICAS ───────────────────────────────────────────────────────

model MetricaOrganica {
  id            String   @id @default(cuid())
  mes           String   // YYYY-MM
  plataforma    String   // INSTAGRAM | FACEBOOK | TIKTOK | YOUTUBE
  seguidores    Int?
  alcance       Int?
  impresiones   Int?
  interacciones Int?
  guardados     Int?
  publicaciones Int?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mes, plataforma])
  @@map("metricas_organicas")
}

// ─── ACTIVOS POR EVENTO ───────────────────────────────────────────────────────

model ActivoEvento {
  id               String                 @id @default(cuid())
  levantamientoId  String
  levantamiento    LevantamientoContenido @relation(fields: [levantamientoId], references: [id], onDelete: Cascade)
  tipo             String                 // FOTO | VIDEO | LOGO | COPY | OTRO
  nombre           String
  url              String
  descripcion      String?
  estado           String                 @default("ENTREGADO") // PENDIENTE | EN_EDICION | ENTREGADO | APROBADO
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("activos_evento")
}

// ─── NOTIFICACIONES ───────────────────────────────────────────────────────────

model Notificacion {
  id          String   @id @default(cuid())
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo        String   // LEVANTAMIENTO | PUBLICACION | CAMPANA | SISTEMA
  titulo      String
  mensaje     String
  leida       Boolean  @default(false)
  url         String?
  metadata    String?  // JSON extra data
  createdAt   DateTime @default(now())

  @@index([usuarioId, leida])
  @@map("notificaciones")
}

// ─── JUNTAS ───────────────────────────────────────────────────────────────────

model Junta {
  id            String   @id @default(cuid())
  titulo        String
  area          String   // GLOBAL | DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  tipo          String   // GLOBAL_SEMANAL | AREA_SEMANAL | REVISION_MENSUAL | EXTRAORDINARIA | CAPACITACION
  fecha         DateTime
  duracionMin   Int      @default(45)
  estado        String   @default("PROGRAMADA") // PROGRAMADA | EN_CURSO | COMPLETADA | CANCELADA
  facilitadorId String
  facilitador   User     @relation("JuntaFacilitador", fields: [facilitadorId], references: [id])

  notas         String?  @db.Text
  resumen       String?  @db.Text

  agendaItems      AgendaItem[]
  tareas           Tarea[]            @relation("JuntaOrigen")
  participantes    JuntaParticipante[]
  temasAdicionales TemaAdicional[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fecha])
  @@index([area, fecha])
  @@map("juntas")
}

model AgendaItem {
  id          String   @id @default(cuid())
  juntaId     String
  junta       Junta    @relation(fields: [juntaId], references: [id], onDelete: Cascade)
  orden       Int
  tipo        String   // RESULTADOS | COMPROMISOS | BLOQUEO | DECISION | ACUERDO | AVISO | RECONOCIMIENTO | KPI_REVIEW | CUSTOM
  titulo      String
  descripcion String?
  placeholder String?  @db.Text
  respuesta   String?  @db.Text
  completado  Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@map("agenda_items")
}

model JuntaParticipante {
  id      String  @id @default(cuid())
  juntaId String
  userId  String
  junta   Junta   @relation(fields: [juntaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  asistio Boolean @default(false)

  @@unique([juntaId, userId])
  @@map("junta_participantes")
}

model TemaAdicional {
  id           String  @id @default(cuid())
  juntaId      String
  junta        Junta   @relation(fields: [juntaId], references: [id], onDelete: Cascade)
  titulo       String
  descripcion  String? @db.Text
  propuestoPor String
  autor        User    @relation("TemaAutor", fields: [propuestoPor], references: [id])
  orden        Int     @default(0)

  // Estado durante la junta
  cubierto                Boolean  @default(false)
  notas                   String?  @db.Text
  pasadoSiguienteSemana   Boolean  @default(false)
  agregadoEnJunta         Boolean  @default(false) // true si se agregó durante la junta, no antes

  createdAt DateTime @default(now())

  @@index([juntaId])
  @@map("temas_adicionales")
}

// ─── PLAN DE TRABAJO ─────────────────────────────────────────────────────────

model PlanTrabajoActividad {
  id              String   @id @default(cuid())
  area            String   // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  responsableId   String
  responsable     User     @relation("PlanTrabajoResponsable", fields: [responsableId], references: [id])
  titulo          String
  descripcion     String?  @db.Text
  frecuencia      String   // DIARIO | LUNES_JUEVES | SEMANAL | POR_EVENTO | MENSUAL | TRIMESTRAL | SEMESTRAL | SEGUN_NECESIDAD
  diasSemana      String?  // JSON: ["lunes","jueves"]
  horaEspecifica  String?  // "10:30"
  entregable      String
  kpiVinculado    String?
  origenSO        Boolean  @default(true)
  seccionSO       String?
  activa          Boolean  @default(true)
  generarTareas   Boolean  @default(true)
  ultimaTareaGeneradaAt DateTime?
  orden           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tareas          Tarea[]  @relation("TareasDePlan")

  @@index([area, responsableId])
  @@map("plan_trabajo_actividades")
}

// ─── PROYECTOS INTERNOS ───────────────────────────────────────────────────────

model ProyectoInterno {
  id              String   @id @default(cuid())
  nombre          String
  descripcion     String?  @db.Text
  area            String   // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  liderId         String
  lider           User     @relation("ProyectoInternoLider", fields: [liderId], references: [id])
  estado          String   @default("PLANIFICACION") // PLANIFICACION | ACTIVO | EN_PAUSA | COMPLETADO | CANCELADO
  prioridad       String   @default("MEDIA")         // URGENTE | ALTA | MEDIA | BAJA
  fechaInicio     DateTime?
  fechaFin        DateTime?
  porcentajeAvance Int     @default(0)
  backlogItemId   String?
  backlogItem     BacklogItem? @relation(fields: [backlogItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fases           FaseProyectoInterno[]
  tareas          Tarea[]  @relation("TareasDeProyectoInterno")

  @@index([area, estado])
  @@map("proyectos_internos")
}

model FaseProyectoInterno {
  id          String          @id @default(cuid())
  proyectoId  String
  proyecto    ProyectoInterno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  orden       Int             @default(0)
  completada  Boolean         @default(false)
  createdAt   DateTime        @default(now())

  tareas      Tarea[]         @relation("TareasDeFase")

  @@index([proyectoId])
  @@map("fases_proyecto_interno")
}

// ─── BACKLOG ──────────────────────────────────────────────────────────────────

model BacklogItem {
  id          String    @id @default(cuid())
  titulo      String
  descripcion String?   @db.Text
  area        String?   // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  tipo        String    @default("IDEA") // IDEA | TAREA | PROYECTO
  estado      String    @default("PENDIENTE") // PENDIENTE | EN_JUNTA | CONVERTIDO | DESCARTADO
  creadoPorId String
  creadoPor   User      @relation("BacklogCreadoPor", fields: [creadoPorId], references: [id])
  procesadoEn String?   // "tarea" | "proyecto" | "junta" | "descartado"
  procesadoAt DateTime?
  tareaGeneradaId String?
  juntaId     String?
  createdAt   DateTime  @default(now())

  proyectosGenerados ProyectoInterno[]

  @@index([estado])
  @@index([area, estado])
  @@map("backlog_items")
}

model ProyectoAcceso {
  id          String        @id @default(cuid())
  proyecto    TareaProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId  String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  creadoEn    DateTime      @default(now())

  @@unique([proyectoId, userId])
  @@map("proyecto_acceso")
}

// ── Módulo Formularios ────────────────────────────────────────────────────────

model ReporteFormulario {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation("ReportesFormularioUser", fields: [userId], references: [id])
  semana      Int      // Número de semana ISO (1–53)
  anio        Int
  logros      String   @db.Text
  pendientes  String   @db.Text
  tareas      Json     // { titulo: string; fechaVencimiento: string | null }[]
  incidencias Json     // { que: string; causa: string; propuesta: string }[]
  mejoras     String   @db.Text
  compromisos String   @db.Text
  sugerencias String   @db.Text
  bienestar   Int      // 1–10
  estado      String   @default("enviado")
  tareasOperaciones  Json?  // [{tareaId, titulo, prioridad, accion: 'completada'|'reagendada'|'pendiente', fechaComprometida?, nota?}]
  compromisosPlan    Json?  // [{instanciaId, templateNombre, areaNombre, accion, fechaComprometida?, nota?}]

  @@map("reportes_formulario")
}


// ── Módulo Reporte Post-Evento ───────────────────────────────────────────────────

model ReportePostEvento {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  proyectoId            String    @unique
  proyecto              Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  token                 String    @unique @default(cuid())
  estado                String    @default("pendiente") // "pendiente" | "completado"
  coordinadorNombre     String?
  // Bloque ejecución
  llegadaPlaneada       String?
  llegadaReal           String?
  montajePlaneado       String?
  montajeReal           String?
  inicioProgramado      String?
  inicioReal            String?
  salidaPlaneada        String?
  salidaReal            String?
  seEjecutoSegunPlan    String?   // "si" | "ajustes" | "no"
  // Bloque equipos
  fallasEquipo          Json?     // string[]
  equipoMantenimiento   Json?     // string[]
  herramientasFaltantes Json?     // string[]
  // Bloque información
  briefCompleto         String?   // "si" | "incompleto" | "no"
  cambiosUltimoMomento  Boolean?
  descripcionCambios    String?   @db.Text
  // Bloque equipo técnico
  calificacionEquipo    Int?
  puntosPositivos       String?   @db.Text
  areasMejora           String?   @db.Text
  // Bloque incidencias
  incidencias           Json?     // { descripcion, impacto, resolucion }[]
  // Bloque cierre
  equipoRegreso         String?   // "completo" | "faltantes"
  faltantesDescripcion  String?   @db.Text
  aprendizajeClave      String?   @db.Text
  loRepetiriamos        String?   // "si" | "ajustes" | "no"
  respondidoEn          DateTime?

  @@map("reporte_post_evento")
}

// ── Módulo Proveedores / Subrentas por evento ─────────────────────────────────

model ProveedorEvento {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  proyectoId        String
  proyecto          Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombreProveedor   String
  servicioEquipo    String?
  telefonoProveedor String?

  @@map("proveedores_evento")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MÓDULO PLAN DE TRABAJO — Sistema Operativo Vivo
// ═══════════════════════════════════════════════════════════════════════════════

model PTArea {
  id        String   @id @default(cuid())
  nombre    String   @unique
  color     String
  icono     String?
  objetivo  String?  @db.Text
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  subareas  PTSubArea[]
  templates PTTareaTemplate[]
  kpis      PTKPI[]     @relation("PTKPIArea")

  @@map("pt_areas")
}

model PTSubArea {
  id          String   @id @default(cuid())
  areaId      String
  area        PTArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  nombre      String
  orden       Int      @default(0)
  descripcion String?  @db.Text
  entregables String[] // Lista de nombres de entregables

  templates   PTTareaTemplate[]

  @@index([areaId])
  @@map("pt_subareas")
}

model PTTareaTemplate {
  id             String   @id @default(cuid())
  areaId         String
  area           PTArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  subAreaId      String
  subArea        PTSubArea @relation(fields: [subAreaId], references: [id], onDelete: Cascade)
  responsableId  String?
  responsable    User?    @relation("PTTemplateResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  nombre         String
  descripcion    String?  @db.Text
  tipo           String   // CHECK | ENTREGABLE
  frecuencia     String   // DIARIO | SEMANAL | QUINCENAL | MENSUAL | TRIMESTRAL | POR_EVENTO
  diasSemana     Int[]    // [1,2,3,4,5] — 0=dom,1=lun,...6=sab
  diaDelMes      Int?     // Para MENSUAL: día fijo (1-31)
  semanaDeMes    Int[]    @default([])  // Para MENSUAL/QUINCENAL: 1=1a, 2=2a, 3=3a, 4=4a, 5=última (array, multi-select)
  horaLimite     String?  // "10:30" — hora límite de entrega
  moduloDestino    String?  // URL del módulo: "/ventas/pipeline"
  moduloTexto      String?  // "Ir al Pipeline"
  moduloDisponible Boolean  @default(true)
  esAccionCampo    Boolean  @default(false)
  activa           Boolean  @default(true)
  orden          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Campos SO v2.0
  impacto        String   @default("estandar")        // critico | alto | estandar
  contexto       String   @default("independiente")   // evento | hibrida | independiente
  cuando         String?                              // texto: "Cada lunes antes de las 10:30 am"
  puestoDefault  String?                              // puesto responsable por defecto
  kpiNombre      String?                              // KPI asociado en texto
  estandarMinimo String?  @db.Text
  porqueSeHace   String?  @db.Text
  relacionCon    String?  @db.Text
  siNoSeHace     String?  @db.Text
  afectaA        String[]
  dependeDe      Json?                                // { tarea: string, puesto: string } | null
  bloqueaA       Json?                                // { tarea: string, puesto: string } | null
  tipoAsignacion String   @default("individual")      // individual | area | todos
  areaAsignada   String?                              // nombre del área si tipoAsignacion = "area"


  instancias  PTTareaInstancia[]
  subtareas   PTSubTarea[]

  @@index([areaId, activa])
  @@index([responsableId])
  @@map("pt_tarea_templates")
}

model PTTareaInstancia {
  id             String   @id @default(cuid())
  templateId     String
  template       PTTareaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responsableId  String?
  responsable    User?    @relation("PTInstanciaResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  fechaVencimiento DateTime
  estado         String   @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | VENCIDA | OMITIDA
  esEntregable   Boolean  @default(false)
  periodoLabel   String?  // "Semana 22", "Mayo 2026", "Lunes 26 mayo"
  notas          String?  @db.Text
  completadaAt   DateTime?
  completadaPorId String?
  completadaPor  User?    @relation("PTInstanciaCompletadaPor", fields: [completadaPorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subtareasInstancia PTSubTareaInstancia[]
  comentarios        PTComentario[]
  historial          PTHistorialEjecucion[]

  @@index([responsableId, fechaVencimiento])
  @@index([templateId, fechaVencimiento])
  @@index([estado])
  @@map("pt_tarea_instancias")
}

model PTSubTarea {
  id         String   @id @default(cuid())
  templateId String
  template   PTTareaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  nombre     String
  orden      Int      @default(0)
  activa     Boolean  @default(true)

  instancias PTSubTareaInstancia[]

  @@index([templateId])
  @@map("pt_subtareas")
}

model PTSubTareaInstancia {
  id          String   @id @default(cuid())
  subtareaId  String
  subtarea    PTSubTarea @relation(fields: [subtareaId], references: [id], onDelete: Cascade)
  instanciaId String
  instancia   PTTareaInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  completada  Boolean  @default(false)
  completadaAt DateTime?

  @@unique([subtareaId, instanciaId])
  @@index([instanciaId])
  @@map("pt_subtarea_instancias")
}

model PTComentario {
  id          String   @id @default(cuid())
  instanciaId String
  instancia   PTTareaInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User     @relation("PTComentarioAutor", fields: [autorId], references: [id], onDelete: Cascade)
  contenido   String   @db.Text
  editadoAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([instanciaId])
  @@map("pt_comentarios")
}

model PTHistorialEjecucion {
  id          String   @id @default(cuid())
  instanciaId String
  instancia   PTTareaInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     User     @relation("PTHistorialUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  accion      String   // COMPLETADA | REABIERTA | REASIGNADA | COMENTADA | OMITIDA | CREADA
  detalles    String?
  createdAt   DateTime @default(now())

  @@index([instanciaId])
  @@index([usuarioId, createdAt])
  @@map("pt_historial_ejecucion")
}

// ── KPIs del Sistema Operativo ────────────────────────────────────────────────
model PTKPI {
  id            String   @id @default(cuid())
  slug          String?  @unique
  areaId        String?
  area          PTArea?  @relation("PTKPIArea", fields: [areaId], references: [id], onDelete: SetNull)
  nombre        String
  meta          String
  formula       String   @db.Text
  fuente        String
  orden         Int      @default(0)
  esTransversal    Boolean   @default(false)
  activo           Boolean   @default(true)
  descripcion      String?
  proposito        String?   @db.Text
  tipoCalculo      String    @default("manual")   // "automatico" | "manual" | "mixto"
  notaCalculo      String?   @db.Text
  valorManual      Float?
  fechaValorManual DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  registros     PTRegistroKPI[]

  @@index([areaId])
  @@index([esTransversal])
  @@map("pt_kpis")
}

model PTRegistroKPI {
  id            String   @id @default(cuid())
  kpiId         String?
  kpi           PTKPI?   @relation(fields: [kpiId], references: [id])
  kpiSlug       String
  kpiNombre     String
  kpiArea       String
  valor         Float?
  valorTexto    String?
  meta          String
  cumplida      Boolean  @default(false)
  calculo       String   @default("manual")   // manual | automatico
  fuente        String?
  periodo       String                         // semanal|quincenal|mensual|trimestral|semestral|anual
  fechaInicio   DateTime
  fechaFin      DateTime
  semana        Int?
  quincena      Int?
  mes           Int?
  trimestre     Int?
  semestre      Int?
  anio          Int
  nota          String?  @db.Text
  registradoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([kpiSlug, periodo, fechaInicio])
  @@index([kpiSlug, periodo, anio])
  @@index([kpiArea, periodo, anio])
  @@map("pt_registro_kpis")
}

// ─── CAPTURA RÁPIDA / IDEAS / INICIATIVAS ────────────────────────────────────

model CapturaRapida {
  id          String   @id @default(cuid())
  contenido   String
  area        String?  // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  tipo        String?  // idea | iniciativa | tarea | backlog
  clasificado Boolean  @default(false)
  creadoEn    DateTime @default(now())
  creadoPor   String?
  usuario     User?    @relation("CapturaRapidaUsuario", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@index([clasificado, creadoEn])
  @@map("captura_rapida")
}

model Idea {
  id          String   @id @default(cuid())
  titulo      String
  nota        String?  @db.Text
  area        String?
  tipo        String?  // negocio | operacion | plataforma | estrategia
  estado      String   @default("activa")   // activa | convertida | descartada
  convertidaA String?
  creadoEn    DateTime @default(now())
  creadoPor   String?
  usuario     User?    @relation("IdeaUsuario", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@index([estado, creadoEn])
  @@map("ideas")
}

model Iniciativa {
  id          String               @id @default(cuid())
  titulo      String
  descripcion String?              @db.Text
  area        String?
  responsable String?
  estado      String   @default("planeando") // planeando | en_ejecucion | pausada | completada
  fechaLimite DateTime?
  notas       String?              @db.Text
  subtareas   SubtareaIniciativa[]
  creadoEn    DateTime @default(now())
  creadoPor   String?
  usuario     User?    @relation("IniciativaUsuario", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@index([estado, creadoEn])
  @@map("iniciativas")
}

model SubtareaIniciativa {
  id           String     @id @default(cuid())
  iniciativaId String
  iniciativa   Iniciativa @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  titulo       String
  completada   Boolean    @default(false)
  orden        Int        @default(0)

  @@index([iniciativaId, orden])
  @@map("subtareas_iniciativa")
}

// ─── REPORTE SEMANAL POR ÁREA ────────────────────────────────────────────────

// Reporte semanal por área (lo llena cada responsable de área cada lunes)
model ReporteAreaSemanal {
  id          String   @id @default(cuid())
  area        String   // VENTAS | PRODUCCION | MARKETING | ADMINISTRACION | RRHH | DIRECCION
  semana      String   // Lunes de la semana: "2026-05-04"
  autorId     String
  autor       User     @relation("ReportesAreaAutor", fields: [autorId], references: [id])
  resultados  String   @default("") // Texto libre: logros de la semana
  kpis        String   @default("[]") // JSON: [{ nombre, valor, meta?, unidad? }]
  compromisos String   @default("") // Texto libre: qué se compromete para la siguiente semana
  bloqueo     String?  // Texto libre: qué está bloqueando (opcional)
  revisado    Boolean  @default(false) // Dirección revisó el reporte
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([area, semana])
  @@map("reportes_area_semanal")
}

// ─── INCIDENCIAS SEMANALES ───────────────────────────────────────────────────

model IncidenciaSemanal {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation("IncidenciasSemanalesUser", fields: [userId], references: [id])
  semana      Int      // Número de semana ISO (1–53)
  anio        Int
  incidencias Json     // { area, texto, urgencia, orden }[]
  estado      String   @default("guardado")

  @@map("incidencias_semanales")
}

// ─── REPORTE SEMANAL CONSOLIDADO (generado por cron) ─────────────────────────

model ReporteSemanal {
  id          String   @id @default(cuid())
  semana      DateTime // Lunes de la semana (date only, UTC midnight)
  fechaInicio DateTime
  fechaFin    DateTime
  datos       String   // JSON con todas las métricas
  score       Int      @default(0) // 0-100
  notas       String?  // Anotaciones del CEO
  generadoEn  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([semana])
  @@map("reportes_semanales")
}

// ─── OBJETIVOS / OKRs ────────────────────────────────────────────────────────

model ObjetivoTrimestral {
  id          String      @id @default(cuid())
  area        String      // DIRECCION | ADMINISTRACION | MARKETING | VENTAS | PRODUCCION
  trimestre   String      // Q1 | Q2 | Q3 | Q4
  anio        Int
  objetivo    String
  keyResults  KeyResult[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("objetivos_trimestrales")
}

model KeyResult {
  id           String             @id @default(cuid())
  descripcion  String
  tipo         String             // porcentaje | numero | booleano
  meta         Float?
  metaTexto    String?
  progreso     Float              @default(0)
  completado   Boolean            @default(false)
  conexionAuto String?            // leads_q3 | outbound_q3
  objetivoId   String
  objetivo     ObjetivoTrimestral @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("key_results")
}
