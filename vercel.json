{
  "buildCommand": "npx prisma generate && next build",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/clear.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup-datos",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/hervam-mensual",
      "schedule": "0 14 1 * *"
    },
    {
      "path": "/api/cron/renta-mensual-activos",
      "schedule": "0 15 1 * *"
    },
    {
      "path": "/api/cron/notificaciones-diarias",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/cron/sincronizar-estados-proyectos",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/repartos-semanales",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/nomina-semanal",
      "schedule": "30 10 * * 1"
    },
    {
      "path": "/api/cron/evaluaciones-mensual",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/evaluaciones-recordatorio",
      "schedule": "0 9 5 * *"
    }
  ]
}